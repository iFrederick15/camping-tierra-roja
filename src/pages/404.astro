---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const enlaces = [
  { label: 'Inicio', href: '/' },
  { label: 'Galería', href: '/galeria' },
  { label: 'Reservar', href: '/reservar' },
  { label: 'Contacto', href: '/contacto' },
];
---

<Layout
  title="Página no encontrada — Tierra Roja"
  description="La página que buscas no existe. Vuelve al inicio del sitio de Camping Tierra Roja, Puerto Iguazú."
>
  <section
    class="max-w-3xl mx-auto px-6 py-24 md:py-32 text-center flex flex-col items-center"
  >
    <p class="font-titulo font-bold text-sm tracking-widest uppercase text-primario mb-4">
      Error 404
    </p>
    <h1
      class="font-titulo font-extrabold text-4xl md:text-6xl text-texto mb-5 tracking-tight leading-tight"
    >
      Esta página <span class="text-primario italic">no existe</span>
    </h1>
    <p class="text-texto-suave text-lg max-w-xl leading-relaxed mb-10">
      Puede que el enlace esté roto o que la página se haya movido. Prueba con alguna de estas
      secciones:
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      {
        enlaces.map((enlace) => (
          <a
            href={enlace.href}
            class="bg-fondo-alt text-texto-suave hover:bg-primario/10 hover:text-primario font-titulo font-bold text-sm px-6 py-3 rounded-pill transition-all duration-200"
          >
            {enlace.label}
          </a>
        ))
      }
    </div>
  </section>
</Layout>
