---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import PaginaInicio from '../components/PaginaInicio.astro';
import { schemaFaq } from '../lib/faq';
import { idiomaActual, traducciones } from '../i18n';

const idioma = idiomaActual(Astro);
const t = traducciones(idioma);
---

<Layout
  preloadImagen="/images/general/tierra-roja-drone.webp"
  schemaExtra={schemaFaq(t.faq.items, 'es-AR')}
>
  <PaginaInicio idioma={idioma} t={t} />
</Layout>
