---
import PanelLayout from '../../layouts/PanelLayout.astro';
import {
  calcularEstadoPago,
  codigoReserva,
  ESTILO_ESTADO_PAGO,
  listarReservas,
  type ReservaResumen,
} from '../../lib/reservas';

const pendientes = await listarReservas({ modo: 'pendientes-pago' });

// Vercel corre en UTC: se fija el huso de Puerto Iguazú para no mostrar horas
// corridas (igual que en el detalle de la reserva).
const ZONA = 'America/Argentina/Buenos_Aires';
const HORA = 60 * 60 * 1000;
const ahora = Date.now();

const fmtHora = (ts: string) =>
  new Date(ts).toLocaleString('es-AR', {
    day: 'numeric',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: ZONA,
  });
const fmtDia = (f: string) =>
  new Date(f + 'T00:00:00').toLocaleDateString('es-AR', { day: 'numeric', month: 'short' });
const fmtMoneda = (n: number) => `$${n.toLocaleString('es-AR')}`;

// "vence en 5 h" / "venció hace 2 días": lo que importa al elegir a quién
// escribir primero es cuánto falta, no la fecha exacta.
function relativo(limite: number): string {
  const diff = limite - ahora;
  const abs = Math.abs(diff);
  const cantidad =
    abs < HORA
      ? `${Math.max(1, Math.round(abs / 60000))} min`
      : abs < 48 * HORA
        ? `${Math.round(abs / HORA)} h`
        : `${Math.round(abs / (24 * HORA))} días`;
  return diff < 0 ? `venció hace ${cantidad}` : `vence en ${cantidad}`;
}

// Los formularios piden el teléfono con código de país y solo dígitos, que es
// justo lo que espera wa.me: se usa tal cual, sin adivinar el país.
function numeroWhatsApp(telefono: string): string | null {
  const digitos = telefono.replace(/\D/g, '');
  return digitos.length >= 8 ? digitos : null;
}

interface Fila {
  r: ReservaResumen;
  saldo: number;
  limite: number;
  vencida: boolean;
  wa: string | null;
}

const filas: Fila[] = pendientes.map((r) => {
  const saldo = Math.max(0, r.montoTotal - r.montoPagado);
  const limite = new Date(r.fechaLimitePago!).getTime();
  const vencida = limite < ahora;
  const numero = r.telefono ? numeroWhatsApp(r.telefono) : null;
  const mensaje = [
    `Hola ${r.nombreCliente.split(' ')[0]}, te escribimos de Camping Tierra Roja por tu reserva ${codigoReserva(r.id)}`,
    `(${fmtDia(r.fechaIngreso)} al ${fmtDia(r.fechaSalida)}).`,
    `${vencida ? 'El plazo para transferir venció el' : 'El plazo para transferir vence el'} ${fmtHora(r.fechaLimitePago!)} hs`,
    `y todavía nos figura un saldo de ${fmtMoneda(saldo)}.`,
    '¿Nos envías el comprobante por acá?',
  ].join(' ');
  return {
    r,
    saldo,
    limite,
    vencida,
    wa: numero ? `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}` : null,
  };
});

const grupos = [
  {
    titulo: 'Plazo vencido',
    detalle: 'Confirma si pagaron antes de liberar el lugar.',
    filas: filas.filter((f) => f.vencida),
  },
  {
    titulo: 'Vencen en las próximas 24 h',
    detalle: 'Conviene avisar hoy.',
    filas: filas.filter((f) => !f.vencida && f.limite - ahora <= 24 * HORA),
  },
  {
    titulo: 'Más adelante',
    detalle: null,
    filas: filas.filter((f) => f.limite - ahora > 24 * HORA),
  },
].filter((g) => g.filas.length > 0);

const saldoTotal = filas.reduce((s, f) => s + f.saldo, 0);
const cantidadVencidas = filas.filter((f) => f.vencida).length;
---

<PanelLayout title="Pendientes de pago" activo="pendientes">
  <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="font-titulo font-bold text-3xl text-negro mb-2">Pendientes de pago</h1>
      <p class="text-texto-suave max-w-prose">
        Reservas con plazo de pago abierto, ordenadas por vencimiento. El botón de WhatsApp abre el
        chat con el cliente y un mensaje listo para revisar antes de enviar.
      </p>
    </div>
    {
      filas.length > 0 && (
        <dl class="flex gap-6 shrink-0">
          <div>
            <dt class="text-xs font-titulo font-medium uppercase tracking-wider text-texto-suave">
              Reservas
            </dt>
            <dd class="font-titulo font-bold text-2xl text-negro tabular-nums">{filas.length}</dd>
          </div>
          {cantidadVencidas > 0 && (
            <div>
              <dt class="text-xs font-titulo font-medium uppercase tracking-wider text-texto-suave">
                Vencidas
              </dt>
              <dd class="font-titulo font-bold text-2xl text-advertencia tabular-nums">
                {cantidadVencidas}
              </dd>
            </div>
          )}
          <div>
            <dt class="text-xs font-titulo font-medium uppercase tracking-wider text-texto-suave">
              Por cobrar
            </dt>
            <dd class="font-titulo font-bold text-2xl text-negro tabular-nums">
              {fmtMoneda(saldoTotal)}
            </dd>
          </div>
        </dl>
      )
    }
  </header>

  {
    filas.length === 0 ? (
      <p class="text-texto-suave text-sm bg-superficie border-2 border-borde rounded-card px-5 py-4">
        No hay reservas pendientes de pago.
      </p>
    ) : (
      <div class="flex flex-col gap-10">
        {grupos.map((g) => (
          <section>
            <div class="mb-3 flex items-baseline gap-3 flex-wrap">
              <h2 class="font-titulo font-bold text-xl text-negro">
                {g.titulo}
                <span class="text-texto-suave font-medium tabular-nums"> · {g.filas.length}</span>
              </h2>
              {g.detalle && <p class="text-sm text-texto-suave">{g.detalle}</p>}
            </div>
            <ul class="flex flex-col gap-2">
              {g.filas.map(({ r, saldo, vencida, wa }) => {
                const estilo = ESTILO_ESTADO_PAGO[calcularEstadoPago(r.montoTotal, r.montoPagado)];
                return (
                  <li class="grid gap-4 rounded-card border-2 border-borde bg-superficie px-5 py-4 md:grid-cols-[minmax(0,1fr)_auto_auto] md:items-center md:gap-8">
                    <div class="flex flex-col gap-0.5 min-w-0">
                      <a
                        href={`/panel/reservas/${r.id}`}
                        class="font-titulo font-bold text-negro truncate hover:text-primario transition-colors"
                      >
                        {r.nombreCliente}
                      </a>
                      <span class="text-texto-suave text-sm truncate">
                        {r.unidadNombre}
                        {r.parcelaNombre ? ` · ${r.parcelaNombre}` : ''} · {fmtDia(r.fechaIngreso)}{' '}
                        – {fmtDia(r.fechaSalida)}
                      </span>
                      <span class="text-texto-suave/80 text-xs font-titulo tracking-wider">
                        {codigoReserva(r.id)}
                        {r.telefono && (
                          <span class="font-sans tracking-normal"> · {r.telefono}</span>
                        )}
                        {!r.telefono && r.email && (
                          <span class="font-sans tracking-normal"> · {r.email}</span>
                        )}
                      </span>
                    </div>

                    <div class="flex items-center justify-between gap-6 md:justify-end">
                      <div class="md:text-right">
                        <p
                          class={`text-sm font-medium ${vencida ? 'text-advertencia' : 'text-negro'}`}
                        >
                          {relativo(new Date(r.fechaLimitePago!).getTime())}
                        </p>
                        <p class="text-xs text-texto-suave tabular-nums">
                          {fmtHora(r.fechaLimitePago!)} hs
                        </p>
                      </div>
                      <div class="text-right">
                        <p class="font-titulo font-bold text-negro tabular-nums">
                          {fmtMoneda(saldo)}
                        </p>
                        <span
                          class={`inline-block whitespace-nowrap border rounded-pill px-2.5 py-0.5 text-xs font-titulo font-bold ${estilo.className}`}
                        >
                          {estilo.label}
                        </span>
                      </div>
                    </div>

                    <div class="flex gap-2 md:justify-end">
                      {wa ? (
                        <a
                          href={wa}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center justify-center gap-2 flex-1 md:flex-none border-2 border-whatsapp text-whatsapp rounded-pill px-4 py-2 text-sm font-titulo font-bold hover:bg-whatsapp hover:text-white transition-colors"
                        >
                          <svg
                            class="w-4 h-4"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                          >
                            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.95 1.17-.18.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.63-.93-2.23-.24-.58-.49-.5-.68-.51h-.58c-.2 0-.52.08-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.28-.2-.58-.34zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.93.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.23-9.43 9.44-9.43 2.52 0 4.89.98 6.67 2.77a9.37 9.37 0 0 1 2.76 6.67c0 5.2-4.24 9.43-9.44 9.43zm8.03-17.46A11.3 11.3 0 0 0 12.05.7C5.8.7.7 5.8.7 12.05c0 2 .52 3.95 1.52 5.67L.6 23.3l5.7-1.5a11.33 11.33 0 0 0 5.74 1.47h.01c6.26 0 11.35-5.1 11.35-11.35 0-3.03-1.18-5.88-3.32-8.02z" />
                          </svg>
                          Avisar
                        </a>
                      ) : r.email ? (
                        <a
                          href={`mailto:${r.email}`}
                          class="inline-flex items-center justify-center flex-1 md:flex-none border-2 border-borde text-texto-suave rounded-pill px-4 py-2 text-sm font-titulo font-bold hover:border-primario-claro transition-colors"
                        >
                          Email
                        </a>
                      ) : null}
                      <a
                        href={`/panel/reservas/${r.id}`}
                        class="inline-flex items-center justify-center flex-1 md:flex-none border-2 border-borde text-negro rounded-pill px-4 py-2 text-sm font-titulo font-bold hover:border-primario-claro transition-colors"
                      >
                        Ver reserva
                      </a>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    )
  }
</PanelLayout>
