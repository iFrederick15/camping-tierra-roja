---
import PanelLayout from '../../../layouts/PanelLayout.astro';
import { supabaseAdmin } from '../../../lib/supabase';
import { obtenerConfiguracionPagos } from '../../../lib/reservas';
import { normalizarImagenes, urlPublicaImagen } from '../../../lib/imagenes-unidad';

const { data: unidades } = await supabaseAdmin
  .from('unidades')
  .select('id, tipo, nombre, cupo_total, imagenes')
  .order('tipo');

// { unidadId: [{ raw, url }] } — `raw` es lo que se guarda en la fila,
// `url` la versión mostrable. El script del cliente re-renderiza desde acá.
const imagenesPorUnidad: Record<string, { raw: string; url: string }[]> = {};
for (const u of unidades ?? []) {
  imagenesPorUnidad[u.id] = normalizarImagenes((u as any).imagenes).map((raw) => ({
    raw,
    url: urlPublicaImagen(raw),
  }));
}

const { data: opcionesPrecio } = await supabaseAdmin
  .from('opciones_precio')
  .select('id, clave, etiqueta, tipo_cargo, precio_por_noche, unidad_id')
  .eq('activo', true)
  .order('orden');

const { data: parcelas } = await supabaseAdmin
  .from('parcelas')
  .select('id, numero, nombre, activa, unidades(tipo, nombre)')
  .order('numero');

const opcionesPorUnidad = new Map<string, any[]>();
for (const op of opcionesPrecio ?? []) {
  if (!opcionesPorUnidad.has(op.unidad_id)) opcionesPorUnidad.set(op.unidad_id, []);
  opcionesPorUnidad.get(op.unidad_id)!.push(op);
}

const configPagos = await obtenerConfiguracionPagos();

const parcelasPorUnidad = new Map<string, any[]>();
for (const p of parcelas ?? []) {
  const clave = (p as any).unidades?.nombre ?? '—';
  if (!parcelasPorUnidad.has(clave)) parcelasPorUnidad.set(clave, []);
  parcelasPorUnidad.get(clave)!.push(p);
}
---

<PanelLayout title="Configuración" activo="configuracion">
  <h1 class="font-titulo font-bold text-3xl text-negro mb-8">Configuración</h1>

  <section class="mb-10">
    <h2 class="font-titulo font-bold text-xl text-negro mb-3">Precios y cupos</h2>
    <div class="flex flex-col gap-6">
      {
        (unidades ?? []).map((u) => (
          <div class="rounded-card border-2 border-borde px-5 py-4 bg-superficie flex flex-col gap-3">
            <div class="flex items-center justify-between flex-wrap gap-3">
              <span class="font-titulo font-bold text-negro text-lg">{u.nombre}</span>
              {u.tipo === 'CAMPING' && (
                <form class="form-unidad flex items-end gap-3" data-id={u.id}>
                  <label class="flex flex-col gap-1 text-sm text-texto-suave">
                    Cupo total
                    <input
                      type="number"
                      name="cupoTotal"
                      value={u.cupo_total}
                      class="border-2 border-borde rounded-card px-3 py-2 w-28 focus:border-primario focus:outline-none"
                    />
                  </label>
                  <button
                    type="submit"
                    class="border-2 border-borde rounded-pill px-4 py-2 font-titulo font-medium text-texto-suave hover:border-primario-claro transition-colors"
                  >
                    Guardar
                  </button>
                  <span class="msg text-sm" />
                </form>
              )}
            </div>
            <div class="flex flex-col gap-2">
              {(opcionesPorUnidad.get(u.id) ?? []).map((op: any) => (
                <form
                  class="form-opcion-precio flex flex-wrap items-end gap-3 bg-fondo-alt rounded-card px-4 py-3"
                  data-id={op.id}
                >
                  <span class="text-sm text-texto flex-1 min-w-48">{op.etiqueta}</span>
                  <label class="flex flex-col gap-1 text-sm text-texto-suave">
                    {u.tipo === 'QUINCHOS' ? '$ por día' : '$ por noche'}
                    <input
                      type="number"
                      name="precioPorNoche"
                      value={op.precio_por_noche}
                      class="border-2 border-borde rounded-card px-3 py-2 w-32 focus:border-primario focus:outline-none"
                    />
                  </label>
                  <button
                    type="submit"
                    class="border-2 border-borde rounded-pill px-4 py-2 font-titulo font-medium text-texto-suave hover:border-primario-claro transition-colors"
                  >
                    Guardar
                  </button>
                  <span class="msg text-sm" />
                </form>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-10">
    <h2 class="font-titulo font-bold text-xl text-negro mb-3">Imágenes del reservador</h2>
    <p class="text-sm text-texto-suave mb-4 max-w-2xl">
      Son las fotos del carrusel que ve el cliente al elegir cada alojamiento en la página de
      reservas. Subí archivos WebP o JPG de menos de 3&nbsp;MB; la primera de la lista es la que se
      muestra al abrir. El cambio se ve en el sitio al instante.
    </p>
    <div class="flex flex-col gap-6">
      {
        (unidades ?? []).map((u) => (
          <div
            class="galeria-unidad rounded-card border-2 border-borde px-5 py-4 bg-superficie flex flex-col gap-3"
            data-id={u.id}
            data-nombre={u.nombre}
          >
            <span class="font-titulo font-bold text-negro text-lg">{u.nombre}</span>
            <div class="lista-imagenes grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" />
            <div class="flex items-center gap-3 flex-wrap">
              <label class="cursor-pointer border-2 border-borde rounded-pill px-4 py-2 font-titulo font-medium text-texto-suave hover:border-primario-claro transition-colors">
                <input
                  type="file"
                  accept="image/webp,image/jpeg,image/png"
                  class="input-foto sr-only"
                />
                Agregar foto
              </label>
              <span class="msg text-sm" />
            </div>
          </div>
        ))
      }
    </div>
    <script
      is:inline
      id="datos-imagenes-unidad"
      type="application/json"
      set:html={JSON.stringify(imagenesPorUnidad)}
    />
  </section>

  <section class="mb-10">
    <h2 class="font-titulo font-bold text-xl text-negro mb-3">Parcelas</h2>
    <div class="flex flex-col gap-6">
      {
        Array.from(parcelasPorUnidad.entries()).map(([nombreUnidad, lista]) => (
          <div>
            <h3 class="font-titulo font-medium text-texto-suave mb-2">{nombreUnidad}</h3>
            <div class="flex flex-col gap-2">
              {lista.map((p: any) => (
                <form
                  class="form-parcela flex flex-wrap items-end gap-3 rounded-card border-2 border-borde px-5 py-3 bg-superficie"
                  data-id={p.id}
                >
                  <span class="font-titulo font-medium text-negro flex-1 min-w-48">{p.nombre}</span>
                  <label class="flex items-center gap-2.5 text-sm text-texto-suave cursor-pointer select-none">
                    <span class="relative inline-flex items-center shrink-0">
                      <input
                        type="checkbox"
                        name="activa"
                        checked={p.activa}
                        class="peer sr-only"
                      />
                      <span class="w-9 h-5 rounded-pill bg-borde peer-checked:bg-primario transition-colors" />
                      <span class="absolute left-0.5 top-0.5 w-4 h-4 rounded-pill bg-white shadow-sm transition-transform peer-checked:translate-x-4" />
                    </span>
                    <span class="font-titulo font-medium">Activa</span>
                  </label>
                  <button
                    type="submit"
                    class="border-2 border-borde rounded-pill px-4 py-2 font-titulo font-medium text-texto-suave hover:border-primario-claro transition-colors"
                  >
                    Guardar
                  </button>
                  <span class="msg text-sm" />
                </form>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="font-titulo font-bold text-xl text-negro mb-3">Plazos de pago</h2>
    <form
      id="form-plazos"
      class="flex flex-wrap items-end gap-4 rounded-card border-2 border-borde px-5 py-4 bg-superficie max-w-xl"
    >
      <label class="flex flex-col gap-1 text-sm text-texto-suave">
        Plazo largo (hs)
        <input
          type="number"
          name="horasPlazoLargo"
          value={configPagos.horas_plazo_largo}
          class="border-2 border-borde rounded-card px-3 py-2 w-24 focus:border-primario focus:outline-none"
        />
      </label>
      <label class="flex flex-col gap-1 text-sm text-texto-suave">
        Plazo corto (hs)
        <input
          type="number"
          name="horasPlazoCorto"
          value={configPagos.horas_plazo_corto}
          class="border-2 border-borde rounded-card px-3 py-2 w-24 focus:border-primario focus:outline-none"
        />
      </label>
      <label class="flex flex-col gap-1 text-sm text-texto-suave">
        Umbral anticipación (días)
        <input
          type="number"
          name="diasUmbralAnticipacion"
          value={configPagos.dias_umbral_anticipacion}
          class="border-2 border-borde rounded-card px-3 py-2 w-24 focus:border-primario focus:outline-none"
        />
      </label>
      <button
        type="submit"
        class="border-2 border-borde rounded-card px-4 py-2 font-titulo font-medium text-texto-suave hover:border-primario-claro transition-colors"
      >
        Guardar
      </button>
      <span class="msg text-sm"></span>
    </form>
  </section>

  <script>
    // Confirmación explícita antes de guardar cualquier cambio de
    // Configuración — es uso diario de la dueña, un guardado accidental
    // afecta precios/cupos en vivo del sitio público.
    async function guardar(url: string, body: unknown, msgEl: HTMLElement) {
      if (!confirm('¿Confirmas guardar este cambio?')) return;
      msgEl.textContent = 'Guardando…';
      msgEl.className = 'msg text-sm text-texto-suave';
      const res = await fetch(url, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) {
        msgEl.textContent = data.error ?? 'Error al guardar';
        msgEl.className = 'msg text-sm text-primario font-medium';
        return;
      }
      msgEl.textContent = 'Guardado';
      msgEl.className = 'msg text-sm text-confirmado font-medium';
    }

    document.querySelectorAll<HTMLFormElement>('.form-unidad').forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        guardar(
          '/api/panel/admin/unidades',
          {
            id: form.dataset.id,
            cupoTotal: fd.get('cupoTotal') || undefined,
          },
          form.querySelector('.msg')!
        );
      });
    });

    document.querySelectorAll<HTMLFormElement>('.form-opcion-precio').forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        guardar(
          '/api/panel/admin/opciones-precio',
          {
            id: form.dataset.id,
            precioPorNoche: fd.get('precioPorNoche'),
          },
          form.querySelector('.msg')!
        );
      });
    });

    document.querySelectorAll<HTMLFormElement>('.form-parcela').forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        guardar(
          '/api/panel/admin/parcelas',
          { id: form.dataset.id, activa: fd.get('activa') === 'on' },
          form.querySelector('.msg')!
        );
      });
    });

    const formPlazos = document.getElementById('form-plazos') as HTMLFormElement | null;
    formPlazos?.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(formPlazos);
      guardar(
        '/api/panel/admin/configuracion-pagos',
        {
          horasPlazoLargo: fd.get('horasPlazoLargo'),
          horasPlazoCorto: fd.get('horasPlazoCorto'),
          diasUmbralAnticipacion: fd.get('diasUmbralAnticipacion'),
        },
        formPlazos.querySelector('.msg')!
      );
    });

    // ── Imágenes del reservador ──────────────────────────────────────────
    // Sube / reordena / borra las fotos del carrusel de cada unidad
    // (/api/panel/admin/unidades-imagenes). No reusa guardar() porque hace
    // varias operaciones distintas y re-renderiza la grilla en el acto.
    type ItemImagen = { raw: string; url: string };

    const datosEl = document.getElementById('datos-imagenes-unidad');
    const imagenesPorUnidad: Record<string, ItemImagen[]> = datosEl
      ? JSON.parse(datosEl.textContent || '{}')
      : {};

    function setMsg(el: HTMLElement, texto: string, tono: 'info' | 'ok' | 'error') {
      el.textContent = texto;
      const clase =
        tono === 'ok'
          ? 'text-confirmado font-medium'
          : tono === 'error'
            ? 'text-primario font-medium'
            : 'text-texto-suave';
      el.className = `msg text-sm ${clase}`;
    }

    document.querySelectorAll<HTMLElement>('.galeria-unidad').forEach((card) => {
      const unidadId = card.dataset.id!;
      const nombre = card.dataset.nombre ?? 'esta unidad';
      const lista = card.querySelector<HTMLElement>('.lista-imagenes')!;
      const input = card.querySelector<HTMLInputElement>('.input-foto')!;
      const msg = card.querySelector<HTMLElement>('.msg')!;
      let items: ItemImagen[] = imagenesPorUnidad[unidadId] ?? [];

      function render() {
        if (items.length === 0) {
          lista.innerHTML =
            '<p class="col-span-full text-sm text-texto-suave">Sin fotos: el carrusel muestra “Fotos próximamente”.</p>';
          return;
        }
        lista.innerHTML = items
          .map(
            (it, i) => `
            <figure class="relative rounded-card overflow-hidden border-2 ${
              i === 0 ? 'border-primario' : 'border-borde'
            } bg-fondo-alt">
              <img src="${it.url}" alt="" class="w-full aspect-video object-cover" />
              ${i === 0 ? '<figcaption class="absolute top-1 left-1 text-[10px] font-titulo font-bold bg-primario text-white rounded-pill px-2 py-0.5">Portada</figcaption>' : ''}
              <div class="absolute bottom-1 right-1 flex gap-1">
                <button type="button" data-accion="izq" data-i="${i}" ${i === 0 ? 'disabled' : ''}
                  class="w-7 h-7 rounded-full bg-black/55 text-white text-sm flex items-center justify-center disabled:opacity-30" aria-label="Mover antes">‹</button>
                <button type="button" data-accion="der" data-i="${i}" ${i === items.length - 1 ? 'disabled' : ''}
                  class="w-7 h-7 rounded-full bg-black/55 text-white text-sm flex items-center justify-center disabled:opacity-30" aria-label="Mover después">›</button>
                <button type="button" data-accion="borrar" data-i="${i}"
                  class="w-7 h-7 rounded-full bg-black/55 text-white text-sm flex items-center justify-center hover:bg-primario" aria-label="Quitar foto">✕</button>
              </div>
            </figure>`
          )
          .join('');
      }

      async function pedir(method: string, body: BodyInit, headers?: HeadersInit) {
        const res = await fetch('/api/panel/admin/unidades-imagenes', { method, body, headers });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'No se pudo guardar el cambio');
        // El endpoint devuelve la lista nueva (raw) y sus URLs, en orden.
        const raw: string[] = data.imagenes ?? [];
        const urls: string[] = data.urls ?? [];
        return raw.map((r, i) => ({ raw: r, url: urls[i] ?? r }));
      }

      async function reordenar(desde: number, hasta: number) {
        const copia = items.slice();
        const [movido] = copia.splice(desde, 1);
        copia.splice(hasta, 0, movido);
        setMsg(msg, 'Guardando…', 'info');
        try {
          items = await pedir(
            'PATCH',
            JSON.stringify({ unidadId, imagenes: copia.map((i) => i.raw) }),
            { 'Content-Type': 'application/json' }
          );
          render();
          setMsg(msg, 'Orden guardado', 'ok');
        } catch (e) {
          setMsg(msg, (e as Error).message, 'error');
        }
      }

      async function borrar(indice: number) {
        const objetivo = items[indice];
        if (!confirm(`¿Quitar esta foto de ${nombre}? Se elimina del sitio.`)) return;
        setMsg(msg, 'Quitando…', 'info');
        try {
          items = await pedir('DELETE', JSON.stringify({ unidadId, imagen: objetivo.raw }), {
            'Content-Type': 'application/json',
          });
          render();
          setMsg(msg, 'Foto quitada', 'ok');
        } catch (e) {
          setMsg(msg, (e as Error).message, 'error');
        }
      }

      lista.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-accion]');
        if (!btn) return;
        const i = Number(btn.dataset.i);
        if (btn.dataset.accion === 'izq') reordenar(i, i - 1);
        else if (btn.dataset.accion === 'der') reordenar(i, i + 1);
        else if (btn.dataset.accion === 'borrar') borrar(i);
      });

      input.addEventListener('change', async () => {
        const file = input.files?.[0];
        if (!file) return;
        setMsg(msg, 'Subiendo…', 'info');
        const fd = new FormData();
        fd.append('unidadId', unidadId);
        fd.append('file', file);
        try {
          items = await pedir('POST', fd);
          render();
          setMsg(msg, 'Foto agregada', 'ok');
        } catch (e) {
          setMsg(msg, (e as Error).message, 'error');
        } finally {
          input.value = '';
        }
      });

      render();
    });
  </script>
</PanelLayout>
