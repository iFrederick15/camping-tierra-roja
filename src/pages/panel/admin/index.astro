---
import PanelLayout from '../../../layouts/PanelLayout.astro';
import { listarReservas } from '../../../lib/reservas';
import { supabaseAdmin } from '../../../lib/supabase';

const [llegadas, salidas, pendientesPago] = await Promise.all([
  listarReservas({ modo: 'llegadas-hoy' }),
  listarReservas({ modo: 'salidas-hoy' }),
  listarReservas({ modo: 'pendientes-pago' }),
]);

// Ocupación actual: reservas con check-in hecho (todavía no hicieron check-out),
// agrupadas por tipo de unidad, contra la capacidad total de cada una.
const { data: unidades } = await supabaseAdmin
  .from('unidades')
  .select('id, tipo, nombre, cupo_total, parcelas(id, activa)');

const { data: ocupadas } = await supabaseAdmin
  .from('reservas')
  .select('unidad_id')
  .eq('estado', 'CHECKIN_HECHO');

const conteoOcupadas = new Map<string, number>();
for (const r of ocupadas ?? []) {
  conteoOcupadas.set(r.unidad_id, (conteoOcupadas.get(r.unidad_id) ?? 0) + 1);
}

const ocupacion = (unidades ?? []).map((u: any) => {
  const capacidad = u.tipo === 'CABANA' ? 1 : u.tipo === 'CAMPING' ? u.cupo_total ?? 0 : (u.parcelas ?? []).filter((p: any) => p.activa).length;
  return { nombre: u.nombre, ocupadas: conteoOcupadas.get(u.id) ?? 0, capacidad };
});
---

<PanelLayout title="Vista operativa" activo="operativa">
  <h1 class="font-titulo font-bold text-3xl text-negro mb-8">Vista operativa</h1>

  <div class="grid sm:grid-cols-3 gap-4 mb-10">
    <div class="bg-superficie rounded-card border-2 border-borde p-5">
      <span class="text-texto-suave text-sm">Llegadas hoy</span>
      <p class="font-titulo font-bold text-3xl text-negro">{llegadas.length}</p>
    </div>
    <div class="bg-superficie rounded-card border-2 border-borde p-5">
      <span class="text-texto-suave text-sm">Salidas hoy</span>
      <p class="font-titulo font-bold text-3xl text-negro">{salidas.length}</p>
    </div>
    <div class="bg-superficie rounded-card border-2 border-borde p-5">
      <span class="text-texto-suave text-sm">Pagos pendientes</span>
      <p class="font-titulo font-bold text-3xl text-primario">{pendientesPago.length}</p>
    </div>
  </div>

  <h2 class="font-titulo font-bold text-xl text-negro mb-3">Ocupación actual</h2>
  <div class="flex flex-col gap-2 mb-10">
    {
      ocupacion.map((u) => (
        <div class="flex items-center justify-between rounded-card border-2 border-borde px-5 py-3 bg-superficie">
          <span class="font-titulo font-medium text-negro">{u.nombre}</span>
          <span class="text-texto-suave text-sm">{u.ocupadas} / {u.capacidad}</span>
        </div>
      ))
    }
  </div>

  <div class="flex gap-4">
    <a href="/panel" class="text-primario font-titulo font-medium hover:underline">Ver Inicio de Staff →</a>
    <a href="/panel/pendientes-pago" class="text-primario font-titulo font-medium hover:underline">Ver pendientes de pago →</a>
  </div>
</PanelLayout>
