---
import PanelLayout from '../../../layouts/PanelLayout.astro';
import { supabaseAdmin } from '../../../lib/supabase';
import {
  hoyISO,
  calcularEstadoPago,
  listarBloqueos,
  type TipoUnidad,
  type Bloqueo,
} from '../../../lib/reservas';

const pad = (n: number) => String(n).padStart(2, '0');

const ETIQUETAS_TIPO: Record<TipoUnidad, string> = {
  CABANA: 'Cabaña',
  CAMPING: 'Camping',
  MOTORHOME: 'Motorhome',
  QUINCHOS: 'Quinchos',
};
const ORDEN_TIPOS: TipoUnidad[] = ['CAMPING', 'MOTORHOME', 'CABANA', 'QUINCHOS'];

// Mes visible: querystring ?mes=YYYY-MM, default al mes actual (huso horario
// de Puerto Iguazú, igual que hoyISO()) — evita el off-by-one de usar la
// fecha UTC del server cerca de medianoche/fin de mes.
const mesParam = Astro.url.searchParams.get('mes');
const mesValido = mesParam && /^\d{4}-\d{2}$/.test(mesParam) ? mesParam : hoyISO().slice(0, 7);
const [anioStr, mesStr] = mesValido.split('-');
const anio = Number(anioStr);
const mesNum = Number(mesStr) - 1; // 0-indexado, como Date

const inicioMes = `${anio}-${pad(mesNum + 1)}-01`;
const primerDiaSiguiente = new Date(anio, mesNum + 1, 1);
const finMes = `${primerDiaSiguiente.getFullYear()}-${pad(primerDiaSiguiente.getMonth() + 1)}-01`;
const diasEnMes = new Date(anio, mesNum + 1, 0).getDate();
const nombreMes = new Date(anio, mesNum, 1).toLocaleDateString('es-AR', {
  month: 'long',
  year: 'numeric',
});

const mesAnteriorDate = new Date(anio, mesNum - 1, 1);
const mesAnterior = `${mesAnteriorDate.getFullYear()}-${pad(mesAnteriorDate.getMonth() + 1)}`;
const mesSiguienteStr = `${primerDiaSiguiente.getFullYear()}-${pad(primerDiaSiguiente.getMonth() + 1)}`;

const hoy = hoyISO();
const esMesActual = hoy.slice(0, 7) === mesValido;
const hoyDia = esMesActual ? Number(hoy.slice(8, 10)) : null;

// Por defecto el tablero arranca en el día de hoy (lo que ya pasó no aporta
// para decidir dónde meter una reserva nueva) pero el usuario puede pedir
// ?completo=1 para volver a ver los días anteriores del mes actual. En
// meses pasados/futuros siempre se ve el mes completo.
const completoParam = Astro.url.searchParams.get('completo') === '1';
const diaInicioVisible = esMesActual && !completoParam ? (hoyDia ?? 1) : 1;
const inicioVisible = `${anio}-${pad(mesNum + 1)}-${pad(diaInicioVisible)}`;

const dias = Array.from({ length: diasEnMes - diaInicioVisible + 1 }, (_, i) => {
  const dia = diaInicioVisible + i;
  const fecha = new Date(anio, mesNum, dia);
  return {
    dia,
    diaSemana: fecha.toLocaleDateString('es-AR', { weekday: 'short' }).replace('.', ''),
  };
});

// Tipo de item visible: querystring ?tipo=CABANA|CAMPING|MOTORHOME|QUINCHOS,
// default al primero de la lista.
const tipoParam = Astro.url.searchParams.get('tipo');
const tipoSeleccionado = ORDEN_TIPOS.includes(tipoParam as TipoUnidad)
  ? (tipoParam as TipoUnidad)
  : ORDEN_TIPOS[0];

const { data: unidadSel } = await supabaseAdmin
  .from('unidades')
  .select('id, nombre, cupo_total')
  .eq('tipo', tipoSeleccionado)
  .single();

interface ReservaFila {
  id: string;
  nombreCliente: string;
  fechaIngreso: string;
  fechaSalida: string;
  estado: string;
  montoTotal: number;
  montoPagado: number;
  parcelaId: string | null;
}

let reservasDelMes: ReservaFila[] = [];
if (unidadSel) {
  const { data: reservasData } = await supabaseAdmin
    .from('reservas')
    .select(
      'id, nombre_cliente, fecha_ingreso, fecha_salida, estado, monto_total, monto_pagado, parcela_id'
    )
    .eq('unidad_id', unidadSel.id)
    .lt('fecha_ingreso', finMes)
    .gt('fecha_salida', inicioMes)
    .neq('estado', 'CANCELADA');

  reservasDelMes = (reservasData ?? []).map((r) => ({
    id: r.id,
    nombreCliente: r.nombre_cliente,
    fechaIngreso: r.fecha_ingreso,
    fechaSalida: r.fecha_salida,
    estado: r.estado,
    montoTotal: Number(r.monto_total),
    montoPagado: Number(r.monto_pagado),
    parcelaId: r.parcela_id,
  }));
}

// Fechas que la dueña deshabilitó a mano (ver sql/009_bloqueos.sql). Se
// dibujan en el tablero igual que las reservas porque ocupan lugar igual
// que ellas.
const bloqueosDelMes: Bloqueo[] = unidadSel
  ? await listarBloqueos(unidadSel.id, inicioMes, finMes)
  : [];

// Una "ocupación" es cualquier cosa que tape días del tablero: una reserva
// o un bloqueo. Se dibujan igual (una barra que abarca su rango), pero el
// bloqueo no tiene cliente ni pantalla de detalle.
type Ocupacion =
  | { clase: 'reserva'; inicio: string; fin: string; reserva: ReservaFila }
  | { clase: 'bloqueo'; inicio: string; fin: string; bloqueo: Bloqueo };

const comoOcupacion = (r: ReservaFila): Ocupacion => ({
  clase: 'reserva',
  inicio: r.fechaIngreso,
  fin: r.fechaSalida,
  reserva: r,
});

const comoOcupacionBloqueo = (b: Bloqueo): Ocupacion => ({
  clase: 'bloqueo',
  inicio: b.fechaInicio,
  fin: b.fechaFin,
  bloqueo: b,
});

const capacidadCamping = unidadSel?.cupo_total ?? 0;

// Bloqueos de la unidad entera: tapan todas las filas del tipo.
const bloqueosDeToda = bloqueosDelMes.filter((b) => b.parcelaId === null && b.plazas === null);

// Filas del tablero: para MOTORHOME/QUINCHOS cada fila es una parcela física
// real (así la ocupación se ve en el lugar exacto donde quedó asignada). Para
// CAMPING, que no tiene identidad física por reserva, se empaquetan las
// reservas en "carriles" sin superposición hasta llenar el cupo_total. Para
// CABANA, unidad única, una sola fila.
interface Fila {
  etiqueta: string;
  ocupaciones: Ocupacion[];
  // Solo QUINCHOS: la parcela y su categoría de precio (opciones_precio.clave)
  // permiten precargar la reserva nueva con el lugar exacto que se clickeó —
  // ver obtenerDisponibilidad() en lib/reservas.ts, que filtra parcelas de
  // QUINCHOS por esa categoría. MOTORHOME no la necesita para reservar: la
  // parcela siempre se asigna automática en el backend
  // (asignarParcelaMotorhome). Sí la usan los dos para bloquear: ahí la
  // dueña deshabilita un lugar puntual.
  parcelaId?: string;
  categoria?: string;
}

let filas: Fila[] = [];

if (tipoSeleccionado === 'MOTORHOME' || tipoSeleccionado === 'QUINCHOS') {
  const { data: parcelasData } = await supabaseAdmin
    .from('parcelas')
    .select('id, numero, nombre, opciones_precio(clave)')
    .eq('unidad_id', unidadSel?.id ?? '')
    .order('numero');

  const idsConocidos = new Set((parcelasData ?? []).map((p) => p.id));
  const sinAsignar = reservasDelMes.filter((r) => !r.parcelaId || !idsConocidos.has(r.parcelaId));

  filas = (parcelasData ?? []).map((p: any) => ({
    etiqueta: p.nombre,
    ocupaciones: [
      ...reservasDelMes.filter((r) => r.parcelaId === p.id).map(comoOcupacion),
      ...bloqueosDelMes.filter((b) => b.parcelaId === p.id).map(comoOcupacionBloqueo),
      ...bloqueosDeToda.map(comoOcupacionBloqueo),
    ],
    parcelaId: p.id,
    categoria: p.opciones_precio?.clave,
  }));

  if (sinAsignar.length > 0) {
    filas.unshift({ etiqueta: 'Sin lugar', ocupaciones: sinAsignar.map(comoOcupacion) });
  }
} else if (tipoSeleccionado === 'CAMPING') {
  // Cada bloqueo del camping ocupa "plazas" lugares del cupo (null = el cupo
  // entero): se repite esa cantidad de veces para que el empaquetado por
  // carriles los muestre como lugares realmente ocupados.
  const items: Ocupacion[] = [
    ...reservasDelMes.map(comoOcupacion),
    ...bloqueosDelMes.flatMap((b) =>
      Array.from({ length: b.plazas ?? capacidadCamping }, () => comoOcupacionBloqueo(b))
    ),
  ];
  const ordenadas = [...items].sort((a, b) => a.inicio.localeCompare(b.inicio));
  const finPorCarril: string[] = [];
  const carriles: Ocupacion[][] = [];
  for (const item of ordenadas) {
    let idx = finPorCarril.findIndex((fin) => fin <= item.inicio);
    if (idx === -1) {
      idx = finPorCarril.length;
      carriles.push([]);
    }
    finPorCarril[idx] = item.fin;
    carriles[idx].push(item);
  }
  filas = carriles.map((ocupaciones, i) => ({ etiqueta: `Lugar ${i + 1}`, ocupaciones }));

  while (filas.length < capacidadCamping) {
    filas.push({ etiqueta: `Lugar ${filas.length + 1}`, ocupaciones: [] });
  }
} else {
  filas = [
    {
      etiqueta: unidadSel?.nombre ?? 'Cabaña',
      ocupaciones: [
        ...reservasDelMes.map(comoOcupacion),
        ...bloqueosDelMes.map(comoOcupacionBloqueo),
      ],
    },
  ];
}

type EstadoVisual = 'RESERVA' | 'CHECKIN' | 'ADEUDADO' | 'CHECKOUT';

function estadoVisual(r: ReservaFila): EstadoVisual {
  if (r.estado === 'CHECKOUT_HECHO') return 'CHECKOUT';
  if (calcularEstadoPago(r.montoTotal, r.montoPagado) !== 'PAGADO') return 'ADEUDADO';
  return r.estado === 'CHECKIN_HECHO' ? 'CHECKIN' : 'RESERVA';
}

const ESTILO_VISUAL: Record<EstadoVisual, { label: string; className: string }> = {
  RESERVA: { label: 'Reserva', className: 'bg-sky-600' },
  CHECKIN: { label: 'Checkin', className: 'bg-confirmado' },
  ADEUDADO: { label: 'Adeudado', className: 'bg-advertencia' },
  CHECKOUT: { label: 'Checkout', className: 'bg-texto-suave' },
};

// Rayado diagonal para los bloqueos: se distingue de un vistazo de las
// barras planas de las reservas, sin sumar otro color a la leyenda.
const RAYADO_BLOQUEO =
  'repeating-linear-gradient(45deg, var(--color-texto) 0 6px, var(--color-texto-suave) 6px 12px)';

// Convierte las ocupaciones (no superpuestas) de una fila en una secuencia de
// segmentos que cubre el mes completo: barras de varios días para cada
// reserva o bloqueo (colspan) y celdas sueltas de 1 día para los huecos
// vacíos — así el "hoy" se puede resaltar celda por celda.
interface Segmento {
  colspan: number;
  inicioDia: number;
  ocupacion?: Ocupacion;
}

function construirSegmentos(ocupaciones: Ocupacion[]): Segmento[] {
  const ordenadas = [...ocupaciones].sort((a, b) => a.inicio.localeCompare(b.inicio));
  const segmentos: Segmento[] = [];
  let cursor = diaInicioVisible;
  for (const o of ordenadas) {
    const inicioDia = o.inicio < inicioVisible ? diaInicioVisible : Number(o.inicio.slice(8, 10));
    const finDiaExclusivo = o.fin >= finMes ? diasEnMes + 1 : Number(o.fin.slice(8, 10));
    while (cursor < inicioDia) {
      segmentos.push({ colspan: 1, inicioDia: cursor });
      cursor++;
    }
    if (finDiaExclusivo <= cursor) continue;
    segmentos.push({ colspan: finDiaExclusivo - cursor, inicioDia: cursor, ocupacion: o });
    cursor = finDiaExclusivo;
  }
  while (cursor <= diasEnMes) {
    segmentos.push({ colspan: 1, inicioDia: cursor });
    cursor++;
  }
  return segmentos;
}

const filasConSegmentos = filas.map((fila) => ({
  ...fila,
  segmentos: construirSegmentos(fila.ocupaciones),
}));

// Texto del tooltip de un bloqueo: la nota si la hay, más quién lo puso.
function tituloBloqueo(b: Bloqueo): string {
  const partes = [b.nota?.trim() || 'Fechas bloqueadas'];
  if (b.parcelaId === null && b.plazas === null) partes.push('toda la unidad');
  if (b.creadoPor) partes.push(`bloqueó ${b.creadoPor}`);
  return partes.join(' · ');
}
---

<PanelLayout title="Calendario de ocupación" activo="calendario">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
    <h1 class="font-titulo font-bold text-3xl text-negro capitalize">{nombreMes}</h1>
    <div class="flex flex-wrap items-center gap-2">
      {
        esMesActual && !completoParam && diaInicioVisible > 1 && (
          <a
            href={`/panel/admin/calendario?mes=${mesValido}&tipo=${tipoSeleccionado}&completo=1`}
            class="shrink-0 whitespace-nowrap px-3 py-1.5 sm:px-4 sm:py-2 rounded-btn border-2 border-borde text-texto font-titulo font-medium text-xs sm:text-sm hover:bg-superficie-elevada transition-colors"
          >
            <span class="sm:hidden">← Días ant.</span>
            <span class="hidden sm:inline">← Ver días anteriores</span>
          </a>
        )
      }
      <a
        href={`/panel/admin/calendario?mes=${mesAnterior}&tipo=${tipoSeleccionado}`}
        class="shrink-0 whitespace-nowrap px-3 py-1.5 sm:px-4 sm:py-2 rounded-btn border-2 border-borde text-texto font-titulo font-medium text-xs sm:text-sm hover:bg-superficie-elevada transition-colors"
      >
        <span class="sm:hidden">← Mes Ant.</span>
        <span class="hidden sm:inline">← Mes anterior</span>
      </a>
      <a
        href={`/panel/admin/calendario?tipo=${tipoSeleccionado}`}
        class="shrink-0 whitespace-nowrap px-3 py-1.5 sm:px-4 sm:py-2 rounded-btn border-2 border-borde text-texto font-titulo font-medium text-xs sm:text-sm hover:bg-superficie-elevada transition-colors"
      >
        Hoy
      </a>
      <a
        href={`/panel/admin/calendario?mes=${mesSiguienteStr}&tipo=${tipoSeleccionado}`}
        class="shrink-0 whitespace-nowrap px-3 py-1.5 sm:px-4 sm:py-2 rounded-btn border-2 border-borde text-texto font-titulo font-medium text-xs sm:text-sm hover:bg-superficie-elevada transition-colors"
      >
        <span class="sm:hidden">Mes Sig. →</span>
        <span class="hidden sm:inline">Mes siguiente →</span>
      </a>
    </div>
  </div>

  <div class="flex gap-1.5 mb-4 flex-wrap">
    {
      ORDEN_TIPOS.map((tipo) => (
        <a
          href={`/panel/admin/calendario?mes=${mesValido}&tipo=${tipo}`}
          class:list={[
            'px-4 py-1.5 rounded-pill font-titulo font-medium text-sm transition-colors',
            tipo === tipoSeleccionado
              ? 'bg-superficie-elevada text-primario font-semibold'
              : 'text-texto-suave hover:bg-superficie-elevada hover:text-primario',
          ]}
        >
          {ETIQUETAS_TIPO[tipo]}
        </a>
      ))
    }
  </div>

  <div class="flex flex-wrap items-center gap-4 text-sm text-texto-suave mb-6">
    {
      (Object.keys(ESTILO_VISUAL) as EstadoVisual[]).map((clave) => (
        <span class="flex items-center gap-1.5">
          <span
            class:list={['w-3 h-3 rounded-full inline-block', ESTILO_VISUAL[clave].className]}
          />
          {ESTILO_VISUAL[clave].label}
        </span>
      ))
    }
    <span class="flex items-center gap-1.5">
      <span class="w-3 h-3 rounded-full inline-block" style={`background-image: ${RAYADO_BLOQUEO}`}
      ></span>
      Bloqueado
    </span>
  </div>

  <p class="text-sm text-texto-suave mb-6 max-w-2xl">
    Hacé clic (o arrastrá) sobre los días libres de una fila para crear una reserva o para
    <strong class="font-medium text-texto">bloquear esas fechas</strong> y que dejen de poder reservarse
    desde la web. Hacé clic sobre un bloqueo para quitarlo.
  </p>

  <div class="bg-superficie rounded-card border-2 border-borde overflow-hidden">
    <div class="overflow-x-auto pl-2">
      <table class="border-collapse w-full select-none">
        <thead>
          <tr>
            <th
              class="sticky left-0 z-10 bg-superficie-elevada border-b-2 border-r-2 border-borde w-36 min-w-36 p-2 text-left text-xs font-titulo font-medium text-texto-suave"
            >
              {ETIQUETAS_TIPO[tipoSeleccionado]}
            </th>
            {
              dias.map((d) => (
                <th
                  class:list={[
                    'border-b-2 border-l border-borde w-[60px] min-w-[60px] py-1.5 text-xs font-titulo font-medium capitalize whitespace-nowrap',
                    d.dia === hoyDia ? 'bg-amber-100 text-negro' : 'text-texto-suave',
                  ]}
                >
                  <div>{d.diaSemana}</div>
                  <div class="text-sm">{d.dia}</div>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            filasConSegmentos.map((fila) => (
              <tr
                data-parcela-id={fila.parcelaId ?? ''}
                data-categoria={fila.categoria ?? ''}
                data-etiqueta={fila.etiqueta}
              >
                <td class="sticky left-0 z-10 bg-superficie border-b border-r-2 border-borde w-36 min-w-36 px-2 py-1.5 text-sm font-titulo font-medium text-texto whitespace-nowrap overflow-hidden text-ellipsis">
                  {fila.etiqueta}
                </td>
                {fila.segmentos.map((seg) =>
                  seg.ocupacion?.clase === 'reserva' ? (
                    <td colspan={seg.colspan} class="border-b border-l border-borde p-0">
                      <a
                        href={`/panel/reservas/${seg.ocupacion.reserva.id}`}
                        class:list={[
                          'flex items-center h-9 px-2 text-xs font-medium text-white whitespace-nowrap overflow-hidden text-ellipsis hover:brightness-110 transition-[filter]',
                          ESTILO_VISUAL[estadoVisual(seg.ocupacion.reserva)].className,
                        ]}
                        title={`${seg.ocupacion.reserva.nombreCliente} · ${ESTILO_VISUAL[estadoVisual(seg.ocupacion.reserva)].label}`}
                      >
                        {seg.ocupacion.reserva.nombreCliente}
                      </a>
                    </td>
                  ) : seg.ocupacion?.clase === 'bloqueo' ? (
                    <td colspan={seg.colspan} class="border-b border-l border-borde p-0">
                      <button
                        type="button"
                        class="bloqueo-barra flex items-center gap-1 w-full h-9 px-2 text-xs font-medium text-white whitespace-nowrap overflow-hidden text-ellipsis hover:brightness-125 transition-[filter]"
                        style={`background-image: ${RAYADO_BLOQUEO}`}
                        data-bloqueo-id={seg.ocupacion.bloqueo.id}
                        data-nota={seg.ocupacion.bloqueo.nota ?? ''}
                        title={`${tituloBloqueo(seg.ocupacion.bloqueo)} · clic para quitar el bloqueo`}
                      >
                        <span class="material-symbols-outlined text-[14px] shrink-0">lock</span>
                        <span class="overflow-hidden text-ellipsis">
                          {seg.ocupacion.bloqueo.nota?.trim() || 'Bloqueado'}
                        </span>
                      </button>
                    </td>
                  ) : (
                    <td
                      class:list={[
                        'celda-libre border-b border-l border-borde w-[60px] min-w-[60px] h-9 cursor-pointer hover:bg-primario/10 transition-colors',
                        seg.inicioDia === hoyDia ? 'bg-amber-50' : '',
                      ]}
                      data-fecha={`${anio}-${pad(mesNum + 1)}-${pad(seg.inicioDia)}`}
                      title="Haz clic o arrastra para reservar o bloquear estas fechas"
                    />
                  )
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <!--
    Una misma selección de fechas puede terminar en una reserva nueva o en un
    bloqueo, así que el arrastre abre este diálogo en vez de saltar directo a
    la pantalla de reserva (que era lo único que se podía hacer antes).
  -->
  <div
    id="modal-seleccion"
    class="hidden fixed inset-0 z-50 items-center justify-center bg-negro/40 p-4"
  >
    <div
      class="bg-superficie rounded-card border-2 border-borde w-full max-w-md px-6 py-6 flex flex-col gap-5"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-titulo"
    >
      <div>
        <h2 id="modal-titulo" class="font-titulo font-bold text-xl text-negro">
          {ETIQUETAS_TIPO[tipoSeleccionado]}
        </h2>
        <p id="modal-rango" class="text-sm text-texto-suave mt-1"></p>
      </div>

      <div id="modal-acciones" class="flex flex-col gap-2">
        <button
          type="button"
          id="btn-reservar"
          class="inline-flex items-center justify-center gap-2 bg-primario text-white px-5 py-2.5 rounded-pill font-titulo font-bold hover:bg-primario-oscuro transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">event_available</span>
          Crear reserva
        </button>
        <button
          type="button"
          id="btn-bloquear"
          class="inline-flex items-center justify-center gap-2 border-2 border-borde px-5 py-2.5 rounded-pill font-titulo font-medium text-texto hover:border-primario-claro transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">lock</span>
          Bloquear fechas
        </button>
      </div>

      <form id="form-bloqueo" class="hidden flex-col gap-4">
        <label class="flex flex-col gap-1 text-sm text-texto-suave">
          Nota (opcional)
          <input
            type="text"
            name="nota"
            maxlength="300"
            placeholder="Mantenimiento, uso propio…"
            class="border-2 border-borde rounded-card px-3 py-2 text-texto focus:border-primario focus:outline-none"
          />
        </label>

        {
          tipoSeleccionado !== 'CABANA' && (
            <label class="flex items-start gap-2 text-sm text-texto-suave cursor-pointer select-none">
              <input
                type="checkbox"
                name="todaLaUnidad"
                class="mt-0.5 w-4 h-4 accent-[var(--color-primario)]"
              />
              <span>
                Bloquear <strong class="font-medium text-texto">todos los lugares</strong> de{' '}
                {ETIQUETAS_TIPO[tipoSeleccionado]} en esas fechas
              </span>
            </label>
          )
        }

        <p id="msg-bloqueo" class="hidden text-sm"></p>

        <div class="flex flex-wrap gap-2">
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 bg-primario text-white px-5 py-2.5 rounded-pill font-titulo font-bold hover:bg-primario-oscuro transition-colors disabled:opacity-40 disabled:pointer-events-none"
          >
            Bloquear
          </button>
          <button
            type="button"
            id="btn-volver"
            class="border-2 border-borde px-5 py-2.5 rounded-pill font-titulo font-medium text-texto-suave hover:border-primario-claro transition-colors"
          >
            Volver
          </button>
        </div>
      </form>

      <button
        type="button"
        id="btn-cerrar-modal"
        class="self-center text-sm font-titulo text-texto-suave hover:text-primario transition-colors"
      >
        Cancelar
      </button>
    </div>
  </div>

  <script define:vars={{ tipoSeleccionado }}>
    // Clic (o arrastre) sobre celdas vacías de una misma fila → diálogo con
    // las dos acciones posibles para ese rango: reservar o bloquear. El
    // arrastre solo tiene sentido dentro de una fila (un mismo lugar), así
    // que se ignora si el mouse sale de la fila donde empezó.
    let arrastrando = false;
    let filaActiva = null;
    let fechaInicio = null;

    // Rango elegido, ya normalizado: "hasta" es exclusiva (fecha de salida),
    // igual que en toda la app.
    let seleccion = null;

    const modal = document.getElementById('modal-seleccion');
    const modalRango = document.getElementById('modal-rango');
    const acciones = document.getElementById('modal-acciones');
    const formBloqueo = document.getElementById('form-bloqueo');
    const msgBloqueo = document.getElementById('msg-bloqueo');

    const fechaCorta = (iso) => `${iso.slice(8, 10)}/${iso.slice(5, 7)}`;

    // Las fechas se calculan en UTC (espejo de diaSiguiente() en
    // lib/reservas.ts): `new Date('2026-10-14T00:00:00')` se interpreta en el
    // huso del navegador y, con husos al este de UTC, .toISOString() devuelve
    // el día anterior — se guardaría un rango corrido un día.
    const enUTC = (iso) => {
      const [anio, mes, dia] = iso.split('-').map(Number);
      return Date.UTC(anio, mes - 1, dia);
    };
    const diaSiguiente = (iso) => new Date(enUTC(iso) + 86400000).toISOString().slice(0, 10);
    const cantidadDeDias = (desde, hasta) => Math.round((enUTC(hasta) - enUTC(desde)) / 86400000);

    function limpiarSeleccion() {
      document.querySelectorAll('.celda-preseleccion').forEach((c) => {
        c.classList.remove('celda-preseleccion', 'bg-primario/20');
      });
    }

    function marcarRango(fila, fechaA, fechaB) {
      limpiarSeleccion();
      const desde = fechaA < fechaB ? fechaA : fechaB;
      const hasta = fechaA < fechaB ? fechaB : fechaA;
      fila.querySelectorAll('.celda-libre').forEach((c) => {
        const f = c.dataset.fecha;
        if (f >= desde && f <= hasta) c.classList.add('celda-preseleccion', 'bg-primario/20');
      });
    }

    function mostrarMensaje(texto, tono) {
      msgBloqueo.textContent = texto;
      msgBloqueo.className =
        tono === 'error' ? 'text-sm text-primario font-medium' : 'text-sm text-texto-suave';
    }

    function cerrarModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      limpiarSeleccion();
      seleccion = null;
    }

    function abrirModal(fila, fechaA, fechaB) {
      const desde = fechaA < fechaB ? fechaA : fechaB;
      const ultimoDia = fechaA < fechaB ? fechaB : fechaA;

      seleccion = {
        desde,
        // "hasta" es la fecha de salida (exclusiva, como en toda la app): un
        // solo día seleccionado equivale a una noche.
        hasta: diaSiguiente(ultimoDia),
        parcelaId: fila.dataset.parcelaId || '',
        categoria: fila.dataset.categoria || '',
        etiqueta: fila.dataset.etiqueta || '',
      };

      const dias = cantidadDeDias(desde, seleccion.hasta);
      modalRango.textContent =
        `${seleccion.etiqueta} · ` +
        (dias === 1
          ? `${fechaCorta(desde)} (1 día)`
          : `${fechaCorta(desde)} al ${fechaCorta(ultimoDia)} (${dias} días)`);

      acciones.classList.remove('hidden');
      formBloqueo.classList.add('hidden');
      formBloqueo.classList.remove('flex');
      formBloqueo.reset();
      msgBloqueo.classList.add('hidden');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    document.querySelectorAll('.celda-libre').forEach((celda) => {
      celda.addEventListener('mousedown', (e) => {
        e.preventDefault();
        arrastrando = true;
        filaActiva = celda.closest('tr');
        fechaInicio = celda.dataset.fecha ?? null;
        if (filaActiva && fechaInicio) marcarRango(filaActiva, fechaInicio, fechaInicio);
      });
      celda.addEventListener('mouseenter', () => {
        if (!arrastrando || !filaActiva || !fechaInicio) return;
        if (celda.closest('tr') !== filaActiva) return;
        marcarRango(filaActiva, fechaInicio, celda.dataset.fecha ?? fechaInicio);
      });
    });

    document.addEventListener('mouseup', () => {
      if (!arrastrando || !filaActiva || !fechaInicio) {
        arrastrando = false;
        return;
      }
      arrastrando = false;
      const seleccionadas = Array.from(filaActiva.querySelectorAll('.celda-preseleccion'))
        .map((c) => c.dataset.fecha)
        .filter(Boolean)
        .sort();
      const fechaFin = seleccionadas[seleccionadas.length - 1] ?? fechaInicio;
      abrirModal(filaActiva, fechaInicio, fechaFin);
    });

    document.getElementById('btn-reservar').addEventListener('click', () => {
      if (!seleccion) return;
      const params = new URLSearchParams({
        tipo: tipoSeleccionado,
        desde: seleccion.desde,
        hasta: seleccion.hasta,
      });
      // Los quinchos se reservan por lugar concreto (cada uno tiene su
      // categoría de precio); en motorhome la parcela la asigna el backend.
      if (tipoSeleccionado === 'QUINCHOS' && seleccion.parcelaId && seleccion.categoria) {
        params.set('parcela', seleccion.parcelaId);
        params.set('categoria', seleccion.categoria);
      }
      window.location.href = `/panel/reservas/nueva?${params}`;
    });

    document.getElementById('btn-bloquear').addEventListener('click', () => {
      acciones.classList.add('hidden');
      formBloqueo.classList.remove('hidden');
      formBloqueo.classList.add('flex');
      formBloqueo.querySelector('input[name="nota"]').focus();
    });

    document.getElementById('btn-volver').addEventListener('click', () => {
      acciones.classList.remove('hidden');
      formBloqueo.classList.add('hidden');
      formBloqueo.classList.remove('flex');
      msgBloqueo.classList.add('hidden');
    });

    document.getElementById('btn-cerrar-modal').addEventListener('click', cerrarModal);
    modal.addEventListener('mousedown', (e) => {
      if (e.target === modal) cerrarModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) cerrarModal();
    });

    formBloqueo.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!seleccion) return;
      const datos = new FormData(formBloqueo);
      const boton = formBloqueo.querySelector('button[type="submit"]');
      boton.disabled = true;
      msgBloqueo.classList.remove('hidden');
      mostrarMensaje('Bloqueando…', 'info');

      try {
        const res = await fetch('/api/panel/admin/bloqueos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            unidadTipo: tipoSeleccionado,
            parcelaId: seleccion.parcelaId || null,
            todaLaUnidad: datos.get('todaLaUnidad') === 'on',
            fechaInicio: seleccion.desde,
            fechaFin: seleccion.hasta,
            nota: datos.get('nota'),
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          mostrarMensaje(data.error ?? 'No se pudo bloquear', 'error');
          boton.disabled = false;
          return;
        }
        // Recargar es lo más simple y deja el tablero coherente: el bloqueo
        // puede cambiar en qué carril cae cada reserva del camping.
        window.location.reload();
      } catch {
        mostrarMensaje('No se pudo bloquear: revisá la conexión', 'error');
        boton.disabled = false;
      }
    });

    // Quitar un bloqueo: clic sobre la barra rayada.
    document.querySelectorAll('.bloqueo-barra').forEach((barra) => {
      barra.addEventListener('click', async () => {
        const nota = barra.dataset.nota;
        if (
          !confirm(
            `¿Quitar este bloqueo${nota ? ` (${nota})` : ''}? Las fechas vuelven a quedar disponibles.`
          )
        ) {
          return;
        }
        const res = await fetch('/api/panel/admin/bloqueos', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: barra.dataset.bloqueoId }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          alert(data.error ?? 'No se pudo quitar el bloqueo');
          return;
        }
        window.location.reload();
      });
    });
  </script>
</PanelLayout>
