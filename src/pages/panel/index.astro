---
import PanelLayout from '../../layouts/PanelLayout.astro';
import FilaReserva from '../../components/panel/FilaReserva.astro';
import BuscadorReservas from '../../components/panel/BuscadorReservas.astro';
import { listarReservas } from '../../lib/reservas';

const [llegadas, salidas] = await Promise.all([
  listarReservas({ modo: 'llegadas-hoy' }),
  listarReservas({ modo: 'salidas-hoy' }),
]);

// La fecha va en el huso de Puerto Iguazú (Vercel corre en UTC), el mismo que
// usa hoyISO() para elegir qué reservas son "de hoy": si no, pasada la
// medianoche UTC el título diría mañana mientras la lista sigue en hoy.
const fecha = new Date().toLocaleDateString('es-AR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  timeZone: 'America/Argentina/Buenos_Aires',
});
const fechaTitulo = fecha.charAt(0).toUpperCase() + fecha.slice(1);

const secciones = [
  {
    id: 'llegadas',
    titulo: 'Llegadas de hoy',
    filas: llegadas,
    vacio: 'No hay llegadas programadas para hoy.',
  },
  {
    id: 'salidas',
    titulo: 'Salidas de hoy',
    filas: salidas,
    vacio: 'No hay salidas programadas para hoy.',
  },
];
---

<PanelLayout title="Hoy" activo="hoy">
  <header class="mb-10 flex flex-col gap-5">
    <div>
      <h1 class="font-titulo text-3xl font-bold text-negro">Hoy</h1>
      <p class="mt-1 text-texto-suave">{fechaTitulo}</p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <BuscadorReservas class="w-full sm:max-w-lg" />
      <!-- Desde lg la topbar ya muestra "Nueva reserva": repetirlo acá dejaba
           dos botones rojos iguales en la misma pantalla. -->
      <a
        href="/panel/reservas/nueva"
        class="inline-flex min-h-12 items-center justify-center gap-1.5 rounded-pill bg-primario pl-4 pr-5 font-titulo font-bold text-white transition-colors hover:bg-primario-oscuro focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40 focus-visible:ring-offset-2 sm:ml-auto lg:hidden"
      >
        <span class="material-symbols-outlined text-xl" aria-hidden="true">add</span>
        Nueva reserva
      </a>
    </div>
  </header>

  <div class="flex flex-col gap-10">
    {
      secciones.map((s) => (
        <section aria-labelledby={`titulo-${s.id}`}>
          <h2 id={`titulo-${s.id}`} class="mb-3 font-titulo text-xl font-bold text-negro">
            {s.titulo}
            <span class="font-medium tabular-nums text-texto-suave"> · {s.filas.length}</span>
          </h2>
          {s.filas.length === 0 ? (
            <p class="rounded-card border-2 border-borde bg-superficie px-5 py-4 text-sm text-texto-suave">
              {s.vacio}
            </p>
          ) : (
            <ul class="flex flex-col gap-2">
              {s.filas.map((r) => (
                <li>
                  <FilaReserva reserva={r} />
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
</PanelLayout>
