---
import PanelLayout from '../../../layouts/PanelLayout.astro';
import RegistrarPago from '../../../components/panel/RegistrarPago.tsx';
import AplicarDescuento from '../../../components/panel/AplicarDescuento.tsx';
import EditarReserva from '../../../components/panel/EditarReserva.tsx';
import ComentariosReserva from '../../../components/panel/ComentariosReserva.tsx';
import {
  obtenerReserva,
  listarComentarios,
  listarPagos,
  contarReservasPrevias,
  calcularEstadoPago,
  calcularNoches,
  ESTILO_ESTADO_PAGO,
  puedeHacerCheckin,
  puedeHacerCheckout,
  codigoReserva,
} from '../../../lib/reservas';

const { id } = Astro.params;
const reserva = await obtenerReserva(id!);

if (!reserva) {
  return Astro.redirect('/panel');
}

const [comentarios, pagos, reservasPrevias] = await Promise.all([
  listarComentarios(reserva.id),
  listarPagos(reserva.id),
  contarReservasPrevias(reserva.dni, reserva.id),
]);

const estadoPago = calcularEstadoPago(reserva.montoTotal, reserva.montoPagado);
const estilo = ESTILO_ESTADO_PAGO[estadoPago];
const habilitaCheckin = puedeHacerCheckin(reserva.montoTotal, reserva.montoPagado);
const habilitaCheckout = puedeHacerCheckout(reserva.montoTotal, reserva.montoPagado);

// Misma condición que antes para editar, cobrar y cancelar: una reserva
// cancelada o ya cerrada con check-out no admite cambios.
const activa =
  reserva.estado === 'REALIZADA' ||
  reserva.estado === 'CONFIRMADA' ||
  reserva.estado === 'CHECKIN_HECHO';
// Antes del check-in: REALIZADA (sin seña) o CONFIRMADA (con seña).
const esperandoLlegada = reserva.estado === 'REALIZADA' || reserva.estado === 'CONFIRMADA';

const noches = calcularNoches(reserva.fechaIngreso, reserva.fechaSalida);
const saldo = Math.max(0, reserva.montoTotal - reserva.montoPagado);
// Total de lista, antes del descuento aplicado desde el Panel (sql/016).
const subtotal = reserva.montoTotal + reserva.descuento;
const porcentajePagado =
  reserva.montoTotal > 0
    ? Math.min(100, Math.round((reserva.montoPagado / reserva.montoTotal) * 100))
    : 0;

// Los timestamps se formatean en el server (Vercel corre en UTC): se fija el
// huso de Puerto Iguazú para no mostrar horas corridas.
const ZONA = 'America/Argentina/Buenos_Aires';
const fmt = (f: string) =>
  new Date(f + 'T00:00:00').toLocaleDateString('es-AR', { day: 'numeric', month: 'long' });
const fmtCorta = (ts: string) =>
  new Date(ts).toLocaleDateString('es-AR', { day: 'numeric', month: 'short', timeZone: ZONA });
const fmtHora = (ts: string) =>
  new Date(ts).toLocaleString('es-AR', {
    day: 'numeric',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: ZONA,
  });
const fmtMoneda = (n: number) => `$${n.toLocaleString('es-AR')}`;

const ESTADO_RESERVA: Record<string, { label: string; className: string }> = {
  REALIZADA: { label: 'Realizada', className: 'bg-fondo-alt text-texto border-borde' },
  CONFIRMADA: { label: 'Confirmada', className: 'bg-superficie text-negro border-borde' },
  CHECKIN_HECHO: {
    label: 'Check-in hecho',
    className: 'bg-confirmado/10 text-confirmado border-confirmado/30',
  },
  CHECKOUT_HECHO: {
    label: 'Check-out hecho',
    className: 'bg-fondo-alt text-texto-suave border-borde',
  },
  CANCELADA: { label: 'Cancelada', className: 'bg-primario/10 text-primario border-primario/30' },
};
const estadoReserva = ESTADO_RESERVA[reserva.estado];

const TIPO_UNIDAD: Record<string, { label: string; icono: string }> = {
  CAMPING: { label: 'Camping', icono: 'forest' },
  MOTORHOME: { label: 'Motorhome', icono: 'airport_shuttle' },
  CABANA: { label: 'Cabaña', icono: 'cottage' },
  QUINCHOS: { label: 'Quincho', icono: 'outdoor_grill' },
  SALON: { label: 'Salón', icono: 'local_activity' },
};
const tipoUnidad = TIPO_UNIDAD[reserva.unidadTipo] ?? TIPO_UNIDAD.CAMPING;

// El quincho se reserva por un solo día (fecha_salida = día siguiente): se
// habla de "1 día", no de noches.
const duracion =
  reserva.unidadTipo === 'QUINCHOS' ? '1 día' : `${noches} ${noches === 1 ? 'noche' : 'noches'}`;
const rangoFechas =
  reserva.unidadTipo === 'QUINCHOS'
    ? fmt(reserva.fechaIngreso)
    : `${fmt(reserva.fechaIngreso)} → ${fmt(reserva.fechaSalida)}`;

// Cada tipo de unidad guarda las personas distinto (mayores/menores en
// camping y cabaña, acompañantes en motorhome): se muestra lo que haya.
const personas = [
  reserva.cantidadMayores > 0 &&
    `${reserva.cantidadMayores} ${reserva.cantidadMayores === 1 ? 'mayor' : 'mayores'}`,
  reserva.cantidadMenores > 0 &&
    `${reserva.cantidadMenores} ${reserva.cantidadMenores === 1 ? 'menor' : 'menores'}`,
  reserva.cantidadAcompanantes > 0 &&
    `${reserva.cantidadAcompanantes} ${reserva.cantidadAcompanantes === 1 ? 'acompañante' : 'acompañantes'}`,
]
  .filter(Boolean)
  .join(', ');

// El plazo es para la seña: con el primer pago la reserva ya no vence (ver
// api/cron/cancelar-vencidas.ts).
const muestraVencimiento = esperandoLlegada && !habilitaCheckin && reserva.fechaLimitePago;
const vencido = Boolean(
  muestraVencimiento && new Date(reserva.fechaLimitePago!).getTime() < Date.now()
);

// Línea de tiempo armada con lo que el backend guarda con fecha: creación,
// pagos, notas y check-in/check-out (sql/013 — las reservas anteriores no
// tienen esa hora y el evento no aparece). El estado actual va al final.
// Check-in y check-out llevan la hora: es lo que se consulta de esos dos.
const eventos = [
  {
    fecha: reserva.creadoEn,
    titulo: reserva.origen === 'WEB' ? 'Reserva web creada' : 'Reserva manual creada',
    detalle: null as string | null,
    conHora: false,
  },
  {
    fecha: reserva.checkinEn ?? '',
    titulo: 'Check-in',
    detalle: null,
    conHora: true,
  },
  {
    fecha: reserva.checkoutEn ?? '',
    titulo: 'Check-out',
    detalle: null,
    conHora: true,
  },
  {
    fecha: reserva.descuento > 0 ? (reserva.descuentoEn ?? '') : '',
    titulo: `Descuento de ${fmtMoneda(reserva.descuento)}`,
    detalle: reserva.descuentoPor,
    conHora: false,
  },
  ...pagos.map((p) => ({
    fecha: p.creadoEn,
    titulo: `Pago de ${fmtMoneda(p.monto)}`,
    detalle: [p.metodo, p.registradoPor].filter(Boolean).join(' · '),
    conHora: false,
  })),
  ...comentarios.map((c) => ({
    fecha: c.creadoEn,
    titulo: 'Nota interna',
    detalle: c.autor ?? 'Staff',
    conHora: false,
  })),
]
  .filter((e) => e.fecha)
  .sort((a, b) => a.fecha.localeCompare(b.fecha));

// Borrar un pago cargado por error es solo de Admin (sql/017).
const esAdmin = Astro.locals.usuario?.rol === 'admin';

const encabezadoSeccion = 'font-titulo font-bold text-negro text-lg';
const etiqueta = 'text-texto-suave text-xs font-titulo font-medium uppercase tracking-wide';
---

<PanelLayout title={reserva.nombreCliente} activo="hoy">
  <a href="/panel" class="text-texto-suave text-sm hover:text-primario mb-4 inline-block"
    >← Volver</a
  >

  <!-- 1. Encabezado -->
  <header class="border-b border-borde pb-6 mb-8 flex flex-col gap-4">
    <div class="flex flex-col gap-1">
      <p class="text-sm text-texto-suave">
        Cod. Reserva: <span class="font-titulo font-bold tracking-widest text-primario select-all"
          >{codigoReserva(reserva.id)}</span
        >
      </p>
      <h1 class="font-titulo font-bold text-3xl text-negro">{reserva.nombreCliente}</h1>
      <p class="text-texto flex flex-wrap items-center gap-x-2 gap-y-1">
        <span class="inline-flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[18px] text-texto-suave"
            >{tipoUnidad.icono}</span
          >
          {reserva.unidadNombre}{reserva.parcelaNombre ? ` · ${reserva.parcelaNombre}` : ''}
        </span>
        <span class="text-borde" aria-hidden="true">|</span>
        <span>{rangoFechas}</span>
        <span class="text-texto-suave">({duracion})</span>
        {
          personas && (
            <>
              <span class="text-borde" aria-hidden="true">
                |
              </span>
              <span>{personas}</span>
            </>
          )
        }
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <span
        class={`border rounded-pill px-3 py-1 text-xs font-titulo font-bold ${estadoReserva.className}`}
      >
        {estadoReserva.label}
      </span>
      <span
        class={`border rounded-pill px-3 py-1 text-xs font-titulo font-bold ${estilo.className}`}
      >
        Pago: {estilo.label}
      </span>
    </div>

    {
      activa && (
        <div class="flex flex-wrap items-center gap-2">
          <div class="has-[>div]:basis-full has-[>div]:order-last">
            <EditarReserva
              client:load
              id={reserva.id}
              unidadTipo={reserva.unidadTipo}
              categoriaSeleccionada={reserva.categoriaSeleccionada}
              fechaIngreso={reserva.fechaIngreso}
              fechaSalida={reserva.fechaSalida}
              parcelaId={reserva.parcelaId}
              cantidadAcompanantes={reserva.cantidadAcompanantes}
              cantidadMenores={reserva.cantidadMenores}
              cantidadMayores={reserva.cantidadMayores}
              nombreCliente={reserva.nombreCliente}
              dni={reserva.dni}
              email={reserva.email}
              telefono={reserva.telefono}
              datosVehiculo={reserva.datosVehiculo}
            />
          </div>
          {estadoPago !== 'PAGADO' && (
            <a
              href="#registrar-pago"
              class="inline-flex items-center gap-1.5 bg-primario text-white pl-4 pr-5 py-2.5 rounded-pill font-titulo font-bold hover:bg-primario-oscuro transition-colors"
            >
              <span class="material-symbols-outlined text-[18px]">add</span>
              Registrar pago
            </a>
          )}
          <details id="menu-acciones" class="relative">
            <summary class="list-none cursor-pointer inline-flex items-center gap-1 border-2 border-borde rounded-pill pl-4 pr-3 py-2 font-titulo font-bold text-texto-suave hover:border-primario-claro transition-colors [&::-webkit-details-marker]:hidden">
              Más
              <span class="material-symbols-outlined text-[18px]">expand_more</span>
            </summary>
            <div class="absolute left-0 sm:left-auto sm:right-0 mt-2 z-20 min-w-48 bg-superficie border-2 border-borde rounded-card py-1.5 shadow-suave">
              <button
                id="btn-cancelar"
                class="w-full text-left px-4 py-2 text-sm font-medium text-primario hover:bg-fondo-alt transition-colors"
              >
                Cancelar reserva
              </button>
            </div>
          </details>
        </div>
      )
    }
  </header>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px] items-start">
    <div class="flex flex-col gap-10 min-w-0">
      <!-- 2. Cliente -->
      <section class="bg-superficie rounded-card border-2 border-borde p-5 flex flex-col gap-4">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class={encabezadoSeccion}>Cliente</h2>
          <span class="text-texto-suave text-sm">
            {
              reservasPrevias === 0
                ? 'Primera reserva'
                : `${reservasPrevias} ${reservasPrevias === 1 ? 'reserva previa' : 'reservas previas'}`
            }
          </span>
        </div>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
          <div>
            <dt class={etiqueta}>DNI</dt>
            <dd class="text-texto mt-0.5">{reserva.dni}</dd>
          </div>
          <div>
            <dt class={etiqueta}>Origen</dt>
            <dd class="text-texto mt-0.5">
              {reserva.origen === 'WEB' ? 'Reserva web' : 'Reserva manual'}
            </dd>
          </div>
          <div class="min-w-0">
            <dt class={etiqueta}>Email</dt>
            <dd class="mt-0.5 truncate">
              {
                reserva.email ? (
                  <a
                    href={`mailto:${reserva.email}`}
                    class="inline-flex items-center gap-1.5 text-texto hover:text-primario"
                  >
                    <span class="material-symbols-outlined text-[16px] text-texto-suave">mail</span>
                    {reserva.email}
                  </a>
                ) : (
                  <span class="text-texto-suave">—</span>
                )
              }
            </dd>
          </div>
          <div>
            <dt class={etiqueta}>Teléfono</dt>
            <dd class="mt-0.5">
              {
                reserva.telefono ? (
                  <a
                    href={`tel:${reserva.telefono}`}
                    class="inline-flex items-center gap-1.5 text-texto hover:text-primario"
                  >
                    <span class="material-symbols-outlined text-[16px] text-texto-suave">call</span>
                    {reserva.telefono}
                  </a>
                ) : (
                  <span class="text-texto-suave">—</span>
                )
              }
            </dd>
          </div>
          <div class="sm:col-span-2">
            <dt class={etiqueta}>Vehículo</dt>
            <dd class="text-texto mt-0.5">{reserva.datosVehiculo ?? '—'}</dd>
          </div>
        </dl>
      </section>

      <!-- 3. Detalle de la reserva -->
      <section class="flex flex-col gap-3">
        <h2 class={encabezadoSeccion}>Detalle de la reserva</h2>
        <div class="bg-superficie rounded-card">
          <div class="flex items-start gap-3 px-5 py-4">
            <span
              class="shrink-0 w-10 h-10 rounded-full bg-fondo-alt text-primario flex items-center justify-center"
            >
              <span class="material-symbols-outlined text-[20px]">{tipoUnidad.icono}</span>
            </span>
            <div class="flex-1 min-w-0">
              <p class="font-titulo font-bold text-negro">
                {tipoUnidad.label}{reserva.parcelaNombre ? ` · ${reserva.parcelaNombre}` : ''}
              </p>
              <p class="text-sm text-texto-suave">
                {rangoFechas} · {duracion}{personas ? ` · ${personas}` : ''}
              </p>
            </div>
            <span class="font-titulo font-bold text-negro shrink-0">
              {fmtMoneda(subtotal)}
            </span>
          </div>

          {
            reserva.detallePrecio.length > 0 && (
              <ul class="border-t border-fondo-alt px-5 py-3 flex flex-col gap-1.5">
                {reserva.detallePrecio.map((d) => (
                  <li class="text-sm flex justify-between gap-3">
                    <span class="text-texto">
                      {d.etiqueta}
                      <span class="text-texto-suave">
                        {' '}
                        {d.cantidad > 1 ? `× ${d.cantidad} ` : ''}· {fmtMoneda(d.precioUnitario)}
                        {reserva.unidadTipo === 'QUINCHOS' ? '' : ' por noche'}
                      </span>
                    </span>
                    <span class="text-texto-suave shrink-0">{fmtMoneda(d.subtotal)}</span>
                  </li>
                ))}
              </ul>
            )
          }

          {
            reserva.descuento > 0 && (
              <div class="border-t border-fondo-alt px-5 py-3 text-sm flex justify-between gap-3">
                <span class="text-texto">
                  Descuento
                  {reserva.descuentoMotivo && (
                    <span class="text-texto-suave"> · {reserva.descuentoMotivo}</span>
                  )}
                </span>
                <span class="text-confirmado font-medium shrink-0">
                  −{fmtMoneda(reserva.descuento)}
                </span>
              </div>
            )
          }

          <div
            class="border-t-2 border-borde px-5 py-3.5 flex justify-between items-baseline gap-3"
          >
            <span class="font-titulo font-bold text-negro">Total</span>
            <span class="font-titulo font-bold text-xl text-negro">
              {fmtMoneda(reserva.montoTotal)}
            </span>
          </div>
        </div>

        {
          activa && (
            <AplicarDescuento
              client:load
              reservaId={reserva.id}
              subtotal={subtotal}
              montoPagado={reserva.montoPagado}
              descuentoActual={reserva.descuento}
              motivoActual={reserva.descuentoMotivo}
            />
          )
        }
      </section>

      <!-- 4. Pagos -->
      <section class="flex flex-col gap-3">
        <h2 class={encabezadoSeccion}>Pagos</h2>

        <div class="flex flex-wrap gap-x-10 gap-y-3 py-1">
          <div>
            <p class={etiqueta}>Saldo pendiente</p>
            <p
              class={`font-titulo font-bold text-2xl ${saldo > 0 ? 'text-primario' : 'text-confirmado'}`}
            >
              {fmtMoneda(saldo)}
            </p>
          </div>
          {
            muestraVencimiento && (
              <div>
                <p class={etiqueta}>Vence</p>
                <p
                  class={`font-titulo font-bold text-2xl ${vencido ? 'text-advertencia' : 'text-negro'}`}
                >
                  {fmtHora(reserva.fechaLimitePago!)}
                </p>
                {vencido && <p class="text-advertencia text-xs font-medium">Plazo vencido</p>}
              </div>
            )
          }
        </div>

        <div class="bg-superficie rounded-card border-2 border-borde overflow-x-auto">
          {
            pagos.length === 0 ? (
              <p class="px-5 py-6 text-sm text-texto-suave">Todavía no hay pagos registrados.</p>
            ) : (
              <table class="w-full text-sm">
                <thead>
                  <tr class="text-left">
                    <th class={`${etiqueta} px-5 py-3`}>Fecha</th>
                    <th class={`${etiqueta} px-3 py-3`}>Concepto</th>
                    <th class={`${etiqueta} px-3 py-3`}>Método</th>
                    <th class={`${etiqueta} px-3 py-3`}>Registró</th>
                    <th class={`${etiqueta} px-5 py-3 text-right`}>Monto</th>
                    {esAdmin && (
                      <th class="px-3 py-3">
                        <span class="sr-only">Acciones</span>
                      </th>
                    )}
                  </tr>
                </thead>
                <tbody>
                  {pagos.map((p) => (
                    <tr class="border-t border-fondo-alt">
                      <td class="px-5 py-3 whitespace-nowrap text-texto">{fmtHora(p.creadoEn)}</td>
                      <td class="px-3 py-3 text-texto">{p.nota ?? 'Pago'}</td>
                      <td class="px-3 py-3 text-texto whitespace-nowrap">{p.metodo}</td>
                      <td class="px-3 py-3 text-texto-suave whitespace-nowrap">
                        {p.registradoPor ?? '—'}
                      </td>
                      <td class="px-5 py-3 text-right font-titulo font-bold text-negro whitespace-nowrap">
                        {fmtMoneda(p.monto)}
                      </td>
                      {esAdmin && (
                        <td class="pr-3 py-3 text-right">
                          <button
                            type="button"
                            data-eliminar-pago={p.id}
                            data-monto={fmtMoneda(p.monto)}
                            title="Eliminar pago"
                            aria-label={`Eliminar pago de ${fmtMoneda(p.monto)}`}
                            class="inline-flex items-center justify-center w-8 h-8 rounded-full text-texto-suave hover:text-primario hover:bg-fondo-alt transition-colors"
                          >
                            <span class="material-symbols-outlined text-[18px]">delete</span>
                          </button>
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            )
          }
        </div>

        {
          activa && saldo > 0 && (
            <div id="registrar-pago" class="scroll-mt-6">
              <RegistrarPago reservaId={reserva.id} saldo={saldo} client:load />
            </div>
          )
        }
      </section>

      <!-- 5. Notas internas -->
      <section>
        <ComentariosReserva reservaId={reserva.id} comentariosIniciales={comentarios} client:load />
      </section>
    </div>

    <!-- 7. Barra lateral: en mobile va antes del contenido para tener a mano
         el saldo y el check-in/check-out. -->
    <aside
      class="order-first lg:order-none lg:sticky lg:top-6 bg-fondo-alt rounded-card p-5 flex flex-col divide-y divide-borde"
    >
      <div class="pb-5 flex flex-col gap-3">
        <h2 class="font-titulo font-bold text-negro">Resumen</h2>
        <dl class="text-sm flex flex-col gap-1.5">
          <div class="flex justify-between gap-3">
            <dt class="text-texto-suave">Total</dt>
            <dd class="text-texto">{fmtMoneda(reserva.montoTotal)}</dd>
          </div>
          {
            reserva.descuento > 0 && (
              <div class="flex justify-between gap-3">
                <dt class="text-texto-suave">Descuento incluido</dt>
                <dd class="text-texto">−{fmtMoneda(reserva.descuento)}</dd>
              </div>
            )
          }
          <div class="flex justify-between gap-3">
            <dt class="text-texto-suave">Pagado</dt>
            <dd class="text-texto">{fmtMoneda(reserva.montoPagado)}</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-texto-suave">Saldo</dt>
            <dd class="font-titulo font-bold text-negro">{fmtMoneda(saldo)}</dd>
          </div>
        </dl>
        <div class="flex items-center gap-2.5">
          <span class="flex-1 h-1.5 rounded-pill bg-superficie overflow-hidden">
            <span
              class={`block h-full rounded-pill ${estadoPago === 'PAGADO' ? 'bg-confirmado' : 'bg-primario-claro'}`}
              style={`width:${porcentajePagado}%`}></span>
          </span>
          <span class="shrink-0 text-texto-suave text-xs">{porcentajePagado}%</span>
        </div>
      </div>

      {
        esperandoLlegada && (
          <form id="form-checkin" class="py-5 flex flex-col gap-3">
            <h2 class="font-titulo font-bold text-negro">Check-in</h2>
            <label class="flex flex-col gap-1 text-sm text-texto-suave">
              Acompañantes
              <input
                type="number"
                name="cantidadAcompanantes"
                min="0"
                value={reserva.cantidadAcompanantes}
                class="bg-superficie border-2 border-borde rounded-card px-4 py-2.5 focus:border-primario focus:outline-none"
              />
            </label>
            <label class="flex flex-col gap-1 text-sm text-texto-suave">
              Vehículo
              <input
                type="text"
                name="datosVehiculo"
                placeholder="Patente / modelo"
                class="bg-superficie border-2 border-borde rounded-card px-4 py-2.5 focus:border-primario focus:outline-none"
              />
            </label>
            {!habilitaCheckin && (
              <p class="text-primario text-sm font-medium">
                Registra al menos un pago para poder hacer check-in.
              </p>
            )}
            <button
              type="submit"
              disabled={!habilitaCheckin}
              class="inline-flex justify-center items-center gap-2 bg-primario text-white px-6 py-2.5 rounded-pill font-titulo font-bold hover:bg-primario-oscuro transition-colors disabled:opacity-40 disabled:pointer-events-none"
            >
              Confirmar check-in
            </button>
          </form>
        )
      }

      {
        reserva.estado === 'CHECKIN_HECHO' && (
          <div class="py-5 flex flex-col gap-3">
            <h2 class="font-titulo font-bold text-negro">Check-out</h2>
            {!habilitaCheckout && (
              <p class="text-primario text-sm font-medium">
                El pago debe estar completo para hacer check-out.
              </p>
            )}
            <button
              id="btn-checkout"
              disabled={!habilitaCheckout}
              class="inline-flex justify-center items-center gap-2 bg-primario text-white px-6 py-2.5 rounded-pill font-titulo font-bold hover:bg-primario-oscuro transition-colors disabled:opacity-40 disabled:pointer-events-none"
            >
              Confirmar check-out
            </button>
          </div>
        )
      }

      <div class="py-5 flex flex-col gap-3">
        <h2 class="font-titulo font-bold text-negro">Recursos asignados</h2>
        <p class="text-sm text-texto flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px] text-texto-suave"
            >{tipoUnidad.icono}</span
          >
          {reserva.unidadNombre}
        </p>
        <p class="text-sm flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px] text-texto-suave">location_on</span>
          {
            reserva.parcelaNombre ? (
              <span class="text-texto">{reserva.parcelaNombre}</span>
            ) : (
              <span class="text-texto-suave">Sin parcela asignada</span>
            )
          }
        </p>
      </div>

      <div class="pt-5 flex flex-col gap-3">
        <h2 class="font-titulo font-bold text-negro">Línea de tiempo</h2>
        <ol class="flex flex-col">
          {
            eventos.map((e) => (
              <li class="relative pl-5 pb-3 border-l-2 border-borde ml-1">
                <span class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-texto-suave" />
                <p class="text-sm text-texto">{e.titulo}</p>
                <p class="text-xs text-texto-suave">
                  {e.conHora ? fmtHora(e.fecha) : fmtCorta(e.fecha)}
                  {e.detalle ? ` · ${e.detalle}` : ''}
                </p>
              </li>
            ))
          }
          <li class="relative pl-5 ml-1 border-l-2 border-transparent">
            <span class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-primario"></span>
            <p class="text-sm font-titulo font-bold text-negro">{estadoReserva.label}</p>
            <p class="text-xs text-texto-suave">Estado actual</p>
          </li>
        </ol>
      </div>
    </aside>
  </div>

  <script define:vars={{ id: reserva.id }}>
    async function accionar(url, opciones) {
      const res = await fetch(url, { method: 'POST', ...opciones });
      const data = await res.json();
      if (!res.ok) {
        alert(data.error ?? 'Ocurrió un error');
        return;
      }
      window.location.reload();
    }

    const formCheckin = document.getElementById('form-checkin');
    if (formCheckin) {
      formCheckin.addEventListener('submit', (e) => {
        e.preventDefault();
        const form = new FormData(formCheckin);
        accionar(`/api/panel/reservas/${id}/checkin`, {
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            cantidadAcompanantes: Number(form.get('cantidadAcompanantes')),
            datosVehiculo: form.get('datosVehiculo'),
          }),
        });
      });
    }

    const btnCheckout = document.getElementById('btn-checkout');
    if (btnCheckout) {
      btnCheckout.addEventListener('click', () =>
        accionar(`/api/panel/reservas/${id}/checkout`, {})
      );
    }

    const btnCancelar = document.getElementById('btn-cancelar');
    if (btnCancelar) {
      btnCancelar.addEventListener('click', () => {
        if (confirm('¿Cancelar esta reserva? Esta acción libera la unidad.')) {
          accionar(`/api/panel/reservas/${id}/cancelar`, {});
        }
      });
    }

    // Solo se renderiza para Admin; el endpoint vuelve a exigir el rol.
    document.querySelectorAll('[data-eliminar-pago]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const motivo = prompt(
          `¿Eliminar el pago de ${btn.dataset.monto}? Se resta de lo pagado y queda una nota interna.\n\nMotivo:`
        );
        if (motivo === null) return;
        if (!motivo.trim()) {
          alert('Indica el motivo para eliminar el pago');
          return;
        }
        const res = await fetch(`/api/panel/reservas/${id}/pagos/${btn.dataset.eliminarPago}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ motivo: motivo.trim() }),
        });
        const data = await res.json();
        if (!res.ok) {
          alert(data.error ?? 'Ocurrió un error');
          return;
        }
        window.location.reload();
      });
    });

    // El menú "Más" es un <details>: se cierra al hacer click fuera de él.
    const menuAcciones = document.getElementById('menu-acciones');
    if (menuAcciones) {
      document.addEventListener('click', (e) => {
        if (!menuAcciones.contains(e.target)) menuAcciones.removeAttribute('open');
      });
    }
  </script>
</PanelLayout>
