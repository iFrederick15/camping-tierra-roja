---
import PanelLayout from '../../layouts/PanelLayout.astro';
import FilaReserva from '../../components/panel/FilaReserva.astro';
import BuscadorReservas from '../../components/panel/BuscadorReservas.astro';
import { listarReservas } from '../../lib/reservas';

const q = Astro.url.searchParams.get('q') ?? '';
const resultados = q ? await listarReservas({ modo: 'buscar', q }) : [];
---

<PanelLayout title="Buscar reserva" activo="buscar">
  <h1 class="font-titulo font-bold text-3xl text-negro mb-6">Buscar reserva</h1>

  <BuscadorReservas valor={q} autofocus class="mb-8 max-w-lg" />

  {
    q && resultados.length === 0 && (
      <p class="text-texto-suave text-sm bg-superficie border-2 border-borde rounded-card px-5 py-4">
        No encontramos reservas para "{q}".
      </p>
    )
  }

  {
    resultados.length > 0 && (
      <div class="flex flex-col gap-2">
        {resultados.map((r) => (
          <FilaReserva reserva={r} mostrarFechas />
        ))}
      </div>
    )
  }
</PanelLayout>
