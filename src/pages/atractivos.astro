---
// Guía de atractivos de Puerto Iguazú. No está en el menú: se llega desde el
// botón de la sección "Ubicación" de la home (ver `src/i18n/config.ts`).
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import PaginaAtractivos from '../components/PaginaAtractivos.astro';
import { ATRACTIVOS } from '../lib/atractivos';
import { idiomaActual, interpolar, traducciones } from '../i18n';

const idioma = idiomaActual(Astro);
const t = traducciones(idioma);
---

<Layout
  title={t.atractivos.metaTitulo}
  description={interpolar(t.atractivos.metaDescripcion, { total: ATRACTIVOS.length })}
>
  <div class="pt-8 md:pt-12">
    <PaginaAtractivos idioma={idioma} t={t} />
  </div>
</Layout>
