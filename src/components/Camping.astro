---
// Sección Camping + Motorhome en layout bento asimétrico
---

<section id="camping" class="py-16 sm:py-20 lg:py-32 px-6 overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-stretch">
      <!-- Camping Card (principal, 7 cols) -->
      <div
        class="lg:col-span-7 rounded-card overflow-hidden relative min-h-95 lg:min-h-130 flex flex-col justify-end p-6 sm:p-8 lg:p-12 group"
      >
        <img
          src="/images/camping/camping.webp"
          alt="Parcelas de camping entre árboles en la selva misionera de Tierra Roja, Puerto Iguazú"
          width="1600"
          height="739"
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-negro/90 via-negro/40 to-transparent">
        </div>

        <div class="relative z-10">
          <h2 class="font-titulo font-bold text-4xl lg:text-5xl text-white mb-5">
            Camping en la Selva
          </h2>
          <p class="text-white/75 text-lg mb-8 max-w-lg leading-relaxed">
            Amplia zona de camping, donde puedes instalar tu carpa y despertar con el sonido de los
            pájaros.
          </p>
          <a
            href="/reservar"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-primario to-acento text-white px-8 py-4 rounded-pill font-titulo font-bold hover:shadow-hero hover:scale-105 transition-all duration-300 active:scale-95"
          >
            Reservar Ahora
            <span class="material-symbols-outlined">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Motorhome Card (secundaria, 5 cols) -->
      <div
        class="lg:col-span-5 bg-superficie-elevada rounded-card overflow-hidden flex flex-col shadow-suave"
      >
        <!-- Imagen -->
        <div class="aspect-video lg:aspect-auto lg:h-1/2 relative overflow-hidden">
          <img
            src="/images/motorhome/motorhome.webp"
            alt="Espacio con conexiones para motorhome y casas rodantes en Camping Tierra Roja, Puerto Iguazú"
            width="1600"
            height="1200"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <!-- Contenido -->
        <div class="lg:h-1/2 p-6 sm:p-8 lg:p-10 flex flex-col justify-between gap-6">
          <div>
            <h3 class="font-titulo font-bold text-2xl lg:text-3xl text-negro mb-4">
              Espacio Motorhome
            </h3>
            <p class="text-texto-suave leading-relaxed">
              Conexiones completas, seguridad 24hs y acceso a todas las instalaciones del camping
              para tu casa rodante.
            </p>
          </div>
          <a
            href="/reservar"
            class="w-full border-2 border-primario text-primario px-8 py-4 rounded-pill font-titulo font-bold text-center hover:bg-primario hover:text-white transition-all duration-300"
          >
            Reservar Ahora
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
