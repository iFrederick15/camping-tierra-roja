---
// Camping + Motorhome, en layout bento asimétrico.
//
// El sector motorhome pasa a tener su propio ancla (#motorhome) y su propio
// H2: es una búsqueda con intención muy alta ("motorhome Puerto Iguazú",
// "motorhome em Puerto Iguazú") y antes vivía como un H3 sin URL propia.
import BotonReserva from './ui/BotonReserva.astro';
import type { Idioma, Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;

const iconosCamping = ['forest', 'shower', 'outdoor_grill', 'pets'];
const iconosMotorhome = ['water_drop', 'outdoor_grill', 'verified', 'group'];
---

<section class="overflow-hidden px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-12 lg:gap-8">
      <!-- Camping (principal) -->
      <article
        id="camping"
        class="relative flex min-h-[26rem] scroll-mt-20 flex-col justify-end overflow-hidden rounded-card p-6 sm:p-8 lg:col-span-7 lg:min-h-[34rem] lg:p-12"
      >
        <img
          src="/images/camping/camping.webp"
          alt="Parcelas de camping entre árboles en la selva misionera de Tierra Roja, Puerto Iguazú"
          width="1600"
          height="739"
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-negro/95 via-negro/55 to-negro/10"></div>

        <div class="relative z-10">
          <p class="mb-2 font-titulo text-xs font-bold uppercase tracking-[0.14em] text-white/70">
            {t.camping.kicker}
          </p>
          <h2 class="mb-4 font-titulo text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
            {t.camping.titulo}
          </h2>
          <p class="mb-6 max-w-lg leading-relaxed text-white/85">
            {t.camping.descripcion}
          </p>
          <ul class="mb-8 grid grid-cols-1 gap-2 sm:grid-cols-2">
            {
              t.camping.lista.map((item, i) => (
                <li class="flex items-center gap-2 text-sm text-white/85">
                  <span class="material-symbols-outlined text-base text-acento" aria-hidden="true">
                    {iconosCamping[i]}
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
          <BotonReserva idioma={idioma} texto={t.camping.cta} unidad="CAMPING" tamano="lg" />
        </div>
      </article>

      <!-- Motorhome (secundaria) -->
      <article
        id="motorhome"
        class="flex scroll-mt-20 flex-col overflow-hidden rounded-card bg-superficie-elevada shadow-suave lg:col-span-5"
      >
        <div class="relative aspect-video overflow-hidden lg:aspect-auto lg:h-[45%]">
          <img
            src="/images/motorhome/motorhome.webp"
            alt="Parcelas con conexiones de agua y luz para motorhome y casas rodantes en Camping Tierra Roja, Puerto Iguazú"
            width="1600"
            height="1200"
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="flex flex-1 flex-col justify-between gap-6 p-6 sm:p-8 lg:p-10">
          <div>
            <h2 class="mb-3 font-titulo text-2xl font-bold text-negro lg:text-3xl">
              {t.camping.motorhomeTitulo}
            </h2>
            <p class="mb-5 leading-relaxed text-texto-suave">
              {t.camping.motorhomeDescripcion}
            </p>
            <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-1">
              {
                t.camping.motorhomeLista.map((item, i) => (
                  <li class="flex items-center gap-2 text-sm text-texto-suave">
                    <span
                      class="material-symbols-outlined text-base text-primario"
                      aria-hidden="true"
                    >
                      {iconosMotorhome[i]}
                    </span>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <BotonReserva
            idioma={idioma}
            texto={t.camping.motorhomeCta}
            unidad="MOTORHOME"
            variante="contorno"
            tamano="lg"
            bloque
          />
        </div>
      </article>
    </div>
  </div>
</section>
