---
// "Tu base para descubrir Iguazú".
//
// Vende la ubicación como parte del producto: nadie viaja a Puerto Iguazú
// por el camping, viaja por las Cataratas — y el camping es la base. Es
// también la sección que más peso tiene para el visitante brasileño, que
// llega por Foz do Iguaçu.
//
// La columna izquierda muestra 8 tarjetas fijas (2 x 4): los seis tiempos de
// viaje de `src/lib/ubicacion.ts` y los dos atractivos de `DESTACADOS_HOME`
// (La Aripuca y el Duty Free). El descriptivo completo de la ACATI —34
// fichas— vive en la página `/atractivos`, a la que se llega solo desde el
// botón de abajo: en la home ocupaba cinco páginas de tarjetas y tapaba el
// resto de la sección.
//
// Los tiempos de viaje que todavía no están confirmados NO se muestran como
// número: se muestra el destino con un "consultar", nunca una distancia
// inventada.
import EncabezadoSeccion from './ui/EncabezadoSeccion.astro';
import BotonReserva from './ui/BotonReserva.astro';
import { PUNTOS_DE_INTERES } from '../lib/ubicacion';
import {
  ATRACTIVOS,
  CATEGORIAS_ATRACTIVOS,
  DESTACADOS_HOME,
  logoDeAtractivo,
} from '../lib/atractivos';
import { NEGOCIO, DIRECCION_COMPLETA } from '../lib/negocio';
import { EVENTOS } from '../lib/analytics';
import { interpolar, RUTAS, type Idioma, type Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;
const tA = t.ubicacion.atractivos;

// El icono de cada categoría se resuelve acá para no buscarlo dentro del map.
const iconoCategoria = Object.fromEntries(
  CATEGORIAS_ATRACTIVOS.map((c) => [c.id, c.icono])
) as Record<string, string>;

// Los tiempos de viaje primero (son el argumento de venta) y después los dos
// atractivos destacados, en el orden en que los lista `DESTACADOS_HOME`.
const tarjetas = [
  ...PUNTOS_DE_INTERES.map((p) => {
    const texto = t.ubicacion.puntos[p.clave];
    return {
      tipo: 'punto' as const,
      nombre: texto.nombre,
      detalle: texto.detalle,
      icono: p.icono,
      minutos: p.confirmado && p.minutos !== null ? p.minutos : null,
    };
  }),
  ...DESTACADOS_HOME.map((numero) => {
    const a = ATRACTIVOS.find((x) => x.numero === numero);
    if (!a) throw new Error(`DESTACADOS_HOME apunta al atractivo ${numero}, que no existe`);
    return {
      tipo: 'atractivo' as const,
      nombre: a.nombre,
      detalle: a.descripcion[idioma],
      icono: iconoCategoria[a.categoria],
      categoriaNombre: tA.categorias[a.categoria],
      numero: a.numero,
      // Sin logo publicable, la tarjeta muestra el número del mapa.
      logo: a.sinLogo ? null : logoDeAtractivo(a.numero),
      // Solo los atractivos con sitio verificado (ver `atractivos.ts`)
      // convierten la tarjeta en un enlace.
      sitio: a.sitio ?? null,
    };
  }),
];

// El iframe de Google Maps se carga en el idioma del visitante.
const hlMapa = idioma === 'pt' ? 'pt-BR' : idioma === 'en' ? 'en' : 'es';
const mapaEmbed = `https://www.google.com/maps?q=Camping+Tierra+Roja+y+Parque+Acu%C3%A1tico,${NEGOCIO.geo.lat},${NEGOCIO.geo.lng}&hl=${hlMapa}&z=14&output=embed`;
---

<section id="ubicacion" class="scroll-mt-20 px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <EncabezadoSeccion
      kicker={t.ubicacion.kicker}
      titulo={t.ubicacion.titulo}
      subtitulo={t.ubicacion.subtitulo}
      class="mb-14"
    />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- Distancias y los dos atractivos destacados -->
      <div class="lg:col-span-7">
        <ul
          class="grid grid-cols-1 gap-4 sm:auto-rows-fr sm:grid-cols-2"
          aria-label={tA.listaEtiqueta}
        >
          {
            tarjetas.map((tarjeta) => {
              // La tarjeta es un enlace solo si el atractivo trae sitio propio.
              const enlace = tarjeta.tipo === 'atractivo' ? tarjeta.sitio : null;
              const Contenedor = enlace ? 'a' : 'article';
              return (
              <li>
                <Contenedor
                  class:list={[
                    'group flex h-full gap-4 rounded-card border border-borde bg-superficie p-4',
                    enlace &&
                      'transition-colors hover:border-primario focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40',
                  ]}
                  {...(enlace
                    ? {
                        href: enlace,
                        target: '_blank',
                        rel: 'noopener',
                        'aria-label': interpolar(tA.abreSitio, { nombre: tarjeta.nombre }),
                        'data-evento': EVENTOS.ATRACTIVO,
                        'data-evento-detalle': tarjeta.nombre,
                      }
                    : {})}
                >
                  {tarjeta.tipo === 'punto' ? (
                    <span
                      class="flex h-12 w-16 shrink-0 items-center justify-center rounded-lg border border-borde bg-fondo-alt text-primario"
                      aria-hidden="true"
                    >
                      <span class="material-symbols-outlined">{tarjeta.icono}</span>
                    </span>
                  ) : (
                    <span
                      class:list={[
                        'flex h-12 w-16 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-borde p-1 font-titulo text-base font-bold',
                        tarjeta.logo ? 'bg-white' : 'bg-fondo-alt text-texto-suave',
                      ]}
                      aria-hidden={tarjeta.logo ? undefined : 'true'}
                    >
                      {tarjeta.logo ? (
                        <img
                          src={tarjeta.logo}
                          alt=""
                          width="64"
                          height="48"
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-contain"
                        />
                      ) : (
                        tarjeta.numero
                      )}
                    </span>
                  )}

                  <div class="min-w-0">
                    <p
                      class:list={[
                        'font-titulo font-bold leading-tight text-negro',
                        enlace && 'transition-colors group-hover:text-primario',
                      ]}
                    >
                      {tarjeta.nombre}
                    </p>
                    <p class="mt-1 text-sm leading-snug text-texto-suave">{tarjeta.detalle}</p>

                    {tarjeta.tipo === 'punto' ? (
                      <p
                        class:list={[
                          'mt-2 inline-flex items-center gap-1.5 rounded-pill px-2.5 py-1 font-titulo text-xs font-bold',
                          tarjeta.minutos !== null
                            ? 'bg-primario/8 text-primario'
                            : 'bg-fondo-alt text-texto-suave',
                        ]}
                      >
                        <span class="material-symbols-outlined text-sm" aria-hidden="true">
                          {tarjeta.minutos !== null ? 'schedule' : 'chat'}
                        </span>
                        {tarjeta.minutos !== null
                          ? interpolar(t.ubicacion.minutos, { minutos: tarjeta.minutos })
                          : t.ubicacion.sinConfirmar}
                      </p>
                    ) : (
                      <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-texto-suave">
                        <span class="inline-flex items-center gap-1">
                          <span class="material-symbols-outlined text-sm" aria-hidden="true">
                            {tarjeta.icono}
                          </span>
                          {tarjeta.categoriaNombre}
                        </span>
                        <span>{interpolar(tA.numeroMapa, { numero: tarjeta.numero })}</span>
                        {tarjeta.sitio && (
                          <span class="inline-flex items-center gap-1 font-titulo font-bold text-primario">
                            <span class="material-symbols-outlined text-sm" aria-hidden="true">
                              open_in_new
                            </span>
                            {tA.sitioWeb}
                          </span>
                        )}
                      </p>
                    )}
                  </div>
                </Contenedor>
              </li>
              );
            })
          }
        </ul>

        <!-- Única puerta de entrada a la guía completa de Iguazú -->
        <div class="mt-6 border-t border-borde pt-6">
          <a
            href={RUTAS[idioma].atractivos}
            class="inline-flex min-h-12 items-center gap-2 rounded-pill border-2 border-primario px-6 font-titulo font-bold text-primario transition-colors hover:bg-primario hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40"
          >
            <span class="material-symbols-outlined text-xl" aria-hidden="true">map</span>
            {interpolar(tA.verTodos, { total: ATRACTIVOS.length })}
          </a>
          <p class="mt-3 text-sm leading-relaxed text-texto-suave">{tA.verTodosDetalle}</p>
        </div>
      </div>

      <!-- Mapa + dirección -->
      <div class="lg:col-span-5">
        <div class="overflow-hidden rounded-card border border-borde bg-superficie shadow-suave">
          <div class="aspect-[4/3] w-full bg-fondo-alt">
            <iframe
              class="h-full w-full border-0"
              src={mapaEmbed}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={t.ubicacion.mapaTitulo}></iframe>
          </div>
          <div class="p-6">
            <h3 class="mb-2 font-titulo text-lg font-bold text-negro">
              {t.ubicacion.direccionTitulo}
            </h3>
            <address class="mb-5 not-italic leading-relaxed text-texto-suave">
              {DIRECCION_COMPLETA}
            </address>
            <div class="flex flex-col gap-3">
              <a
                href={NEGOCIO.mapaUrl}
                target="_blank"
                rel="noopener"
                data-evento={EVENTOS.MAPA}
                data-evento-detalle="ubicacion"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-pill border-2 border-primario px-6 font-titulo font-bold text-primario transition-colors hover:bg-primario hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40"
              >
                <span class="material-symbols-outlined text-xl" aria-hidden="true">near_me</span>
                {t.ubicacion.comoLlegar}
              </a>
              <BotonReserva idioma={idioma} texto={t.ubicacion.cta} tamano="md" bloque />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
