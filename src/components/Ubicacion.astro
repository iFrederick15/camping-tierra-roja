---
// "Tu base para descubrir Iguazú".
//
// Vende la ubicación como parte del producto: nadie viaja a Puerto Iguazú
// por el camping, viaja por las Cataratas — y el camping es la base. Es
// también la sección que más peso tiene para el visitante brasileño, que
// llega por Foz do Iguaçu.
//
// La columna izquierda agrupa TODO lo que hay alrededor en una sola lista
// paginada de 8 tarjetas (2 x 4): primero los tiempos de viaje de
// `src/lib/ubicacion.ts` y después las 34 fichas del descriptivo oficial de
// Atractivos Iguazú (ACATI), con el mismo número que llevan en el mapa
// impreso. Son 40 tarjetas justas, 5 páginas de 8. Tierra Roja es la ficha
// 26, así que la guía le resuelve el itinerario al huésped y de paso muestra
// que el camping está en la guía oficial de la ciudad.
//
// Los tiempos de viaje que todavía no están confirmados NO se muestran como
// número: se muestra el destino con un "consultar", nunca una distancia
// inventada.
//
// La paginación es mejora progresiva: el HTML trae las 40 tarjetas y el
// `<noscript>` de abajo las muestra todas y esconde los botones, así sin JS
// no se pierde contenido.
import EncabezadoSeccion from './ui/EncabezadoSeccion.astro';
import BotonReserva from './ui/BotonReserva.astro';
import { PUNTOS_DE_INTERES } from '../lib/ubicacion';
import {
  ATRACTIVOS,
  CATEGORIAS_ATRACTIVOS,
  GUIA_OFICIAL,
  logoDeAtractivo,
} from '../lib/atractivos';
import { NEGOCIO, DIRECCION_COMPLETA } from '../lib/negocio';
import { EVENTOS } from '../lib/analytics';
import { interpolar, type Idioma, type Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;
const tA = t.ubicacion.atractivos;

const POR_PAGINA = 8; // 2 columnas x 4 filas

// El icono de cada categoría se resuelve acá para no buscarlo dentro del map.
const iconoCategoria = Object.fromEntries(
  CATEGORIAS_ATRACTIVOS.map((c) => [c.id, c.icono])
) as Record<string, string>;

// Una sola lista: los tiempos de viaje primero (son el argumento de venta) y
// después el descriptivo completo, en el orden del folleto.
const tarjetas = [
  ...PUNTOS_DE_INTERES.map((p) => {
    const texto = t.ubicacion.puntos[p.clave];
    return {
      tipo: 'punto' as const,
      nombre: texto.nombre,
      detalle: texto.detalle,
      icono: p.icono,
      minutos: p.confirmado && p.minutos !== null ? p.minutos : null,
    };
  }),
  ...ATRACTIVOS.map((a) => ({
    tipo: 'atractivo' as const,
    nombre: a.nombre,
    detalle: a.descripcion[idioma],
    icono: iconoCategoria[a.categoria],
    categoriaNombre: tA.categorias[a.categoria],
    numero: a.numero,
    nuestro: a.nuestro === true,
    // Sin logo publicable, la tarjeta muestra el número del mapa.
    logo: a.sinLogo ? null : logoDeAtractivo(a.numero),
  })),
];

const paginas = Math.ceil(tarjetas.length / POR_PAGINA);

// El iframe de Google Maps se carga en el idioma del visitante.
const hlMapa = idioma === 'pt' ? 'pt-BR' : idioma === 'en' ? 'en' : 'es';
const mapaEmbed = `https://www.google.com/maps?q=Camping+Tierra+Roja+y+Parque+Acu%C3%A1tico,${NEGOCIO.geo.lat},${NEGOCIO.geo.lng}&hl=${hlMapa}&z=14&output=embed`;
---

<section id="ubicacion" class="scroll-mt-20 px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <EncabezadoSeccion
      kicker={t.ubicacion.kicker}
      titulo={t.ubicacion.titulo}
      subtitulo={t.ubicacion.subtitulo}
      class="mb-14"
    />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- Distancias y atractivos, paginados de a 8 -->
      <div class="lg:col-span-7">
        <ul
          id="ubicacion-tarjetas"
          class="grid grid-cols-1 gap-4 sm:auto-rows-fr sm:grid-cols-2"
          aria-label={tA.listaEtiqueta}
        >
          {
            tarjetas.map((tarjeta, i) => (
              <li
                class="tarjeta-ubicacion"
                data-pagina={Math.floor(i / POR_PAGINA)}
                hidden={i >= POR_PAGINA}
              >
                <article
                  class:list={[
                    'flex h-full gap-4 rounded-card border bg-superficie p-4',
                    tarjeta.tipo === 'atractivo' && tarjeta.nuestro
                      ? 'border-primario'
                      : 'border-borde',
                  ]}
                >
                  {tarjeta.tipo === 'punto' ? (
                    <span
                      class="flex h-12 w-16 shrink-0 items-center justify-center rounded-lg border border-borde bg-fondo-alt text-primario"
                      aria-hidden="true"
                    >
                      <span class="material-symbols-outlined">{tarjeta.icono}</span>
                    </span>
                  ) : (
                    <span
                      class:list={[
                        'flex h-12 w-16 shrink-0 items-center justify-center overflow-hidden rounded-lg border p-1 font-titulo text-base font-bold',
                        tarjeta.nuestro ? 'border-primario' : 'border-borde',
                        tarjeta.logo ? 'bg-white' : 'bg-fondo-alt text-texto-suave',
                      ]}
                      aria-hidden={tarjeta.logo ? undefined : 'true'}
                    >
                      {tarjeta.logo ? (
                        <img
                          src={tarjeta.logo}
                          alt=""
                          width="64"
                          height="48"
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-contain"
                        />
                      ) : (
                        tarjeta.numero
                      )}
                    </span>
                  )}

                  <div class="min-w-0">
                    <p class="font-titulo font-bold leading-tight text-negro">
                      {tarjeta.nombre}
                      {tarjeta.tipo === 'atractivo' && tarjeta.nuestro && (
                        <span class="ml-2 inline-block rounded-pill bg-primario px-2 py-0.5 align-middle text-[11px] font-bold uppercase tracking-wide text-white">
                          {tA.aqui}
                        </span>
                      )}
                    </p>
                    <p class="mt-1 text-sm leading-snug text-texto-suave">{tarjeta.detalle}</p>

                    {tarjeta.tipo === 'punto' ? (
                      <p
                        class:list={[
                          'mt-2 inline-flex items-center gap-1.5 rounded-pill px-2.5 py-1 font-titulo text-xs font-bold',
                          tarjeta.minutos !== null
                            ? 'bg-primario/8 text-primario'
                            : 'bg-fondo-alt text-texto-suave',
                        ]}
                      >
                        <span class="material-symbols-outlined text-sm" aria-hidden="true">
                          {tarjeta.minutos !== null ? 'schedule' : 'chat'}
                        </span>
                        {tarjeta.minutos !== null
                          ? interpolar(t.ubicacion.minutos, { minutos: tarjeta.minutos })
                          : t.ubicacion.sinConfirmar}
                      </p>
                    ) : (
                      <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-texto-suave">
                        <span class="inline-flex items-center gap-1">
                          <span class="material-symbols-outlined text-sm" aria-hidden="true">
                            {tarjeta.icono}
                          </span>
                          {tarjeta.categoriaNombre}
                        </span>
                        <span>{interpolar(tA.numeroMapa, { numero: tarjeta.numero })}</span>
                      </p>
                    )}
                  </div>
                </article>
              </li>
            ))
          }
        </ul>

        <div id="ubicacion-paginacion" class="mt-5 flex flex-wrap items-center gap-3">
          <button
            type="button"
            id="ubicacion-anterior"
            disabled
            class="inline-flex min-h-11 items-center gap-1.5 rounded-pill border border-borde bg-superficie px-4 font-titulo text-sm font-bold text-texto-suave transition-colors hover:border-primario hover:text-primario focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40 disabled:pointer-events-none disabled:opacity-40"
          >
            <span class="material-symbols-outlined text-lg" aria-hidden="true">chevron_left</span>
            {tA.verAnterior}
          </button>
          <button
            type="button"
            id="ubicacion-siguiente"
            class="inline-flex min-h-11 items-center gap-1.5 rounded-pill border-2 border-primario px-4 font-titulo text-sm font-bold text-primario transition-colors hover:bg-primario hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40 disabled:pointer-events-none disabled:opacity-40"
          >
            {tA.verMas}
            <span class="material-symbols-outlined text-lg" aria-hidden="true">chevron_right</span>
          </button>
          <p
            id="ubicacion-pagina"
            class="font-titulo text-sm text-texto-suave"
            role="status"
            aria-live="polite"
          >
            {interpolar(tA.pagina, { n: 1, total: paginas })}
          </p>
        </div>

        <div class="mt-6 border-t border-borde pt-5">
          <a
            href={GUIA_OFICIAL}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 font-titulo font-bold text-primario underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40"
          >
            <span class="material-symbols-outlined text-xl" aria-hidden="true">map</span>
            {tA.verGuia}
          </a>
          <p class="mt-2 text-xs leading-relaxed text-texto-suave">
            {interpolar(tA.fuente, { total: ATRACTIVOS.length })}
          </p>
        </div>
      </div>

      <!-- Mapa + dirección -->
      <div class="lg:col-span-5">
        <div class="overflow-hidden rounded-card border border-borde bg-superficie shadow-suave">
          <div class="aspect-[4/3] w-full bg-fondo-alt">
            <iframe
              class="h-full w-full border-0"
              src={mapaEmbed}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={t.ubicacion.mapaTitulo}></iframe>
          </div>
          <div class="p-6">
            <h3 class="mb-2 font-titulo text-lg font-bold text-negro">
              {t.ubicacion.direccionTitulo}
            </h3>
            <address class="mb-5 not-italic leading-relaxed text-texto-suave">
              {DIRECCION_COMPLETA}
            </address>
            <div class="flex flex-col gap-3">
              <a
                href={NEGOCIO.mapaUrl}
                target="_blank"
                rel="noopener"
                data-evento={EVENTOS.MAPA}
                data-evento-detalle="ubicacion"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-pill border-2 border-primario px-6 font-titulo font-bold text-primario transition-colors hover:bg-primario hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40"
              >
                <span class="material-symbols-outlined text-xl" aria-hidden="true">near_me</span>
                {t.ubicacion.comoLlegar}
              </a>
              <BotonReserva idioma={idioma} texto={t.ubicacion.cta} tamano="md" bloque />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<noscript>
  <style>
    /* Sin JS no hay paginación: se ven las 40 tarjetas y sobran los botones. */
    .tarjeta-ubicacion[hidden] {
      display: block !important;
    }
    #ubicacion-paginacion {
      display: none;
    }
  </style>
</noscript>

<script is:inline define:vars={{ textoPagina: tA.pagina }}>
  (function () {
    const lista = document.getElementById('ubicacion-tarjetas');
    const anterior = document.getElementById('ubicacion-anterior');
    const siguiente = document.getElementById('ubicacion-siguiente');
    const estado = document.getElementById('ubicacion-pagina');
    if (!lista || !anterior || !siguiente) return;

    const items = Array.from(lista.querySelectorAll('.tarjeta-ubicacion'));
    const paginas = Math.max(...items.map((el) => +el.dataset.pagina)) + 1;
    let actual = 0;

    function mostrar(pagina, mover) {
      actual = Math.min(Math.max(pagina, 0), paginas - 1);
      items.forEach((el) => {
        el.hidden = +el.dataset.pagina !== actual;
      });
      anterior.disabled = actual === 0;
      siguiente.disabled = actual === paginas - 1;
      if (estado)
        estado.textContent = textoPagina
          .replace('{n}', String(actual + 1))
          .replace('{total}', String(paginas));
      // Si la lista quedó por encima de la ventana, volver a su inicio.
      if (mover && lista.getBoundingClientRect().top < 0) {
        lista.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    }

    anterior.addEventListener('click', () => mostrar(actual - 1, true));
    siguiente.addEventListener('click', () => mostrar(actual + 1, true));
    mostrar(0, false);
  })();
</script>
