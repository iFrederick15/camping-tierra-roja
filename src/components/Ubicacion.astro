---
// "Tu base para descubrir Iguazú".
//
// Vende la ubicación como parte del producto: nadie viaja a Puerto Iguazú
// por el camping, viaja por las Cataratas — y el camping es la base. Es
// también la sección que más peso tiene para el visitante brasileño, que
// llega por Foz do Iguaçu.
//
// La columna izquierda muestra los seis tiempos de viaje de
// `src/lib/ubicacion.ts` como lista y, debajo, los dos atractivos de
// `DESTACADOS_HOME` (La Aripuca y el Duty Free) como tarjetas. El descriptivo completo de la ACATI —34
// fichas— vive en la página `/atractivos`, a la que se llega solo desde el
// botón de abajo: en la home ocupaba cinco páginas de tarjetas y tapaba el
// resto de la sección.
//
// Los tiempos de viaje que todavía no están confirmados NO se muestran como
// número: se muestra el destino con un "consultar", nunca una distancia
// inventada.
import EncabezadoSeccion from './ui/EncabezadoSeccion.astro';
import BotonReserva from './ui/BotonReserva.astro';
import { PUNTOS_DE_INTERES } from '../lib/ubicacion';
import {
  ATRACTIVOS,
  CATEGORIAS_ATRACTIVOS,
  DESTACADOS_HOME,
  logoDeAtractivo,
} from '../lib/atractivos';
import { NEGOCIO, DIRECCION_COMPLETA } from '../lib/negocio';
import { EVENTOS } from '../lib/analytics';
import { interpolar, RUTAS, type Idioma, type Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;
const tA = t.ubicacion.atractivos;

// El icono de cada categoría se resuelve acá para no buscarlo dentro del map.
const iconoCategoria = Object.fromEntries(
  CATEGORIAS_ATRACTIVOS.map((c) => [c.id, c.icono])
) as Record<string, string>;

// Tiempos de viaje: una lista compacta y comparable. El número va a la derecha
// y en grande porque es lo que el visitante compara de un vistazo; como
// tarjetas sueltas quedaban seis cajas altas con el dato escondido en una
// píldora.
const distancias = PUNTOS_DE_INTERES.map((p) => {
  const texto = t.ubicacion.puntos[p.clave];
  return {
    nombre: texto.nombre,
    detalle: texto.detalle,
    icono: p.icono,
    minutos: p.confirmado && p.minutos !== null ? p.minutos : null,
  };
});

// "{minutos} min en auto" se parte alrededor del número para mostrarlo grande
// y la unidad debajo, sin duplicar el texto en los diccionarios.
const unidadMinutos = t.ubicacion.minutos.replace('{minutos}', '').trim();

// Los dos atractivos destacados, en el orden en que los lista `DESTACADOS_HOME`.
const destacados = DESTACADOS_HOME.map((numero) => {
  const a = ATRACTIVOS.find((x) => x.numero === numero);
  if (!a) throw new Error(`DESTACADOS_HOME apunta al atractivo ${numero}, que no existe`);
  return {
    nombre: a.nombre,
    detalle: a.descripcion[idioma],
    icono: iconoCategoria[a.categoria],
    categoriaNombre: tA.categorias[a.categoria],
    numero: a.numero,
    // Sin logo publicable, la tarjeta muestra el número del mapa.
    logo: a.sinLogo ? null : logoDeAtractivo(a.numero),
    // Solo los atractivos con sitio verificado (ver `atractivos.ts`)
    // convierten la tarjeta en un enlace.
    sitio: a.sitio ?? null,
  };
});

// El iframe de Google Maps se carga en el idioma del visitante.
const hlMapa = idioma === 'pt' ? 'pt-BR' : idioma === 'en' ? 'en' : 'es';
const mapaEmbed = `https://www.google.com/maps?q=Camping+Tierra+Roja+y+Parque+Acu%C3%A1tico,${NEGOCIO.geo.lat},${NEGOCIO.geo.lng}&hl=${hlMapa}&z=14&output=embed`;
---

<section id="ubicacion" class="scroll-mt-20 px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <EncabezadoSeccion
      kicker={t.ubicacion.kicker}
      titulo={t.ubicacion.titulo}
      subtitulo={t.ubicacion.subtitulo}
      class="mb-14"
    />

    <!-- Orden del DOM = orden en mobile y de tabulación: tiempos → mapa →
         atractivos. En desktop el mapa pasa a la derecha ocupando las dos filas
         y queda fijo mientras se recorre la columna izquierda. -->
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-x-10 lg:gap-y-12">
      <!-- Tiempos de viaje -->
      <ul
        class="divide-y divide-borde overflow-hidden rounded-card border border-borde bg-superficie lg:col-span-7"
        aria-label={tA.listaDistancias}
      >
        {
          distancias.map((d) => (
            <li class="flex items-center gap-3 px-4 py-4 sm:gap-4 sm:px-6">
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-campo bg-fondo-alt text-primario sm:h-10 sm:w-10"
                aria-hidden="true"
              >
                <span class="material-symbols-outlined text-[1.375rem]">{d.icono}</span>
              </span>

              <div class="min-w-0 flex-1">
                <p class="font-titulo font-bold leading-tight text-negro">{d.nombre}</p>
                <p class="mt-0.5 text-sm leading-snug text-texto-suave">{d.detalle}</p>
              </div>

              {d.minutos !== null ? (
                <p class="w-16 shrink-0 text-right sm:w-auto">
                  <span class="block font-titulo text-2xl font-bold leading-none tabular-nums text-negro sm:text-3xl">
                    {d.minutos}
                  </span>
                  <span class="mt-1 block text-xs leading-tight text-texto-suave sm:whitespace-nowrap">
                    {unidadMinutos}
                  </span>
                </p>
              ) : (
                <p class="w-24 shrink-0 text-right text-xs leading-snug text-texto-suave sm:w-32">
                  {t.ubicacion.sinConfirmar}
                </p>
              )}
            </li>
          ))
        }
      </ul>

      <!-- Mapa + dirección -->
      <div class="lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1">
        <div
          class="overflow-hidden rounded-card border border-borde bg-superficie shadow-suave lg:sticky lg:top-24"
        >
          <div class="aspect-4/3 w-full bg-fondo-alt sm:aspect-video lg:aspect-4/3">
            <iframe
              class="h-full w-full border-0"
              src={mapaEmbed}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={t.ubicacion.mapaTitulo}></iframe>
          </div>
          <div class="p-5 sm:p-7">
            <h3 class="font-titulo text-lg font-bold text-negro">
              {t.ubicacion.direccionTitulo}
            </h3>
            <address class="mt-2 flex gap-2 not-italic leading-relaxed text-texto">
              <span
                class="material-symbols-outlined mt-0.5 text-xl text-primario"
                aria-hidden="true">location_on</span
              >
              <a
                href={NEGOCIO.mapaUrl}
                target="_blank"
                rel="noopener"
                data-evento={EVENTOS.MAPA}
                data-evento-detalle="ubicacion-direccion"
                class="transition-colors hover:text-primario"
                >{DIRECCION_COMPLETA}</a
              >
            </address>
            <div class="mt-6 flex flex-col gap-3">
              <a
                href={NEGOCIO.mapaUrl}
                target="_blank"
                rel="noopener"
                data-evento={EVENTOS.MAPA}
                data-evento-detalle="ubicacion"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-pill border-2 border-primario px-6 font-titulo font-bold text-primario transition-colors hover:bg-primario hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40 focus-visible:ring-offset-2"
              >
                <span class="material-symbols-outlined text-xl" aria-hidden="true">near_me</span>
                {t.ubicacion.comoLlegar}
              </a>
              <BotonReserva
                idioma={idioma}
                texto={t.ubicacion.cta}
                tamano="md"
                bloque
                class="text-center"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Atractivos destacados + única puerta a la guía completa -->
      <div class="lg:col-span-7 lg:row-start-2">
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label={tA.listaDestacados}>
          {
            destacados.map((a) => {
              const Contenedor = a.sitio ? 'a' : 'article';
              return (
                <li>
                  <Contenedor
                    class:list={[
                      'group flex h-full flex-col gap-4 rounded-card border border-borde bg-superficie p-5',
                      a.sitio &&
                        'transition-colors hover:border-primario focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40 focus-visible:ring-offset-2',
                    ]}
                    {...(a.sitio
                      ? {
                          href: a.sitio,
                          target: '_blank',
                          rel: 'noopener',
                          'aria-label': interpolar(tA.abreSitio, { nombre: a.nombre }),
                          'data-evento': EVENTOS.ATRACTIVO,
                          'data-evento-detalle': a.nombre,
                        }
                      : {})}
                  >
                    <div class="flex items-center gap-4">
                      <span
                        class:list={[
                          'flex h-12 w-16 shrink-0 items-center justify-center overflow-hidden rounded-campo border border-borde p-1 font-titulo text-base font-bold',
                          a.logo ? 'bg-white' : 'bg-fondo-alt text-texto-suave',
                        ]}
                        aria-hidden={a.logo ? undefined : 'true'}
                      >
                        {a.logo ? (
                          <img
                            src={a.logo}
                            alt=""
                            width="64"
                            height="48"
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-contain"
                          />
                        ) : (
                          a.numero
                        )}
                      </span>
                      <p
                        class:list={[
                          'min-w-0 font-titulo font-bold leading-tight text-negro',
                          a.sitio && 'transition-colors group-hover:text-primario',
                        ]}
                      >
                        {a.nombre}
                      </p>
                    </div>

                    <p class="text-sm leading-snug text-texto-suave">{a.detalle}</p>

                    <p class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-texto-suave">
                      <span class="inline-flex items-center gap-1">
                        <span class="material-symbols-outlined text-base" aria-hidden="true">
                          {a.icono}
                        </span>
                        {a.categoriaNombre}
                      </span>
                      <span>{interpolar(tA.numeroMapa, { numero: a.numero })}</span>
                      {a.sitio && (
                        <span class="ml-auto inline-flex items-center gap-1 font-titulo font-bold text-primario">
                          {tA.sitioWeb}
                          <span class="material-symbols-outlined text-base" aria-hidden="true">
                            open_in_new
                          </span>
                        </span>
                      )}
                    </p>
                  </Contenedor>
                </li>
              );
            })
          }
        </ul>

        <div class="mt-6 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-6">
          <a
            href={RUTAS[idioma].atractivos}
            class="inline-flex min-h-12 shrink-0 items-center gap-2 rounded-pill border-2 border-primario px-6 font-titulo font-bold text-primario transition-colors hover:bg-primario hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40 focus-visible:ring-offset-2"
          >
            <span class="material-symbols-outlined text-xl" aria-hidden="true">map</span>
            {interpolar(tA.verTodos, { total: ATRACTIVOS.length })}
          </a>
          <p class="text-pretty text-sm leading-relaxed text-texto-suave">{tA.verTodosDetalle}</p>
        </div>
      </div>
    </div>
  </div>
</section>
