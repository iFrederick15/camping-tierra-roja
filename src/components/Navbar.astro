---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Piscinas', href: '/#piscinas' },
  { label: 'Camping', href: '/#camping' },
  { label: 'Cabañas', href: '/#cabanas' },
  { label: 'Reservar', href: '/reservar' },
  { label: 'Galería', href: '/galeria' },
  { label: 'Contacto', href: '/contacto' },
].map((link) => ({
  ...link,
  active: link.href === currentPath,
}));
---

<nav id="navbar" class="top-0 w-full z-50 bg-white">
  <div class="flex justify-between items-center w-full px-6 lg:px-8 py-4 max-w-7xl mx-auto">
    <!-- Logo -->
    <a href="/" class="shrink-0">
      <img
        src="/images/Logo-Tierra-Roja.png"
        alt="Logo de camping Tierra Roja"
        class="h-14 w-auto sm:h-16 lg:h-20"
      />
    </a>

    <!-- Desktop Nav -->
    <div class="hidden lg:flex gap-8 items-center">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'font-titulo font-medium text-sm tracking-wide transition-colors duration-200',
              link.active
                ? 'text-primario border-b-2 border-primario pb-0.5'
                : 'text-texto-suave hover:text-primario',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- CTA -->
    <a
      href="/reservar"
      class="hidden lg:inline-flex bg-gradient-to-r from-primario to-acento text-white px-7 py-2.5 rounded-pill font-titulo font-bold text-sm tracking-wide hover:shadow-lg hover:scale-105 transition-all duration-200 active:scale-95"
    >
      Reservar
    </a>

    <!-- Mobile menu button -->
    <button id="menu-toggle" class="lg:hidden flex flex-col gap-1.5 p-2" aria-label="Abrir menú">
      <span class="w-6 h-0.5 bg-negro rounded-full transition-all duration-300" id="bar1"></span>
      <span class="w-6 h-0.5 bg-negro rounded-full transition-all duration-300" id="bar2"></span>
      <span class="w-4 h-0.5 bg-negro rounded-full transition-all duration-300" id="bar3"></span>
    </button>

    <!-- Mobile Menu overlay -->
    <div
      id="mobile-menu-overlay"
      class="lg:hidden fixed inset-0 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out z-40"
    ></div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="lg:hidden fixed top-0 right-0 h-full w-72 max-w-[80%] translate-x-full overflow-y-auto transition-transform duration-300 ease-in-out bg-superficie/95 backdrop-blur-xl z-50 shadow-xl"
    >
      <button id="menu-close" class="absolute top-4 right-4 p-2 text-negro" aria-label="Cerrar menú">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <div class="px-6 py-6 flex flex-col gap-4 mt-16">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'font-titulo font-medium text-lg py-2 transition-colors',
                link.active ? 'text-primario' : 'text-texto hover:text-primario',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="/reservar"
          class="mt-2 bg-gradient-to-r from-primario to-acento text-white px-7 py-3 rounded-pill font-titulo font-bold text-center"
        >
          Reservar
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    // Navbar scroll effect
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 60) {
        navbar.classList.add('bg-superficie/90', 'backdrop-blur-xl', 'shadow-sm');
      } else {
        navbar.classList.remove('bg-superficie/90', 'backdrop-blur-xl', 'shadow-sm');
      }
    });

    // Mobile menu toggle
    const toggle = document.getElementById('menu-toggle');
    const closeBtn = document.getElementById('menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
    let menuOpen = false;

    function setMenuOpen(open) {
      menuOpen = open;
      if (menuOpen) {
        mobileMenu.classList.remove('translate-x-full');
        mobileMenuOverlay.classList.remove('opacity-0', 'pointer-events-none');
      } else {
        mobileMenu.classList.add('translate-x-full');
        mobileMenuOverlay.classList.add('opacity-0', 'pointer-events-none');
      }
    }

    toggle.addEventListener('click', () => setMenuOpen(!menuOpen));
    closeBtn.addEventListener('click', () => setMenuOpen(false));
    mobileMenuOverlay.addEventListener('click', () => setMenuOpen(false));
  </script>
</nav>
