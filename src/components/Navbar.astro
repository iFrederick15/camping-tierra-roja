---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Piscinas', href: '/#piscinas' },
  { label: 'Camping', href: '/#camping' },
  { label: 'Cabañas', href: '/#cabanas' },
  { label: 'Reservas', href: '/reservas' },
  { label: 'Galería', href: '/galeria' },
  { label: 'Contacto', href: '/contacto' },
].map((link) => ({
  ...link,
  active: link.href === currentPath,
}));
---

<nav id="navbar" class="top-0 w-full z-50 bg-white">
  <div class="flex justify-between items-center w-full px-6 lg:px-8 py-4 max-w-7xl mx-auto">
    <!-- Logo -->
    <a href="/">
      <img
        src="/images/Logo-Tierra-Roja.png"
        alt="Logo de camping Tierra Roja"
        class="h-20 w-auto"
      />
      <a></a>
      <!-- Desktop Nav -->
      <div class="hidden lg:flex gap-8 items-center">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'font-titulo font-medium text-sm tracking-wide transition-colors duration-200',
                link.active
                  ? 'text-primario border-b-2 border-primario pb-0.5'
                  : 'text-texto-suave hover:text-primario',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- CTA -->
      <a
        href="#reservar"
        class="hidden lg:inline-flex bg-gradient-to-r from-primario to-acento text-white px-7 py-2.5 rounded-pill font-titulo font-bold text-sm tracking-wide hover:shadow-lg hover:scale-105 transition-all duration-200 active:scale-95"
      >
        Reservar
      </a>

      <!-- Mobile menu button -->
      <button id="menu-toggle" class="lg:hidden flex flex-col gap-1.5 p-2" aria-label="Abrir menú">
        <span class="w-6 h-0.5 bg-negro rounded-full transition-all duration-300" id="bar1"></span>
        <span class="w-6 h-0.5 bg-negro rounded-full transition-all duration-300" id="bar2"></span>
        <span class="w-4 h-0.5 bg-negro rounded-full transition-all duration-300" id="bar3"></span>
      </button>
    </a>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="lg:hidden max-h-0 overflow-hidden transition-all duration-500 ease-in-out bg-superficie/95 backdrop-blur-xl"
    >
      <div class="px-6 py-6 flex flex-col gap-4">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'font-titulo font-medium text-lg py-2 transition-colors',
                link.active ? 'text-primario' : 'text-texto hover:text-primario',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="#reservas"
          class="mt-2 bg-gradient-to-r from-primario to-acento text-white px-7 py-3 rounded-pill font-titulo font-bold text-center"
        >
          Reservar
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    // Navbar scroll effect
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 60) {
        navbar.classList.add('bg-superficie/90', 'backdrop-blur-xl', 'shadow-sm');
      } else {
        navbar.classList.remove('bg-superficie/90', 'backdrop-blur-xl', 'shadow-sm');
      }
    });

    // Mobile menu toggle
    const toggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    let menuOpen = false;

    toggle.addEventListener('click', () => {
      menuOpen = !menuOpen;
      if (menuOpen) {
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
      } else {
        mobileMenu.style.maxHeight = '0';
      }
    });
  </script>
</nav>
