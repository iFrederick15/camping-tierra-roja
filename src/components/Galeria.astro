---
// Galería de fotos.
//
// Mejoras sobre la versión anterior:
//   • el filtro "General" nunca funcionaba: el botón tenía id 'General' y las
//     fotos la categoría 'general' — nunca coincidían. Ahora las categorías
//     salen de una sola fuente (`src/lib/galeria.ts`),
//   • las fotos de motorhome tienen su propia categoría (antes estaban dentro
//     de "camping" y no se podían filtrar),
//   • el `alt` de cada foto está traducido,
//   • el visor a pantalla completa devuelve el foco al botón que lo abrió y
//     atrapa el foco mientras está abierto (WCAG 2.4.3 / 2.1.2),
//   • se anuncia el resultado del filtro a los lectores de pantalla.
import BotonReserva from './ui/BotonReserva.astro';
import { CATEGORIAS, FOTOS } from '../lib/galeria';
import { interpolar, type Idioma, type Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;

const fotos = FOTOS.map((foto, i) => ({ ...foto, titulo: t.galeria.fotos[i] ?? '' }));
const categorias = CATEGORIAS.map((c) => ({ id: c.id, label: t.galeria.categorias[c.id] }));
---

<section class="mx-auto mb-12 max-w-7xl px-6 text-center md:text-left">
  <h1
    class="mb-5 font-titulo text-4xl font-extrabold leading-tight tracking-tight text-texto sm:text-5xl md:text-6xl"
  >
    {t.galeria.titulo}
    <span class="text-primario">{t.galeria.tituloDestacado}</span>
  </h1>
  <p class="mx-auto max-w-2xl text-lg leading-relaxed text-texto-suave md:mx-0">
    {t.galeria.subtitulo}
  </p>
</section>

<!-- Filtros -->
<section class="mx-auto mb-10 max-w-7xl px-6">
  <div
    class="flex flex-wrap justify-center gap-2.5 md:justify-start"
    id="galeria-filtros"
    role="group"
    aria-label={t.galeria.filtrarPor}
  >
    {
      categorias.map((cat, i) => (
        <button
          type="button"
          data-categoria={cat.id}
          class:list={[
            'filtro-btn min-h-11 rounded-pill px-5 font-titulo text-sm font-bold transition-all duration-200',
            'focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40',
            i === 0
              ? 'bg-primario text-white shadow-suave'
              : 'bg-fondo-alt text-texto-suave hover:bg-primario/10 hover:text-primario',
          ]}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {cat.label}
        </button>
      ))
    }
  </div>
  <p id="galeria-estado" class="sr-only" role="status" aria-live="polite"></p>
</section>

<!-- Mosaico -->
<section class="mx-auto mb-20 max-w-7xl px-6">
  <div class="columns-2 gap-4 md:columns-3 lg:columns-4" id="galeria-grid">
    {
      fotos.map((foto, i) => (
        <button
          type="button"
          class="galeria-item group relative mb-4 block w-full break-inside-avoid overflow-hidden rounded-card shadow-suave transition-shadow duration-300 hover:shadow-elevada focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/50"
          data-categoria={foto.categoria}
          data-index={i}
          aria-label={interpolar(t.galeria.ampliar, { titulo: foto.titulo })}
        >
          <img
            src={foto.imagen}
            alt={foto.titulo}
            width={foto.ancho}
            height={foto.alto}
            loading={i < 4 ? 'eager' : 'lazy'}
            decoding="async"
            class:list={[
              'w-full object-cover transition-transform duration-700 group-hover:scale-105',
              foto.alta ? 'aspect-[3/4]' : 'aspect-square',
            ]}
          />
          <span class="absolute inset-0 flex items-end bg-gradient-to-t from-black/70 via-black/0 to-transparent p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
            <span class="text-left font-titulo text-sm font-bold text-white">{foto.titulo}</span>
          </span>
          <span
            class="material-symbols-outlined absolute right-3 top-3 rounded-full bg-black/40 p-1.5 text-base text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
            aria-hidden="true"
          >
            zoom_in
          </span>
        </button>
      ))
    }
  </div>
  <p id="galeria-vacio" hidden class="py-16 text-center text-texto-suave">
    {t.galeria.sinResultados}
  </p>
</section>

<!-- Visor a pantalla completa -->
<div
  id="lightbox"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label={t.galeria.tituloDestacado}
  class="fixed inset-0 z-100 items-center justify-center bg-black/92 px-4 backdrop-blur-sm"
>
  <button
    id="lightbox-cerrar"
    type="button"
    aria-label={t.galeria.cerrar}
    class="absolute right-4 top-4 flex h-12 w-12 items-center justify-center rounded-full text-white/80 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-white/60 md:right-8 md:top-8"
  >
    <span class="material-symbols-outlined text-4xl" aria-hidden="true">close</span>
  </button>
  <button
    id="lightbox-prev"
    type="button"
    aria-label={t.galeria.fotoAnterior}
    class="absolute left-2 top-1/2 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full text-white/70 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-white/60 md:left-8"
  >
    <span class="material-symbols-outlined text-4xl md:text-5xl" aria-hidden="true"
      >chevron_left</span
    >
  </button>
  <button
    id="lightbox-next"
    type="button"
    aria-label={t.galeria.fotoSiguiente}
    class="absolute right-2 top-1/2 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full text-white/70 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-white/60 md:right-8"
  >
    <span class="material-symbols-outlined text-4xl md:text-5xl" aria-hidden="true"
      >chevron_right</span
    >
  </button>
  <figure class="flex max-h-[85vh] max-w-4xl flex-col items-center gap-4">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[75vh] max-w-full rounded-lg object-contain shadow-hero"
    />
    <figcaption class="text-center font-titulo text-sm text-white/85">
      <span id="lightbox-caption"></span>
      <span id="lightbox-contador" class="mt-1 block text-xs text-white/60"></span>
    </figcaption>
  </figure>
</div>

<!-- CTA -->
<section class="mx-auto mb-24 max-w-7xl px-6">
  <div class="relative overflow-hidden rounded-card bg-primario px-8 py-14 text-center md:py-16">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_80%,_white_1px,_transparent_1px)] bg-[length:40px_40px] opacity-5"
    >
    </div>
    <div class="relative z-10">
      <h2 class="mb-4 font-titulo text-3xl font-bold text-white md:text-4xl">
        {t.galeria.ctaTitulo}
      </h2>
      <p class="mx-auto mb-8 max-w-xl text-white/85">{t.galeria.ctaTexto}</p>
      <div class="flex justify-center">
        <BotonReserva idioma={idioma} texto={t.galeria.ctaBoton} variante="claro" tamano="lg" />
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ textoContador: t.galeria.contador }}>
  (function () {
    const filtros = Array.from(document.querySelectorAll('#galeria-filtros .filtro-btn'));
    const items = Array.from(document.querySelectorAll('.galeria-item'));
    const vacio = document.getElementById('galeria-vacio');
    const estado = document.getElementById('galeria-estado');

    const visibles = () => items.filter((el) => !el.hidden);

    filtros.forEach((btn) => {
      btn.addEventListener('click', () => {
        const categoria = btn.dataset.categoria;

        filtros.forEach((b) => {
          const activo = b === btn;
          b.classList.toggle('bg-primario', activo);
          b.classList.toggle('text-white', activo);
          b.classList.toggle('shadow-suave', activo);
          b.classList.toggle('bg-fondo-alt', !activo);
          b.classList.toggle('text-texto-suave', !activo);
          b.setAttribute('aria-pressed', String(activo));
        });

        items.forEach((el) => {
          el.hidden = !(categoria === 'todas' || el.dataset.categoria === categoria);
        });

        const cantidad = visibles().length;
        if (vacio) vacio.hidden = cantidad > 0;
        // Anuncia el resultado del filtro a lectores de pantalla, que no ven
        // que el mosaico cambió.
        if (estado) estado.textContent = `${btn.textContent.trim()}: ${cantidad}`;
      });
    });

    // ── Visor a pantalla completa ──
    const lightbox = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img');
    const caption = document.getElementById('lightbox-caption');
    const contador = document.getElementById('lightbox-contador');
    const btnCerrar = document.getElementById('lightbox-cerrar');
    const btnPrev = document.getElementById('lightbox-prev');
    const btnNext = document.getElementById('lightbox-next');
    if (!lightbox || !img || !caption || !contador) return;

    let indice = 0;
    let disparador = null;

    function pintar() {
      const lista = visibles();
      if (!lista.length) return;
      const foto = lista[indice].querySelector('img');
      img.src = foto.src;
      img.alt = foto.alt;
      caption.textContent = foto.alt;
      contador.textContent = textoContador
        .replace('{actual}', String(indice + 1))
        .replace('{total}', String(lista.length));
    }

    function abrir(i, origen) {
      indice = i;
      disparador = origen;
      pintar();
      lightbox.hidden = false;
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
      btnCerrar.focus();
    }

    function cerrar() {
      lightbox.hidden = true;
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
      // Devolver el foco a la miniatura desde la que se abrió el visor.
      if (disparador) disparador.focus();
    }

    function mover(delta) {
      const lista = visibles();
      if (!lista.length) return;
      indice = (indice + delta + lista.length) % lista.length;
      pintar();
    }

    items.forEach((item) => {
      item.addEventListener('click', () => {
        const i = visibles().indexOf(item);
        abrir(i === -1 ? 0 : i, item);
      });
    });

    btnCerrar.addEventListener('click', cerrar);
    btnPrev.addEventListener('click', () => mover(-1));
    btnNext.addEventListener('click', () => mover(1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) cerrar();
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') cerrar();
      else if (e.key === 'ArrowLeft') mover(-1);
      else if (e.key === 'ArrowRight') mover(1);
      else if (e.key === 'Tab') {
        // Trampa de foco: mientras el visor está abierto, Tab no debe salirse
        // hacia la página de atrás.
        const focos = [btnCerrar, btnPrev, btnNext];
        const actual = focos.indexOf(document.activeElement);
        e.preventDefault();
        const siguiente = e.shiftKey ? actual - 1 : actual + 1;
        focos[(siguiente + focos.length) % focos.length].focus();
      }
    });
  })();
</script>
