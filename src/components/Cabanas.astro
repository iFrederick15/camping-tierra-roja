---
// Cabaña.
//
// Corrección de accesibilidad: los textos secundarios sobre el rojo de marca
// estaban en `text-white/50` (≈2.4:1 de contraste, muy por debajo del 4.5:1
// que exige WCAG AA). Pasan a `/80` y `/85`.
import BotonReserva from './ui/BotonReserva.astro';
import type { Idioma, Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;

const iconos = ['bed', 'ac_unit', 'wifi', 'live_tv', 'pool', 'outdoor_grill'];
const amenities = t.cabana.amenities.map((texto, i) => ({ texto, icono: iconos[i] }));
---

<section id="cabanas" class="relative scroll-mt-20 overflow-hidden bg-primario px-6 py-20 lg:py-28">
  <!-- Textura de fondo sutil -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_80%,_white_1px,_transparent_1px)] bg-[length:40px_40px] opacity-5"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="mb-14 text-center">
      <p
        class="mb-3 font-titulo text-xs font-bold uppercase tracking-[0.14em] text-white/85 sm:text-sm"
      >
        {t.cabana.kicker}
      </p>
      <h2 class="mb-4 font-titulo text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        {t.cabana.titulo}
      </h2>
      <p class="font-titulo text-lg italic text-white/80">{t.cabana.cita}</p>
    </div>

    <div class="mx-auto max-w-5xl">
      <article
        class="grid grid-cols-1 overflow-hidden rounded-card bg-fondo-oscuro shadow-hero lg:grid-cols-5"
      >
        <div class="relative min-h-72 overflow-hidden lg:col-span-3 lg:min-h-0">
          <img
            src="/images/cabanhas/cabanha.webp"
            alt="Cabaña para 8 personas con quincho y parrilla propios en Camping Tierra Roja, Puerto Iguazú"
            width="1600"
            height="721"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="flex flex-col justify-between gap-8 p-8 lg:col-span-2 lg:p-10">
          <div>
            <h3 class="mb-1 font-titulo text-3xl font-bold italic text-white lg:text-4xl">
              {t.cabana.nombre}
            </h3>
            <p class="mb-7 font-titulo text-sm text-white/80">{t.cabana.capacidad}</p>

            <div class="mb-7 h-px w-12 bg-white/30"></div>

            <ul class="space-y-3.5">
              {
                amenities.map((a) => (
                  <li class="flex items-center gap-3 text-sm text-white/85">
                    <span
                      class="material-symbols-outlined text-base text-white/60"
                      aria-hidden="true"
                    >
                      {a.icono}
                    </span>
                    {a.texto}
                  </li>
                ))
              }
            </ul>
          </div>

          <BotonReserva
            idioma={idioma}
            texto={t.cabana.cta}
            unidad="CABANA"
            variante="claro"
            tamano="md"
            bloque
          />
        </div>
      </article>
    </div>
  </div>
</section>
