---
// Cierre de la landing.
//
// Último paso del embudo: el visitante ya vio el lugar, los precios, la
// ubicación, las reseñas y las respuestas a sus dudas. Acá se le repite la
// acción principal y se le quitan las últimas fricciones ("sin registro",
// "confirmación inmediata"), además de los tres atajos por tipo de
// alojamiento para quien ya decidió.
import AtajosAlojamiento from './ui/AtajosAlojamiento.astro';
import BotonReserva from './ui/BotonReserva.astro';
import BotonWhatsApp from './ui/BotonWhatsApp.astro';
import type { Idioma, Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;
---

<section class="px-6 py-20 lg:py-28">
  <!-- Sin los dos halos difusos (`blur-3xl`) que había en las esquinas: no
       aportaban jerarquía y son el fondo por defecto de cualquier plantilla.
       El bloque se separa del resto con un borde, que es más honesto. -->
  <div
    class="relative mx-auto max-w-4xl overflow-hidden rounded-card border border-borde bg-superficie-elevada p-8 sm:p-12 lg:p-16"
  >
    <div class="relative z-10 text-center">
      <h2
        class="mb-5 text-balance font-titulo text-3xl font-bold leading-tight text-negro md:text-4xl lg:text-5xl"
      >
        {t.ctaFinal.titulo}
      </h2>
      <p class="mx-auto mb-8 max-w-xl text-pretty text-lg leading-relaxed text-texto-suave">
        {t.ctaFinal.subtitulo}
      </p>

      <div
        class="mb-6 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
      >
        <BotonReserva idioma={idioma} texto={t.ctaFinal.boton} tamano="lg" />
        <BotonWhatsApp idioma={idioma} texto={t.ctaFinal.secundario} variante="contorno" />
      </div>

      <p class="mb-10 flex items-center justify-center gap-2 text-sm text-texto-suave">
        <span class="material-symbols-outlined text-base text-primario" aria-hidden="true"
          >check_circle</span
        >
        {t.ctaFinal.sinRegistro}
      </p>

      <p class="mb-3 font-titulo text-sm font-medium text-texto-suave" id="cta-atajos">
        {t.hero.elegiTuLugar}
      </p>
      <nav aria-labelledby="cta-atajos">
        <AtajosAlojamiento idioma={idioma} t={t} tono="oscuro" class="mx-auto max-w-xl" />
      </nav>
    </div>
  </div>
</section>
