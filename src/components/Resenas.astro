---
// Reseñas de huéspedes.
//
// Las reseñas son reales y se copian textuales del perfil de Google (ver
// `src/lib/resenas.ts`); no se traducen ni se editan. Lo que sí mejora acá es
// la presentación: se agrega el resumen de valoración (⭐ promedio + cantidad),
// que es la señal de confianza que el visitante busca de un vistazo, y se
// aclara de dónde salen.
import EncabezadoSeccion from './ui/EncabezadoSeccion.astro';
import { obtenerResenas } from '../lib/resenas';
import { interpolar, type Idioma, type Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;

const {
  resenas: RESENAS,
  promedio: promedioNum,
  cantidad: CANTIDAD_RESENAS,
  fuente: FUENTE_RESENAS,
} = await obtenerResenas();

const localeNumero = idioma === 'en' ? 'en-US' : idioma === 'pt' ? 'pt-BR' : 'es-AR';
const promedio = promedioNum.toLocaleString(localeNumero, { minimumFractionDigits: 1 });

const iniciales = (nombre: string) =>
  nombre
    .split(' ')
    .slice(0, 2)
    .map((n) => n[0])
    .join('')
    .toUpperCase();
---

<section id="resenas" class="scroll-mt-20 bg-fondo px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <EncabezadoSeccion
      kicker={t.resenas.kicker}
      titulo={t.resenas.titulo}
      subtitulo={t.resenas.subtitulo}
      class="mb-8"
    />

    <!-- Resumen de valoración -->
    <div
      class="mx-auto mb-12 flex max-w-max flex-col items-center gap-1 rounded-card bg-superficie px-8 py-5 shadow-suave sm:flex-row sm:gap-5"
    >
      <p class="font-titulo text-4xl font-bold text-negro">{promedio}</p>
      <div class="text-center sm:text-left">
        <div
          class="flex justify-center gap-0.5 text-estrella sm:justify-start"
          role="img"
          aria-label={interpolar(t.resenas.estrellas, { n: promedio })}
        >
          {
            Array.from({ length: 5 }).map((_, i) => (
              <span
                class="material-symbols-outlined text-xl"
                style={`font-variation-settings: 'FILL' ${i < Math.round(promedioNum) ? 1 : 0};`}
                aria-hidden="true"
              >
                star
              </span>
            ))
          }
        </div>
        <p class="mt-1 text-sm text-texto-suave">
          {interpolar(t.resenas.cantidad, { cantidad: CANTIDAD_RESENAS })}
        </p>
      </div>
    </div>

    <div class="resenas-carrusel-wrapper relative" data-carrusel>
      <ul
        class="resenas-pista -mx-6 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-6 pb-4 [-ms-overflow-style:none] [scrollbar-width:none] md:mx-0 md:px-0"
        data-pista
      >
        {
          RESENAS.map((resena) => (
            <li class="shrink-0 basis-[85%] snap-start sm:basis-[47%] lg:basis-[calc((100%-3rem)/3)]">
              <article class="flex h-full flex-col gap-5 rounded-card bg-superficie p-7 shadow-suave transition-shadow duration-300 hover:shadow-elevada lg:p-8">
                <div
                  class="flex gap-1 text-estrella"
                  role="img"
                  aria-label={interpolar(t.resenas.estrellas, { n: resena.estrellas })}
                >
                  {Array.from({ length: resena.estrellas }).map(() => (
                    <span
                      class="material-symbols-outlined text-xl"
                      style="font-variation-settings: 'FILL' 1;"
                      aria-hidden="true"
                    >
                      star
                    </span>
                  ))}
                </div>
                <blockquote class="flex-1">
                  <p lang={resena.idioma} class="text-base leading-relaxed text-texto">
                    “{resena.texto}”
                  </p>
                </blockquote>
                <footer class="flex items-center gap-4 border-t border-borde pt-4">
                  <span
                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primario/10 font-titulo text-sm font-bold text-primario"
                    aria-hidden="true"
                  >
                    {iniciales(resena.nombre)}
                  </span>
                  <cite class="font-titulo text-sm font-bold not-italic text-negro">
                    {resena.nombre}
                  </cite>
                </footer>
              </article>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex items-center justify-center gap-6">
        <button
          type="button"
          data-prev
          aria-label={t.resenas.anterior}
          class="flex h-11 w-11 items-center justify-center rounded-full bg-superficie text-negro shadow-suave transition-shadow hover:shadow-elevada focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40 disabled:cursor-not-allowed disabled:opacity-40"
        >
          <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
        </button>

        <!-- Cada punto se ve chico, pero su botón mide 24×24 px: el mínimo de
             área táctil que pide WCAG 2.5.8. El indicador visual va adentro,
             en un <span>, para no agrandar el punto. -->
        <div class="flex gap-1" data-dots>
          {
            RESENAS.map((_, i) => (
              <button
                type="button"
                data-dot={i}
                aria-label={interpolar(t.resenas.irA, { n: i + 1 })}
                class="flex h-6 w-6 items-center justify-center rounded-full focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40"
              >
                <span class="h-2.5 w-2.5 rounded-full bg-borde transition-all" aria-hidden="true" />
              </button>
            ))
          }
        </div>

        <button
          type="button"
          data-next
          aria-label={t.resenas.siguiente}
          class="flex h-11 w-11 items-center justify-center rounded-full bg-superficie text-negro shadow-suave transition-shadow hover:shadow-elevada focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40 disabled:cursor-not-allowed disabled:opacity-40"
        >
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </button>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-texto-suave">
      {t.resenas.fuente}
      {
        FUENTE_RESENAS.perfilUrl && (
          <a
            href={FUENTE_RESENAS.perfilUrl}
            target="_blank"
            rel="noopener"
            class="ml-1 font-semibold text-primario underline underline-offset-2"
          >
            {t.resenas.verTodas}
          </a>
        )
      }
    </p>
  </div>
</section>

<style>
  .resenas-pista::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initCarrusel(root: HTMLElement) {
    const pista = root.querySelector<HTMLElement>('[data-pista]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    if (!pista) return;

    const tarjetas = Array.from(pista.children) as HTMLElement[];

    const indiceActual = () => {
      const scroll = pista.scrollLeft;
      let mejor = 0;
      let dist = Infinity;
      tarjetas.forEach((t, i) => {
        const d = Math.abs(t.offsetLeft - pista.offsetLeft - scroll);
        if (d < dist) {
          dist = d;
          mejor = i;
        }
      });
      return mejor;
    };

    const irA = (i: number) => {
      const idx = Math.max(0, Math.min(tarjetas.length - 1, i));
      const tarjeta = tarjetas[idx];
      pista.scrollTo({ left: tarjeta.offsetLeft - pista.offsetLeft, behavior: 'smooth' });
    };

    const actualizar = () => {
      const actual = indiceActual();
      dots.forEach((d, i) => {
        const activo = i === actual;
        // El color y el ancho se aplican al indicador visual (el <span>), no
        // al botón, que mantiene su área táctil fija.
        const punto = d.firstElementChild ?? d;
        punto.classList.toggle('bg-primario', activo);
        punto.classList.toggle('bg-borde', !activo);
        punto.classList.toggle('w-5', activo);
        d.setAttribute('aria-current', activo ? 'true' : 'false');
      });
      if (prev) prev.disabled = pista.scrollLeft <= 1;
      if (next) next.disabled = pista.scrollLeft >= pista.scrollWidth - pista.clientWidth - 1;
    };

    prev?.addEventListener('click', () => irA(indiceActual() - 1));
    next?.addEventListener('click', () => irA(indiceActual() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => irA(i)));
    pista.addEventListener('scroll', actualizar, { passive: true });
    window.addEventListener('resize', actualizar);
    actualizar();
  }

  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach(initCarrusel);
</script>
