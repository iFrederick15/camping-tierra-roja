---
// Enlace a WhatsApp con mensaje pre-cargado en el idioma del visitante.
// Centraliza el color oficial de WhatsApp, el evento de analítica y el
// `rel` de seguridad para enlaces externos.
import { whatsappHref } from '../../lib/negocio';
import { EVENTOS } from '../../lib/analytics';
import type { Idioma } from '../../i18n';

interface Props {
  idioma: Idioma;
  texto: string;
  /** Contexto que se agrega al mensaje (ej: 'Cabaña'). */
  contexto?: string;
  variante?: 'verde' | 'contorno' | 'texto';
  bloque?: boolean;
  class?: string;
}

const {
  idioma,
  texto,
  contexto,
  variante = 'verde',
  bloque = false,
  class: clase = '',
} = Astro.props;

const VARIANTES = {
  // No se usa el verde de marca de WhatsApp (#25D366): con texto blanco encima
  // da 2:1 de contraste, muy lejos del 4.5:1 de WCAG AA. `--color-whatsapp`
  // es un tono del mismo sistema de color que llega a 6.2:1.
  verde: 'bg-whatsapp text-white hover:bg-whatsapp-hover shadow-md',
  contorno: 'border-2 border-whatsapp text-whatsapp hover:bg-whatsapp hover:text-white',
  texto: 'text-whatsapp hover:text-whatsapp-hover underline underline-offset-4',
};
---

<a
  href={whatsappHref(idioma, contexto)}
  target="_blank"
  rel="noopener"
  data-evento={EVENTOS.WHATSAPP}
  data-evento-detalle={contexto ?? 'general'}
  class:list={[
    'inline-flex items-center justify-center gap-2.5 rounded-pill font-titulo font-bold',
    'min-h-12 px-6 py-3 transition-all duration-200 active:scale-[0.98]',
    'focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-whatsapp/40 focus-visible:ring-offset-2',
    VARIANTES[variante],
    bloque ? 'w-full' : '',
    clase,
  ]}
>
  <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 shrink-0" aria-hidden="true">
    <path
      d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.27 4.9L2 22l5.25-1.28A9.94 9.94 0 0 0 12.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm5.84 14.24c-.25.7-1.24 1.28-2.03 1.45-.54.11-1.25.2-3.64-.78-2.94-1.21-4.85-4.2-5-4.4-.14-.19-1.2-1.6-1.2-3.05s.75-2.16 1.02-2.46c.25-.28.55-.35.73-.35.18 0 .37 0 .53.01.17.01.4-.06.62.48.25.6.83 2.08.9 2.23.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.3.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.38 1.47.3.15.47.13.65-.08.18-.2.76-.88.96-1.18.2-.3.4-.25.68-.15.28.1 1.76.83 2.06.98.3.15.5.23.57.35.07.13.07.72-.18 1.42Z"
    ></path>
  </svg>
  {texto}
</a>
