---
// Hero section con imagen de fondo
---

<section class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    <div
      class="absolute inset-0 bg-gradient-to-br from-fondo-oscuro via-fondo-oscuro/80 to-primario/40 opacity-10"
    >
    </div>
    <img
      src="/images/general/tierra-roja-drone.webp"
      alt="Vista aérea del camping y parque acuático Tierra Roja en la selva misionera de Puerto Iguazú"
      class="h-full w-full object-cover object-center blur-xs scale-105"
      width="1440"
      height="812"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-negro/80 via-negro/50 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-negro/60 via-transparent to-transparent">
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-20 w-full">
    <div class="lg:flex lg:items-center lg:gap-12">
      <div class="max-w-2xl mx-auto lg:mx-0">
        <!-- Title -->
        <h1
          class="font-titulo font-bold text-4xl sm:text-5xl lg:text-7xl leading-[1.05] tracking-tight text-white mb-4 break-words text-center lg:text-left"
        >
          Camping y Parque Acuático <br />
          <span class="bg-gradient-to-r from-primario to-acento bg-clip-text text-transparent pr-1"
            >Tierra Roja</span
          >
        </h1>

        <!-- Subtitle -->
        <p
          class="text-lg lg:text-xl text-white/80 max-w-xl mb-10 leading-relaxed text-center lg:text-left mx-auto lg:mx-0"
        >
          Diversión, naturaleza y relax para toda la familia, en plena selva misionera.
        </p>

        <!-- CTAs -->
        <div class="hidden lg:flex flex-wrap gap-4">
          <a
            href="#piscinas"
            class="bg-gradient-to-r from-primario to-acento text-white px-10 py-4 rounded-pill font-titulo font-bold text-lg hover:shadow-hero hover:-translate-y-1 transition-all duration-300 active:scale-95"
          >
            Explorar el Parque
          </a>
        </div>

        <!-- Imagen enmarcada (solo mobile): fondo desenfocado + esta imagen nítida como foco visual -->
        <div class="lg:hidden mt-4 rounded-card overflow-hidden shadow-hero aspect-[4/3]">
          <img
            src="/images/general/tierra-roja-drone.jpg"
            alt="Vista aérea del predio de Camping Tierra Roja rodeado de selva, Puerto Iguazú"
            class="w-full h-full object-cover object-center"
            width="1440"
            height="812"
          />
        </div>
      </div>

      <!-- Imagen enmarcada (solo desktop): mismo tratamiento, tarjeta inclinada con badge superpuesto -->
      <div class="hidden lg:block relative flex-1 max-w-lg">
        <div class="rounded-card overflow-hidden shadow-hero aspect-[4/3] rotate-2">
          <img
            src="/images/general/tierra-roja-drone.jpg"
            alt="Vista aérea del predio de Camping Tierra Roja rodeado de selva, Puerto Iguazú"
            class="w-full h-full object-cover object-center"
            width="1440"
            height="812"
          />
        </div>

        <!-- Floating badge -->
        <div
          class="absolute -bottom-6 left-6 inline-flex items-center gap-3 bg-white/10 backdrop-blur-md border border-white/15 px-5 py-3 rounded-card"
        >
          <span class="material-symbols-outlined text-acento text-3xl">nature_people</span>
          <p class="text-white/90 font-titulo font-medium text-sm leading-tight">
            Conexión Real<br />con la Naturaleza
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <span class="material-symbols-outlined text-white/50 text-3xl">keyboard_arrow_down</span>
  </div>
</section>
