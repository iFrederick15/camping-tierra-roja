---
// Hero de la página de inicio.
//
// Prioridad de conversión: en la primera pantalla el visitante tiene que
// entender QUÉ es esto, DÓNDE está y CÓMO reservar. Por eso el orden es
// título → propuesta de valor con la ubicación → prueba social → CTA
// «RESERVAR AHORA».
//
// Los atajos por tipo de alojamiento (Camping/Motorhome/Cabaña) NO van acá:
// piden elegir alojamiento antes de dar un motivo para hacerlo y compiten con
// el CTA principal. Viven en el cierre de la página (CTA.astro), cuando el
// visitante ya vio el lugar y decidió.
//
// Performance: antes se descargaban dos copias de la misma foto aérea (el
// .webp de fondo y el .jpg de la tarjeta). Ahora ambas usan el .webp, así que
// el navegador baja un solo archivo. La precarga se declara desde el <head>
// (prop `preloadImagen` del Layout), que es donde el navegador la descubre
// antes de empezar a parsear el cuerpo de la página.
import BotonReserva from './ui/BotonReserva.astro';
import BotonWhatsApp from './ui/BotonWhatsApp.astro';
import { obtenerResenas } from '../lib/resenas';
import { interpolar, type Idioma, type Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;

const { promedio: promedioNum, cantidad: cantidadNum } = await obtenerResenas();
// Mismo locale que Resenas.astro, para que el hero y la sección de reseñas
// muestren la valoración igual. `maximumFractionDigits` evita un "4,657" si
// Places devuelve más decimales, y la cantidad lleva separador de miles.
const localeNumero = idioma === 'en' ? 'en-US' : idioma === 'pt' ? 'pt-BR' : 'es-AR';
const promedio = promedioNum.toLocaleString(localeNumero, {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
const cantidad = cantidadNum.toLocaleString(localeNumero);
---

<section class="relative flex min-h-[calc(100dvh-4.5rem)] items-center overflow-hidden">
  <!-- Fondo -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/general/tierra-roja-drone.webp"
      alt=""
      class="h-full w-full object-cover object-center"
      width="1440"
      height="812"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />

    <!-- Los dos overlays se multiplican entre sí: con /90 + /70 el ángulo
         inferior izquierdo quedaba en 0,97 de negro y la foto no se leía.
         Con estos valores baja a ~0,87, suficiente para el texto blanco. -->
    <div class="absolute inset-0 bg-linear-to-r from-negro/72 via-negro/50 to-negro/15"></div>
    <div class="absolute inset-0 bg-linear-to-t from-negro/55 via-transparent to-negro/15"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-16 pt-10 sm:pt-14 lg:px-8 lg:pb-20">
    <div class="lg:flex lg:items-center lg:gap-14">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <p
          class="mb-4 text-balance text-center font-titulo text-xs font-bold uppercase tracking-[0.14em] text-white/85 sm:text-sm lg:text-left"
        >
          {t.hero.kicker}
        </p>

        <h1
          class="mb-5 text-balance wrap-break-word text-center font-titulo text-[2.1rem] font-bold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-left lg:text-6xl xl:text-7xl"
        >
          {t.hero.tituloLinea1}
          <!-- `acento` (#ef493d) y no `primario-claro` (#d4343f): sobre el
               fondo oscuro del hero da 4,8:1 en vez de 3,7:1. -->
          <span class="block text-acento">
            {t.hero.tituloMarca}
          </span>
        </h1>

        <p
          class="mx-auto mb-6 max-w-xl text-pretty text-center text-base leading-relaxed text-white/85 sm:text-lg lg:mx-0 lg:text-left"
        >
          {t.hero.subtitulo}
        </p>

        <!-- Dos señales, no tres: el subtítulo ya dice "a unos 20 minutos del
             Parque Nacional Iguazú", así que el chip de distancia repetía el
             dato en la misma pantalla. Quedan la valoración (prueba social) y
             "abierto todo el año" (dato operativo que no está en otro lado). -->
        <ul
          class="mb-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 lg:justify-start"
        >
          <li class="flex items-center gap-1.5">
            <span
              class="material-symbols-outlined text-lg text-estrella"
              style="font-variation-settings: 'FILL' 1;"
              aria-hidden="true">star</span
            >
            <span class="text-sm font-medium text-white/85">
              {interpolar(t.hero.pruebaSocial, { promedio, cantidad })}
            </span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-lg text-white/60" aria-hidden="true"
              >schedule</span
            >
            <span class="text-sm font-medium text-white/85">{t.hero.todoElAno}</span>
          </li>
        </ul>

        <!-- CTA principal -->
        <div
          class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center lg:justify-start"
        >
          <BotonReserva idioma={idioma} texto={t.hero.ctaPrincipal} tamano="lg" />
          <BotonWhatsApp idioma={idioma} texto={t.hero.ctaSecundario} variante="verde" />
        </div>
      </div>

      <!-- Tarjeta con la foto nítida. En desktop es un elemento de composición;
           en mobile se muestra debajo del contenido, sin competir con el CTA.
           Debajo de lg toma el ancho de la columna de texto (max-w-2xl): a ancho
           completo, en tablet era una foto de ~580px de alto que desbordaba la
           columna. El alt es el de la imagen OG (la misma foto), traducido. -->
      <div class="relative mx-auto mt-10 max-w-2xl flex-1 lg:mx-0 lg:mt-0 lg:max-w-lg">
        <div class="aspect-4/3 overflow-hidden rounded-card shadow-hero">
          <img
            src="/images/general/tierra-roja-drone.webp"
            alt={t.meta.ogAlt}
            class="h-full w-full object-cover object-center"
            width="1440"
            height="812"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>
