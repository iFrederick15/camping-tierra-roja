---
// Barra fija de reserva, solo en mobile.
//
// En el celular el CTA del header se pierde al hacer scroll y la página es
// larga: esta barra mantiene la acción principal siempre a un pulgar de
// distancia. Aparece recién después del hero (para no tapar el CTA
// principal, que ya está en pantalla) y desaparece en /reservar.
import { RUTAS, type Idioma, type Traducciones } from '../i18n';
import { whatsappHref } from '../lib/negocio';
import { EVENTOS } from '../lib/analytics';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;
---

<div
  id="barra-reserva-mobile"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-borde bg-superficie/95 backdrop-blur-lg transition-transform duration-300 lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="flex items-center gap-3 px-4 py-3">
    <a
      href={whatsappHref(idioma)}
      target="_blank"
      rel="noopener"
      data-evento={EVENTOS.WHATSAPP}
      data-evento-detalle="barra-mobile"
      aria-label={t.whatsapp.aria}
      class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-whatsapp text-whatsapp transition-colors active:bg-whatsapp active:text-white"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
        <path
          d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.27 4.9L2 22l5.25-1.28A9.94 9.94 0 0 0 12.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm5.84 14.24c-.25.7-1.24 1.28-2.03 1.45-.54.11-1.25.2-3.64-.78-2.94-1.21-4.85-4.2-5-4.4-.14-.19-1.2-1.6-1.2-3.05s.75-2.16 1.02-2.46c.25-.28.55-.35.73-.35.18 0 .37 0 .53.01.17.01.4-.06.62.48.25.6.83 2.08.9 2.23.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.3.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.38 1.47.3.15.47.13.65-.08.18-.2.76-.88.96-1.18.2-.3.4-.25.68-.15.28.1 1.76.83 2.06.98.3.15.5.23.57.35.07.13.07.72-.18 1.42Z"
        ></path>
      </svg>
    </a>
    <a
      href={RUTAS[idioma].reservar}
      data-evento={EVENTOS.RESERVAR}
      data-evento-detalle="barra-mobile"
      class="flex min-h-12 flex-1 items-center justify-center gap-2 rounded-pill bg-primario font-titulo font-bold text-white"
    >
      {t.hero.ctaPrincipal}
      <span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_forward</span>
    </a>
  </div>
</div>

<script>
  // Aparece cuando el usuario dejó atrás la primera pantalla. Se usa un
  // IntersectionObserver sobre un centinela en vez de escuchar `scroll`,
  // para no ejecutar JS en cada frame de scroll (mejor INP).
  const barra = document.getElementById('barra-reserva-mobile');
  if (barra) {
    const centinela = document.createElement('div');
    centinela.setAttribute('aria-hidden', 'true');
    centinela.style.cssText = 'position:absolute;top:85vh;height:1px;width:1px;';
    document.body.appendChild(centinela);

    const observador = new IntersectionObserver(
      ([entrada]) => {
        barra.classList.toggle('translate-y-full', entrada.isIntersecting);
      },
      { threshold: 0 }
    );
    observador.observe(centinela);
  }
</script>
