---
// Sección Contacto
import { NEGOCIO, DIRECCION_COMPLETA } from '../lib/negocio';
---

<section class="max-w-7xl mx-auto px-6 mb-16 text-center md:text-left">
  <h1
    class="font-titulo font-extrabold text-4xl md:text-6xl text-texto mb-6 tracking-tight leading-tight"
  >
    <span class="text-primario italic">Contacto</span> y cómo llegar
  </h1>
  <p class="text-texto-suave text-lg max-w-2xl leading-relaxed mx-auto md:mx-0">
    Camping Tierra Roja está en {NEGOCIO.direccion.calle}, {NEGOCIO.direccion.localidad}, a unos 20
    minutos de las Cataratas del Iguazú y del centro de Puerto Iguazú. Atendemos todos los días del
    año. Para consultas de disponibilidad y reservas, escribinos por WhatsApp o completá el
    formulario y te respondemos dentro de las 24 horas.
  </p>
</section>
<!-- Contact Bento Grid -->
<section class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <!-- Contact Form Card -->
  <div
    class="lg:col-span-7 bg-superficie p-8 md:p-12 rounded-xl shadow-(--shadow-elevada) border border-borde/10"
  >
    <h2 class="font-titulo font-bold text-3xl mb-8">Envianos tu mensaje</h2>
    <form id="form-contacto" class="space-y-6" method="post" action="/api/contacto" novalidate>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-2">
          <label for="contacto-nombre" class="font-cuerpo text-sm font-semibold text-texto-suave ml-2"
            >Nombre completo</label
          >
          <input
            id="contacto-nombre"
            name="nombre"
            type="text"
            required
            autocomplete="name"
            class="w-full bg-fondo-alt border-none rounded-lg p-4 focus:ring-2 focus:ring-primario/20 focus:bg-superficie transition-all"
            placeholder="Pedro Pérez"
          />
        </div>
        <div class="space-y-2">
          <label for="contacto-email" class="font-cuerpo text-sm font-semibold text-texto-suave ml-2"
            >Email</label
          >
          <input
            id="contacto-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full bg-fondo-alt border-none rounded-lg p-4 focus:ring-2 focus:ring-primario/20 focus:bg-superficie transition-all"
            placeholder="pedro@example.com"
          />
        </div>
      </div>
      <div class="space-y-2">
        <label for="contacto-tipo" class="font-cuerpo text-sm font-semibold text-texto-suave ml-2"
          >Tipo de consulta</label
        >
        <select
          id="contacto-tipo"
          name="tipoConsulta"
          class="w-full bg-fondo-alt border-none rounded-lg p-2 focus:ring-2 focus:ring-primario/20 focus:bg-superficie transition-all"
        >
          <option>Información general</option>
          <option>Camping</option>
          <option>Motorhome</option>
          <option>Parque acuático</option>
          <option>Cabaña</option>
        </select>
      </div>
      <div class="space-y-2">
        <label for="contacto-mensaje" class="font-cuerpo text-sm font-semibold text-texto-suave ml-2"
          >Mensaje</label
        >
        <textarea
          id="contacto-mensaje"
          name="mensaje"
          required
          rows="5"
          class="w-full bg-fondo-alt border-none rounded-lg p-4 focus:ring-2 focus:ring-primario/20 focus:bg-superficie transition-all"
          placeholder="¿Cómo podemos ayudarte?"></textarea>
      </div>
      <!-- Honeypot anti-spam: oculto para humanos, los bots lo completan -->
      <div class="hidden" aria-hidden="true">
        <label for="contacto-website">No completar</label>
        <input id="contacto-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <button
        type="submit"
        class="w-full md:w-auto bg-gradient-to-r from-primario to-primario-claro text-white px-12 py-4 rounded-full font-bold transition-all hover:shadow-xl active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed"
      >
        Enviar mensaje
      </button>
      <p id="form-contacto-estado" class="text-sm font-semibold" role="status" aria-live="polite"></p>
    </form>
  </div>
  <!-- Side Info Cluster -->
  <div class="lg:col-span-5 space-y-8">
    <!-- Quick Contact -->
    <div class="bg-acento/5 p-8 rounded-xl space-y-8">
      <h2 class="font-titulo font-bold text-2xl text-acento">Datos de contacto</h2>
      <div class="space-y-6">
        <div class="flex items-start gap-4">
          <div class="bg-primario/10 p-3 rounded-lg text-primario">
            <span class="material-symbols-outlined">location_on</span>
          </div>
          <div>
            <p class="font-bold text-texto">Ubicación</p>
            <p class="text-texto-suave">{DIRECCION_COMPLETA}</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="bg-acento/10 p-3 rounded-lg text-acento">
            <span class="material-symbols-outlined">call</span>
          </div>
          <div>
            <p class="font-bold text-texto">Teléfono</p>
            <a href={`tel:${NEGOCIO.telefonoE164}`} class="text-texto-suave hover:text-primario transition-colors"
              >{NEGOCIO.telefono}</a
            >
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="bg-primario/10 p-3 rounded-lg text-primario">
            <span class="material-symbols-outlined">mail</span>
          </div>
          <div>
            <p class="font-bold text-texto">Email</p>
            <a href={`mailto:${NEGOCIO.email}`} class="text-texto-suave hover:text-primario transition-colors"
              >{NEGOCIO.email}</a
            >
          </div>
        </div>
      </div>
      <a
        class="flex items-center justify-center gap-3 bg-[#25D366] text-white w-full py-4 rounded-xl font-bold hover:brightness-110 transition-all shadow-md"
        href={`https://wa.me/${NEGOCIO.whatsapp}`}
      >
        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">chat</span>
        Hablar por WhatsApp
      </a>
    </div>
    <!-- Park Image Accent -->
    <div class="relative h-64 rounded-lg overflow-hidden group">
      <img
        src="/images/tierra-roja-drone.webp"
        alt="Vista aérea del predio de Camping Tierra Roja rodeado de selva, Puerto Iguazú"
        width="1440"
        height="812"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-6">
        <p class="text-white font-titulo font-bold text-xl">En plena selva misionera.</p>
      </div>
    </div>
  </div>
</section>
<!-- Map Section -->
<section class="max-w-7xl mx-auto px-6 mt-20">
  <div class="bg-fondo p-4 rounded-xl">
    <div
      class="flex flex-col md:flex-row justify-between items-stretch md:items-center gap-6 mb-8 px-4 py-6"
    >
      <div>
        <h2 class="font-titulo font-extrabold text-3xl mb-5">Encontranos en el mapa</h2>
        <p class="text-texto-suave">
          Ubicados a tan solo 20 minutos de las majestuosas Cataratas del Iguazú.
        </p>
      </div>

      <div
        class="w-full h-72 sm:h-96 lg:h-[500px] rounded-lg overflow-hidden bg-fondo-alt relative"
      >
        <iframe
          class="w-full h-full border-0"
          src="https://www.google.com/maps?q=Camping+Tierra+Roja+y+Parque+Acu%C3%A1tico,-25.6381084,-54.5744466&hl=es&z=15&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de Camping Tierra Roja en Puerto Iguazú en el mapa"></iframe>
        <div class="absolute top-4 left-4 pointer-events-none"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const form = document.getElementById('form-contacto');
    if (!form) return;
    const estado = document.getElementById('form-contacto-estado');
    const boton = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      boton.disabled = true;
      estado.textContent = 'Enviando…';
      estado.className = 'text-sm font-semibold text-texto-suave';

      try {
        const res = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok) {
          form.reset();
          estado.textContent = '¡Listo! Recibimos tu mensaje y te respondemos dentro de las 24 horas.';
          estado.className = 'text-sm font-semibold text-confirmado';
        } else {
          estado.textContent =
            (data && data.error) || 'No pudimos enviar tu mensaje. Probá por WhatsApp.';
          estado.className = 'text-sm font-semibold text-primario';
        }
      } catch (err) {
        estado.textContent = 'No pudimos enviar tu mensaje. Probá por WhatsApp.';
        estado.className = 'text-sm font-semibold text-primario';
      } finally {
        boton.disabled = false;
      }
    });
  })();
</script>
