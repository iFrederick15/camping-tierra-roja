---
// Página de contacto: formulario + datos + mapa.
//
// Mejoras: textos traducidos, atajo directo a reservar (mucha gente entra a
// "Contacto" cuando en realidad quiere reservar), WhatsApp con mensaje
// pre-cargado, mensajes de estado del formulario accesibles y campos con
// `autocomplete` para que el navegador los complete solo en mobile.
import BotonReserva from './ui/BotonReserva.astro';
import BotonWhatsApp from './ui/BotonWhatsApp.astro';
import { NEGOCIO, DIRECCION_COMPLETA, CONTACTO_HREF } from '../lib/negocio';
import { EVENTOS } from '../lib/analytics';
import { interpolar, type Idioma, type Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;

const hlMapa = idioma === 'pt' ? 'pt-BR' : idioma === 'en' ? 'en' : 'es';
const mapaEmbed = `https://www.google.com/maps?q=Camping+Tierra+Roja+y+Parque+Acu%C3%A1tico,${NEGOCIO.geo.lat},${NEGOCIO.geo.lng}&hl=${hlMapa}&z=15&output=embed`;

// Los valores enviados al backend quedan SIEMPRE en español: /api/contacto y
// el correo que recibe el camping no cambian de idioma.
const tiposConsulta = [
  { valor: 'Información general', label: t.contacto.opciones.general },
  { valor: 'Camping', label: t.contacto.opciones.camping },
  { valor: 'Motorhome', label: t.contacto.opciones.motorhome },
  { valor: 'Parque acuático', label: t.contacto.opciones.parque },
  { valor: 'Cabaña', label: t.contacto.opciones.cabana },
  { valor: 'Quinchos', label: t.contacto.opciones.quinchos },
];

const claseCampo =
  'w-full rounded-lg border border-borde bg-fondo-alt p-4 transition-all focus:border-primario focus:bg-superficie focus:outline-none focus:ring-4 focus:ring-primario/20';
---

<section class="mx-auto mb-12 max-w-7xl px-6 text-center md:text-left">
  <h1
    class="mb-5 font-titulo text-4xl font-extrabold leading-tight tracking-tight text-texto sm:text-5xl md:text-6xl"
  >
    <span class="text-primario">{t.contacto.tituloDestacado}</span>
    {t.contacto.titulo}
  </h1>
  <p class="mx-auto max-w-2xl text-lg leading-relaxed text-texto-suave md:mx-0">
    {interpolar(t.contacto.intro, { direccion: NEGOCIO.direccion.calle })}
  </p>

  <!-- Atajo para quien ya decidió: no hace falta escribir un mensaje. -->
  <div
    class="mt-8 flex flex-col items-center gap-3 rounded-card border border-borde bg-superficie px-6 py-5 shadow-suave sm:flex-row sm:justify-between md:max-w-2xl"
  >
    <p class="font-titulo text-lg font-bold text-negro">{t.contacto.reservaAtajo}</p>
    <BotonReserva idioma={idioma} texto={t.contacto.reservaAtajoBoton} tamano="md" />
  </div>
</section>

<section class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-8 px-6 lg:grid-cols-12">
  <!-- Formulario -->
  <div
    class="rounded-xl border border-borde/40 bg-superficie p-8 shadow-(--shadow-elevada) md:p-12 lg:col-span-7"
  >
    <h2 class="mb-8 font-titulo text-3xl font-bold">{t.contacto.formTitulo}</h2>
    <form id="form-contacto" class="space-y-6" method="post" action="/api/contacto" novalidate>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="space-y-2">
          <label
            for="contacto-nombre"
            class="ml-2 font-cuerpo text-sm font-semibold text-texto-suave"
          >
            {t.contacto.nombre}
          </label>
          <input
            id="contacto-nombre"
            name="nombre"
            type="text"
            required
            autocomplete="name"
            class={claseCampo}
            placeholder={t.contacto.nombrePlaceholder}
          />
        </div>
        <div class="space-y-2">
          <label
            for="contacto-email"
            class="ml-2 font-cuerpo text-sm font-semibold text-texto-suave"
          >
            {t.contacto.email}
          </label>
          <input
            id="contacto-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            class={claseCampo}
            placeholder={t.contacto.emailPlaceholder}
          />
        </div>
      </div>
      <div class="space-y-2">
        <label for="contacto-tipo" class="ml-2 font-cuerpo text-sm font-semibold text-texto-suave">
          {t.contacto.tipoConsulta}
        </label>
        <select id="contacto-tipo" name="tipoConsulta" class={claseCampo}>
          {tiposConsulta.map((o) => <option value={o.valor}>{o.label}</option>)}
        </select>
      </div>
      <div class="space-y-2">
        <label
          for="contacto-mensaje"
          class="ml-2 font-cuerpo text-sm font-semibold text-texto-suave"
        >
          {t.contacto.mensaje}
        </label>
        <textarea
          id="contacto-mensaje"
          name="mensaje"
          required
          rows="5"
          class={claseCampo}
          placeholder={t.contacto.mensajePlaceholder}></textarea>
      </div>
      <!-- Honeypot anti-spam: oculto para humanos, los bots lo completan -->
      <div class="hidden" aria-hidden="true">
        <label for="contacto-website">No completar</label>
        <input id="contacto-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <button
        type="submit"
        data-enviar={t.contacto.enviar}
        data-enviando={t.contacto.enviando}
        data-ok={t.contacto.ok}
        data-error={t.contacto.error}
        class="min-h-14 w-full rounded-full bg-primario px-12 font-titulo font-bold text-white transition-colors hover:bg-primario-oscuro focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40 disabled:cursor-not-allowed disabled:opacity-60 md:w-auto"
      >
        {t.contacto.enviar}
      </button>
      <p id="form-contacto-estado" class="text-sm font-semibold" role="status" aria-live="polite">
      </p>
    </form>
  </div>

  <!-- Datos de contacto -->
  <div class="space-y-8 lg:col-span-5">
    <div class="space-y-7 rounded-xl bg-acento/5 p-8">
      <h2 class="font-titulo text-2xl font-bold text-primario">{t.contacto.datosTitulo}</h2>
      <ul class="space-y-6">
        <li class="flex items-start gap-4">
          <span class="rounded-lg bg-primario/10 p-3 text-primario" aria-hidden="true">
            <span class="material-symbols-outlined">location_on</span>
          </span>
          <div>
            <p class="font-bold text-texto">{t.contacto.ubicacionLabel}</p>
            <address class="not-italic text-texto-suave">{DIRECCION_COMPLETA}</address>
          </div>
        </li>
        <li class="flex items-start gap-4">
          <span class="rounded-lg bg-acento/10 p-3 text-acento" aria-hidden="true">
            <span class="material-symbols-outlined">call</span>
          </span>
          <div>
            <p class="font-bold text-texto">{t.contacto.telefonoLabel}</p>
            <a
              href={CONTACTO_HREF.tel}
              data-evento={EVENTOS.TELEFONO}
              class="text-texto-suave transition-colors hover:text-primario">{NEGOCIO.telefono}</a
            >
          </div>
        </li>
        <li class="flex items-start gap-4">
          <span class="rounded-lg bg-primario/10 p-3 text-primario" aria-hidden="true">
            <span class="material-symbols-outlined">mail</span>
          </span>
          <div class="min-w-0">
            <p class="font-bold text-texto">{t.contacto.emailLabel}</p>
            <a
              href={CONTACTO_HREF.mailto}
              data-evento={EVENTOS.EMAIL}
              class="break-all text-texto-suave transition-colors hover:text-primario"
              >{NEGOCIO.email}</a
            >
          </div>
        </li>
      </ul>
      <div class="space-y-2">
        <BotonWhatsApp
          idioma={idioma}
          texto={t.contacto.whatsappBoton}
          contexto={t.contacto.tituloDestacado}
          bloque
        />
        <p class="text-center text-xs text-texto-suave">{t.contacto.respuestaRapida}</p>
      </div>
    </div>

    <div class="group relative h-64 overflow-hidden rounded-lg">
      <img
        src="/images/general/tierra-roja-drone.webp"
        alt="Vista aérea del predio de Camping Tierra Roja rodeado de selva, Puerto Iguazú"
        width="1440"
        height="812"
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <div
        class="absolute inset-0 flex items-end bg-gradient-to-t from-black/70 to-transparent p-6"
      >
        <p class="font-titulo text-xl font-bold text-white">{t.contacto.fotoPie}</p>
      </div>
    </div>
  </div>
</section>

<!-- Mapa -->
<section class="mx-auto mt-20 max-w-7xl px-6">
  <div class="rounded-xl bg-fondo p-4">
    <div class="flex flex-col gap-6 px-4 py-6 lg:flex-row lg:items-center">
      <div class="lg:w-1/3">
        <h2 class="mb-4 font-titulo text-3xl font-extrabold">{t.contacto.mapaTitulo}</h2>
        <p class="mb-6 text-texto-suave">{t.contacto.mapaTexto}</p>
        <a
          href={NEGOCIO.mapaUrl}
          target="_blank"
          rel="noopener"
          data-evento={EVENTOS.MAPA}
          data-evento-detalle="contacto"
          class="inline-flex min-h-12 items-center gap-2 rounded-pill border-2 border-primario px-6 font-titulo font-bold text-primario transition-colors hover:bg-primario hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primario/40"
        >
          <span class="material-symbols-outlined text-xl" aria-hidden="true">near_me</span>
          {t.ubicacion.comoLlegar}
        </a>
      </div>

      <div
        class="h-72 w-full overflow-hidden rounded-lg bg-fondo-alt sm:h-96 lg:h-[500px] lg:flex-1"
      >
        <iframe
          class="h-full w-full border-0"
          src={mapaEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={t.ubicacion.mapaTitulo}></iframe>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const form = document.getElementById('form-contacto');
    if (!form) return;
    const estado = document.getElementById('form-contacto-estado');
    const boton = form.querySelector('button[type="submit"]');
    const textos = boton.dataset;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      boton.disabled = true;
      boton.textContent = textos.enviando;
      estado.textContent = textos.enviando;
      estado.className = 'text-sm font-semibold text-texto-suave';

      try {
        const res = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok) {
          form.reset();
          estado.textContent = textos.ok;
          estado.className = 'text-sm font-semibold text-confirmado';
          if (window.trackEvent) window.trackEvent('contacto_enviado');
        } else {
          estado.textContent = (data && data.error) || textos.error;
          estado.className = 'text-sm font-semibold text-primario';
        }
      } catch (err) {
        estado.textContent = textos.error;
        estado.className = 'text-sm font-semibold text-primario';
      } finally {
        boton.disabled = false;
        boton.textContent = textos.enviar;
      }
    });
  })();
</script>
