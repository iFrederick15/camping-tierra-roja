---
// Botón flotante de WhatsApp, visible en mobile y desktop.
//
// WhatsApp es el canal real de consultas del camping (ya estaba en el footer
// y en Contacto, pero enterrado). Acá queda siempre a mano, en la esquina
// donde llega el pulgar, sin tapar contenido:
//   • en mobile se sube por encima de la barra de reserva fija,
//   • se oculta mientras el usuario está en /reservar (ya está reservando:
//     un botón que lo saca del flujo sería contraproducente).
import { whatsappHref } from '../lib/negocio';
import { EVENTOS } from '../lib/analytics';
import type { Idioma, Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
  /** Sube el botón para no chocar con la barra de reserva fija de mobile. */
  conBarraMobile?: boolean;
}

const { idioma, t, conBarraMobile = true } = Astro.props;
---

<a
  href={whatsappHref(idioma)}
  target="_blank"
  rel="noopener"
  data-evento={EVENTOS.WHATSAPP}
  data-evento-detalle="flotante"
  aria-label={t.whatsapp.aria}
  class:list={[
    'fixed right-4 z-40 flex h-14 w-14 items-center justify-center rounded-full sm:right-6 sm:h-15 sm:w-15',
    'bg-whatsapp text-white shadow-elevada transition-colors duration-150',
    'hover:bg-whatsapp-hover',
    'focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-whatsapp',
    // Con barra de reserva en mobile: se apoya justo encima de ella.
    conBarraMobile ? 'bottom-24 lg:bottom-6' : 'bottom-6',
  ]}
>
  <svg viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7" aria-hidden="true">
    <path
      d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.27 4.9L2 22l5.25-1.28A9.94 9.94 0 0 0 12.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm5.84 14.24c-.25.7-1.24 1.28-2.03 1.45-.54.11-1.25.2-3.64-.78-2.94-1.21-4.85-4.2-5-4.4-.14-.19-1.2-1.6-1.2-3.05s.75-2.16 1.02-2.46c.25-.28.55-.35.73-.35.18 0 .37 0 .53.01.17.01.4-.06.62.48.25.6.83 2.08.9 2.23.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.3.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.38 1.47.3.15.47.13.65-.08.18-.2.76-.88.96-1.18.2-.3.4-.25.68-.15.28.1 1.76.83 2.06.98.3.15.5.23.57.35.07.13.07.72-.18 1.42Z"
    ></path>
  </svg>
</a>
