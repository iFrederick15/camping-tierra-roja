---
const piscinas = [
  {
    nombre: "Diversión",
    descripcion: "Piscina principal con cortina de agua bajo la pérgola, sillas reclinables y juegos.",
    icono: "child_care",
    etiqueta: "Diversión Familiar",
    imagen: "/images/piscina-diversion.webp",
    alt: "Piscina principal con cortina de agua y pérgola en el parque acuático de Tierra Roja, Puerto Iguazú",
    color: "primario",
  },
  {
    nombre: "Familiar",
    descripcion: "Tres toboganes de colores para vivir la mejor aventura acuática en familia.",
    icono: "family_restroom",
    etiqueta: "Aventura Familiar",
    imagen: "/images/piscina-familiar.webp",
    alt: "Piscina con tres toboganes de colores en el parque acuático de Tierra Roja, Puerto Iguazú",
    color: "acento",
  },
  {
    nombre: "Relax",
    descripcion: "Cascada de agua y un ambiente especial para desconexión total.",
    icono: "spa",
    etiqueta: "Relax Total",
    imagen: "/images/piscina-relax.webp",
    alt: "Piscina de relax con cascada de agua en el parque acuático de Tierra Roja, Puerto Iguazú",
    color: "primario",
  },
];
---

<section id="piscinas" class="py-24 lg:py-32 bg-fondo-alt px-6">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16 lg:mb-20">
      <h2 class="font-titulo font-bold text-4xl lg:text-5xl text-negro mb-4">
        Nuestras Piscinas
      </h2>
      <p class="text-texto-suave max-w-2xl mx-auto text-lg">
       Diseñadas para refrescar el alma y encender la diversión.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      {piscinas.map((piscina) => (
        <article class="bg-superficie rounded-card overflow-hidden group hover:shadow-elevada transition-all duration-500">
          <!-- Imagen -->
          <div class="aspect-[8/5] relative overflow-hidden">
            <img
              src={piscina.imagen}
              alt={piscina.alt}
              width="800"
              height="500"
              class="w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <!-- Content -->
          <div class="p-7 lg:p-8">
            <h3 class={`font-titulo font-bold text-2xl text-${piscina.color} mb-3 italic`}>
              {piscina.nombre}
            </h3>
            <p class="text-texto-suave mb-6 leading-relaxed">
              {piscina.descripcion}
            </p>
            <div class={`flex items-center gap-2 text-${piscina.color} font-titulo font-bold text-sm`}>
              <span class="material-symbols-outlined">{piscina.icono}</span>
              <span>{piscina.etiqueta}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
