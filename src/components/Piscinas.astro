---
// Parque acuático: las tres piscinas.
//
// Es el diferencial del camping frente a la competencia de Puerto Iguazú, así
// que la sección deja explícito que el acceso está incluido en la estadía
// (antes había que deducirlo) y cierra con un CTA de reserva.
import EncabezadoSeccion from './ui/EncabezadoSeccion.astro';
import BotonReserva from './ui/BotonReserva.astro';
import type { Idioma, Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;

// Los datos que no cambian con el idioma (fotos, iconos) viven acá; los
// textos vienen del diccionario, en el mismo orden.
const visuales = [
  {
    icono: 'pool',
    imagen: '/images/piscinas/piscina-diversion.webp',
    alt: 'Piscina principal con cortina de agua y pérgola en el parque acuático de Tierra Roja, Puerto Iguazú',
  },
  {
    icono: 'child_care',
    imagen: '/images/piscinas/piscina-familiar.webp',
    alt: 'Piscina con tres toboganes de colores en el parque acuático de Tierra Roja, Puerto Iguazú',
  },
  {
    icono: 'spa',
    imagen: '/images/piscinas/piscina-relax.webp',
    alt: 'Piscina de relax con cascada de agua en el parque acuático de Tierra Roja, Puerto Iguazú',
  },
];

const piscinas = t.piscinas.lista.map((p, i) => ({ ...p, ...visuales[i] }));
---

<section id="piscinas" class="scroll-mt-20 bg-fondo-alt px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <EncabezadoSeccion
      kicker={t.piscinas.kicker}
      titulo={t.piscinas.titulo}
      subtitulo={t.piscinas.subtitulo}
      class="mb-4"
    />

    <!-- El dato va como línea de texto, no como píldora con icono de
         "verificado": es información, no un sello. -->
    <p
      class="mx-auto mb-14 max-w-max border-b border-primario/30 pb-1 font-titulo text-sm font-bold text-primario"
    >
      {t.piscinas.incluido}
    </p>

    <div class="grid grid-cols-1 gap-7 md:grid-cols-3 lg:gap-8">
      {
        piscinas.map((piscina) => (
          <article class="group flex flex-col overflow-hidden rounded-card bg-superficie shadow-suave transition-shadow duration-300 hover:shadow-elevada">
            <div class="relative aspect-[8/5] overflow-hidden">
              <img
                src={piscina.imagen}
                alt={piscina.alt}
                width="800"
                height="500"
                class="h-full w-full object-cover object-center"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="flex flex-1 flex-col p-7 lg:p-8">
              <h3 class="mb-3 font-titulo text-2xl font-bold text-negro">{piscina.nombre}</h3>
              <p class="mb-6 flex-1 leading-relaxed text-texto-suave">{piscina.descripcion}</p>
              <p class="flex items-center gap-2 font-titulo text-sm font-bold text-primario">
                <span class="material-symbols-outlined" aria-hidden="true">
                  {piscina.icono}
                </span>
                {piscina.etiqueta}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <BotonReserva idioma={idioma} texto={t.ctaFinal.boton} tamano="lg" />
    </div>
  </div>
</section>
