---
// Parque acuático: las tres piscinas.
//
// Es el diferencial del camping frente a la competencia de Puerto Iguazú, así
// que la sección deja explícito que el acceso está incluido en la estadía
// (antes había que deducirlo) y cierra con un CTA de reserva.
import EncabezadoSeccion from './ui/EncabezadoSeccion.astro';
import BotonReserva from './ui/BotonReserva.astro';
import type { ICONOS_MATERIAL } from '../lib/iconos';
import type { Idioma, Traducciones } from '../i18n';

interface Props {
  idioma: Idioma;
  t: Traducciones;
}

const { idioma, t } = Astro.props;

// Los datos que no cambian con el idioma (fotos, iconos) viven acá; los
// textos, incluido el `alt`, vienen del diccionario en el mismo orden.
//
// El tipo de `icono` es la lista de `src/lib/iconos.ts`: un icono que no esté
// en la fuente recortada se renderiza como texto plano, así que TypeScript lo
// marca al escribirlo en vez de que aparezca el nombre del icono en la web.
const visuales: { icono: (typeof ICONOS_MATERIAL)[number]; imagen: string }[] = [
  { icono: 'pool', imagen: '/images/piscinas/piscina-diversion.webp' },
  { icono: 'child_care', imagen: '/images/piscinas/piscina-familiar.webp' },
  { icono: 'spa', imagen: '/images/piscinas/piscina-relax.webp' },
];

// Se recorre `visuales` (y no el diccionario) porque las fotos son las tres
// piscinas que existen: si una traducción quedara corta, la tarjeta pierde el
// texto pero no queda un `<img>` sin `src`. Mismo criterio que en Galería.
const piscinas = visuales.map((visual, i) => ({ ...visual, ...t.piscinas.lista[i] }));
---

<section id="piscinas" class="scroll-mt-20 bg-fondo-alt px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <EncabezadoSeccion
      kicker={t.piscinas.kicker}
      titulo={t.piscinas.titulo}
      subtitulo={t.piscinas.subtitulo}
      class="mb-12"
    />

    <div class="grid grid-cols-1 gap-7 md:grid-cols-3 lg:gap-8">
      {
        piscinas.map((piscina) => (
          <article class="flex flex-col overflow-hidden rounded-card bg-superficie shadow-suave transition-shadow duration-200 hover:shadow-elevada">
            <div class="aspect-8/5 overflow-hidden">
              <img
                src={piscina.imagen}
                alt={piscina.alt}
                width="800"
                height="500"
                class="h-full w-full object-cover object-center"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="flex flex-1 flex-col p-7 lg:p-8">
              <h3 class="mb-3 font-titulo text-2xl font-bold text-negro">{piscina.nombre}</h3>
              <p class="mb-6 flex-1 leading-relaxed text-texto-suave">{piscina.descripcion}</p>
              <p class="flex items-center gap-2 font-titulo text-sm font-bold text-primario">
                <span class="material-symbols-outlined" aria-hidden="true">
                  {piscina.icono}
                </span>
                {piscina.etiqueta}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <BotonReserva idioma={idioma} texto={t.ctaFinal.boton} tamano="lg" />
    </div>
  </div>
</section>
