---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { NEGOCIO } from '../lib/negocio';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Tierra Roja | Camping y Parque Acuático - Puerto Iguazú',
  description = 'Camping y parque acuático en Puerto Iguazú, Misiones. Piscinas, cabañas, parcelas de camping y espacio motorhome en plena selva misionera.',
  // JPG (no WebP): el scraper de Open Graph de Facebook/WhatsApp no renderiza
  // la previsualización con WebP, y ese es el canal de difusión principal.
  image = '/images/general/tierra-roja-drone.jpg',
} = Astro.props;

// El dominio de marca vive en un solo lugar (astro.config.mjs → site) para
// que canonical, Open Graph y el JSON-LD de más abajo no puedan desincronizarse.
const sitioUrl = (Astro.site ?? new URL('https://tierraroja.com.ar')).origin;
const canonicalURL = new URL(Astro.url.pathname, sitioUrl);
const imagenSocial = new URL(image, sitioUrl);

// Datos estructurados (schema.org) para resultados enriquecidos en Google y
// Google Maps: dirección, geolocalización, teléfono y redes ya se muestran
// en el sitio (Footer, Contacto, Normas del Parque); acá solo se estructuran.
const schemaNegocio = {
  '@context': 'https://schema.org',
  '@type': 'Campground',
  '@id': `${sitioUrl}/#negocio`,
  name: NEGOCIO.nombre,
  description:
    'Camping y parque acuático en Puerto Iguazú, Misiones. Piscinas, cabañas, parcelas de camping y espacio motorhome en plena selva misionera.',
  url: sitioUrl,
  image: `${sitioUrl}/images/general/tierra-roja-drone.jpg`,
  telephone: NEGOCIO.telefonoE164,
  email: NEGOCIO.email,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: NEGOCIO.direccion.calle,
    addressLocality: NEGOCIO.direccion.localidad,
    addressRegion: NEGOCIO.direccion.region,
    postalCode: NEGOCIO.direccion.codigoPostal,
    addressCountry: NEGOCIO.direccion.pais,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: NEGOCIO.geo.lat,
    longitude: NEGOCIO.geo.lng,
  },
  hasMap: NEGOCIO.mapaUrl,
  // El camping opera todo el año (ver Normas del Parque).
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  checkoutTime: '10:00:00',
  petsAllowed: true,
  sameAs: [
    'https://www.instagram.com/tierraroja_iguazu',
    'https://www.facebook.com/tierrarojaiguazu',
    'https://www.tiktok.com/@tierraroja_iguazu',
  ],
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Piscinas', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Parcelas de camping', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Espacio para motorhome', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Cabaña', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Quinchos con parrilla', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Wi-Fi', value: true },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#b01c2e" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (WhatsApp, Instagram, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tierra Roja" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="812" />
    <meta property="og:image:alt" content="Vista aérea del camping y parque acuático Tierra Roja en la selva misionera" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenSocial} />
    <meta name="twitter:image:alt" content="Vista aérea del camping y parque acuático Tierra Roja en la selva misionera" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaNegocio)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Petemoss&display=swap"
      rel="stylesheet"
    />
    <!-- Material Symbols -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-fondo font-cuerpo text-texto antialiased overflow-x-hidden">
    <Navbar />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
