---
import '../styles/global.css';

interface Props {
  title: string;
  activo?: string;
}

const { title, activo } = Astro.props;
const usuario = Astro.locals.usuario!;

const iniciales = usuario.nombre
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((p) => p[0]!.toUpperCase())
  .join('');

const navStaff = [
  { href: '/panel', label: 'Hoy', key: 'hoy' },
  { href: '/panel/buscar', label: 'Buscar', key: 'buscar' },
  { href: '/panel/pendientes-pago', label: 'Pendientes de pago', key: 'pendientes' },
];

const navAdmin = [
  { href: '/panel/admin', label: 'Vista operativa', key: 'operativa' },
  { href: '/panel/admin/calendario', label: 'Calendario', key: 'calendario' },
  { href: '/panel/admin/configuracion', label: 'Configuración', key: 'configuracion' },
  { href: '/panel/admin/reportes', label: 'Reportes', key: 'reportes' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Panel Tierra Roja</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-fondo font-cuerpo text-texto antialiased min-h-screen flex flex-col">
    <!-- Topbar: logo, búsqueda global (solo desktop) y accesos rápidos. -->
    <header class="h-16 shrink-0 bg-superficie border-b border-borde flex items-center justify-between gap-3 px-4 lg:px-8">
      <a href="/panel" class="shrink-0 flex items-center">
        <img src="/images/marca/Logo-Tierra-Roja.webp" alt="Logo de camping Tierra Roja" class="h-8 lg:h-9 w-auto" />
      </a>

      <form
        method="GET"
        action="/panel/buscar"
        class="hidden lg:flex flex-1 max-w-md items-center gap-2 bg-fondo-alt rounded-pill px-4 py-2 text-texto-suave focus-within:ring-2 focus-within:ring-primario/25 transition-shadow"
      >
        <span class="material-symbols-outlined text-[18px]">search</span>
        <input
          type="text"
          name="q"
          placeholder="Buscar reserva, huésped…"
          class="flex-1 bg-transparent text-sm text-texto placeholder:text-texto-suave outline-none"
        />
      </form>

      <div class="flex items-center gap-2 lg:gap-3 shrink-0">
        <a
          href="/panel/buscar"
          aria-label="Buscar"
          class="lg:hidden flex items-center justify-center w-9 h-9 rounded-full bg-fondo-alt text-texto-suave hover:text-primario transition-colors"
        >
          <span class="material-symbols-outlined text-[19px]">search</span>
        </a>

        <a
          href="/panel/reservas/nueva"
          class="hidden lg:inline-flex items-center gap-1.5 bg-primario text-white rounded-pill pl-3.5 pr-4 py-2 font-titulo font-semibold text-sm hover:bg-primario-claro transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">add</span>
          Nueva reserva
        </a>
        <a
          href="/panel/reservas/nueva"
          aria-label="Nueva reserva"
          class="lg:hidden flex items-center justify-center w-9 h-9 rounded-full bg-primario text-white"
        >
          <span class="material-symbols-outlined text-[19px]">add</span>
        </a>

        <div class="flex items-center gap-1.5 pl-1 lg:pl-2 lg:ml-1 lg:border-l lg:border-borde">
          <span
            title={usuario.nombre}
            class="w-8 h-8 shrink-0 rounded-full bg-fondo-alt text-primario flex items-center justify-center font-titulo font-bold text-xs"
          >
            {iniciales}
          </span>
          <form method="POST" action="/panel/logout">
            <button
              type="submit"
              aria-label="Cerrar sesión"
              class="flex items-center justify-center w-8 h-8 rounded-full text-texto-suave hover:bg-primario/10 hover:text-primario transition-colors"
            >
              <span class="material-symbols-outlined text-[18px]">logout</span>
            </button>
          </form>
        </div>
      </div>
    </header>

    <!-- Pestañas: una sola fila para todos los tamaños, scrollea horizontal en mobile. -->
    <nav class="shrink-0 bg-superficie border-b border-borde overflow-x-auto">
      <div class="flex items-center gap-1 px-4 lg:px-8 py-2.5 min-w-max">
        {
          navStaff.map((item) => (
            <a
              href={item.href}
              class:list={[
                'font-titulo font-medium text-sm px-3.5 py-1.5 rounded-pill whitespace-nowrap transition-colors',
                activo === item.key
                  ? 'bg-superficie-elevada text-primario font-semibold'
                  : 'text-texto-suave hover:bg-superficie-elevada hover:text-primario',
              ]}
            >
              {item.label}
            </a>
          ))
        }

        {
          usuario.rol === 'admin' && (
            <>
              <span class="w-px h-4 bg-borde mx-1.5 shrink-0" />
              {navAdmin.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'font-titulo font-medium text-sm px-3.5 py-1.5 rounded-pill whitespace-nowrap transition-colors',
                    activo === item.key
                      ? 'bg-superficie-elevada text-primario font-semibold'
                      : 'text-texto-suave hover:bg-superficie-elevada hover:text-primario',
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </>
          )
        }
      </div>
    </nav>

    <main class="flex-1 w-full max-w-6xl mx-auto p-4 lg:p-10">
      <slot />
    </main>
  </body>
</html>
