---
import '../styles/global.css';

interface Props {
  title: string;
  activo?: string;
}

const { title, activo } = Astro.props;
const usuario = Astro.locals.usuario!;

const navStaff = [
  { href: '/panel', label: 'Hoy', key: 'hoy' },
  { href: '/panel/buscar', label: 'Buscar', key: 'buscar' },
  { href: '/panel/reservas/nueva', label: 'Nueva reserva', key: 'nueva' },
  { href: '/panel/pendientes-pago', label: 'Pendientes de pago', key: 'pendientes' },
];

const navAdmin = [
  { href: '/panel/admin', label: 'Vista operativa', key: 'operativa' },
  { href: '/panel/admin/configuracion', label: 'Configuración', key: 'configuracion' },
  { href: '/panel/admin/reportes', label: 'Reportes', key: 'reportes' },
];

const nav = usuario.rol === 'admin' ? [...navStaff, ...navAdmin] : navStaff;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Panel Tierra Roja</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-gray-50 font-cuerpo text-texto antialiased min-h-screen lg:flex">
    <aside class="lg:w-64 lg:shrink-0 bg-superficie border-b lg:border-b-0 lg:border-r border-borde lg:min-h-screen">
      <div class="p-6 flex lg:flex-col justify-between lg:justify-start items-center lg:items-stretch gap-4">
        <a href="/panel">
          <img src="/images/Logo-Tierra-Roja.png" alt="Logo de camping Tierra Roja" class="h-10 w-auto lg:h-12" />
        </a>

        <!-- Cerrar sesión: en mobile la versión de escritorio queda oculta, así que
             acá va una versión compacta para que siga siendo posible salir del panel. -->
        <form method="POST" action="/panel/logout" class="lg:hidden">
          <button
            type="submit"
            aria-label="Cerrar sesión"
            class="flex items-center justify-center w-10 h-10 rounded-full text-texto-suave hover:bg-primario/10 hover:text-primario transition-colors"
          >
            <span class="material-symbols-outlined text-[20px]">logout</span>
          </button>
        </form>

        <nav class="hidden lg:flex flex-col gap-1 mt-6">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'font-titulo font-medium text-sm px-3 py-2 rounded-card transition-colors',
                  activo === item.key
                    ? 'bg-superficie-elevada text-primario'
                    : 'text-texto-suave hover:bg-superficie-elevada hover:text-primario',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="hidden lg:flex flex-col gap-2 mt-8 pt-4 border-t border-borde">
          <span class="text-sm text-texto-suave">
            {usuario.nombre} · <span class="font-medium">{usuario.rol === 'admin' ? 'Admin' : 'Staff'}</span>
          </span>
          <form method="POST" action="/panel/logout">
            <button
              type="submit"
              class="group flex items-center gap-2 text-sm text-texto-suave font-medium rounded-card px-3 py-2 w-full transition-colors hover:bg-primario/10 hover:text-primario"
            >
              <span class="material-symbols-outlined text-[18px] transition-transform group-hover:-translate-x-0.5">
                logout
              </span>
              Cerrar sesión
            </button>
          </form>
        </div>
      </div>

      <!-- Nav mobile: barra horizontal scrolleable, sin JS -->
      <nav class="lg:hidden flex gap-1 overflow-x-auto px-4 pb-4">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'font-titulo font-medium text-sm px-3 py-2 rounded-card whitespace-nowrap transition-colors',
                activo === item.key
                  ? 'bg-superficie-elevada text-primario'
                  : 'text-texto-suave hover:bg-superficie-elevada',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </aside>

    <main class="flex-1 p-6 lg:p-10 max-w-5xl">
      <slot />
    </main>
  </body>
</html>
